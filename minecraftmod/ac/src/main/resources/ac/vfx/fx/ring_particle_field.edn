{:doc ["New-DSL conversion of ac/vfx/effects/ring_particle_field.edn (S6)."
        "Old :radius {:from :to} maps were resolved by final_engine.clj's"
        "graph-value (:lerp? true kernel option) as lerp(from, to, :progress) --"
        "the new engine has no implicit map-shaped lerp sugar, so it is ported"
        "as an explicit (math/lerp from to ?progress) call."]
 :schema-version 1
 :kind :vfx/system
 :asset/type :vfx/system
 :asset/version 1
 :id :ring-particle-field
 :revision 1
 :lifecycle :session
 :inputs {:spawn {:position :vec3 :ring-from :float :ring-to :float
                  :segments :int :ring-color :any :rate-per-tick :int
                  :limit :int :particle :any}
          :update {:position :vec3}}
 :state-slots {:age :float :seed :int}
 :scene
 "{:ability :ring-particle-field
   :do [(ring {:center ?position :radius (math/lerp ?ring-from ?ring-to ?progress)
              :segments ?segments :color ?ring-color})
        (emitter {:anchor ?position :rate-per-tick ?rate-per-tick :limit ?limit
                  :particle ?particle})
        (finish {:outcome :performed})]}"}

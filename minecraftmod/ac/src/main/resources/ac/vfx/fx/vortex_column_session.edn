;; blood_retrograde_charge.edn's docstring); empty :scene is the honest
;; port. storm_wing.edn's (ability S6) :vortex-column-session vfx! calls
;; already dispatch against this effect id today with zero visible
;; regression risk, since it never rendered anything real either way.
{:schema-version 2
 :kind :vfx/system
 :asset/type :vfx/system
 :asset/version 1
 :id :vortex-column-session
 :revision 1
 :lifecycle :session
 :inputs
 {:spawn {:base :vec3 :axis :vec3 :height :float :spacing :any
          :radius :any :count-limit :int :life-ticks :int
          :seed :int :alpha {:type :float :default 1.0}
          :orientation {:type :any :default nil}}
  :update {:base :vec3 :alpha {:type :float :default 1.0}
           :orientation {:type :any :default nil}}
  :destroy {:fade-ticks :int}}
 :state-slots {:age :float :seed :int}
 :scene
 "{:ability :vortex-column-session
   :do [(finish {:outcome :performed})]}"}

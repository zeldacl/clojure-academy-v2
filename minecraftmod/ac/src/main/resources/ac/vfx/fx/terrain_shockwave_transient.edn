        "have no sample-node case (confirmed-dead class, see"
        "blood_retrograde_charge.edn's docstring) and are dropped along with"
        "every field only they read (:direction, :surface-hits, and all their"
        "own visual-tuning constants) -- only the sibling :vfx/audio-one-shot"
        "is real. Old top-level :bounds dropped, see"
        "blood_retrograde_charge.edn's docstring."]
 :schema-version 2
 :kind :vfx/system
 :asset/type :vfx/system
 :asset/version 1
 :id :terrain-shockwave-transient
 :revision 1
 :lifecycle :transient
 :inputs
 {:spawn {:origin :vec3 :direction :vec3 :surface-hits :any :seed :int
          :sound-id :string :sound-volume :float :sound-pitch :float}
  :destroy {}}
 :state-slots {:age :float :seed :int}
 :scene
 "{:ability :terrain-shockwave-transient
   :do [(audio-one-shot {:sound-id ?sound-id :volume ?sound-volume :pitch ?sound-pitch
                         :position ?origin})
        (finish {:outcome :performed})]}"}

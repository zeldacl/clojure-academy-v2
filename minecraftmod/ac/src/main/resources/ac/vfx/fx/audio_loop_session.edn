{:doc ["New-DSL conversion of ac/vfx/effects/audio_loop_session.edn (S6). Same"
        "single-child-:at-0-timeline simplification as particle_burst.edn."
        ":instance-key/:stop-on-destroy? were fixed literals in the old node"
        "(not :input refs), ported as literals directly."]
 :schema-version 1
 :kind :vfx/system
 :asset/type :vfx/system
 :asset/version 1
 :id :audio-loop-session
 :revision 1
 :lifecycle :session
 :inputs {:spawn {:position :vec3 :sound-id :string
                  :volume :float :pitch :float}
          :update {:position :vec3}
          :destroy {:fade-ticks :int}}
 :state-slots {:age :float}
 :scene
 "{:ability :audio-loop-session
   :do [(audio-loop {:position ?position :sound-id ?sound-id :volume ?volume
                     :pitch ?pitch :instance-key [:effect-instance :audio-loop]
                     :stop-on-destroy? true})
        (finish {:outcome :performed})]}"}

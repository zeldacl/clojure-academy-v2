;; New-DSL conversion of ac/vfx/effects/beam_session.edn (S6). Old
;; :life-ticks was declared on the :vfx/ray-beam node but never read by
;; final_engine.clj's sample-node case (grep-confirmed -- only :start
;; :end :style :grow-ticks are read); dropped, matching the ability-
;; conversion "drop dead reads" precedent. Old top-level :bounds dropped,
;; see blood_retrograde_charge.edn's docstring.
{:schema-version 2
 :kind :vfx/system
 :asset/type :vfx/system
 :asset/version 1
 :id :beam-session
 :revision 1
 :lifecycle :session
 :inputs
 {:spawn {:start :vec3 :end :vec3 :life-ticks :int :grow-ticks :int
          :style :any :bounds-radius :float}
  :update {:start {:type :vec3} :end {:type :vec3}
           :life-ticks {:type :int} :grow-ticks {:type :int}
           :style {:type :any} :bounds-radius {:type :float}}
  :destroy {:fade-ticks :int}}
 :state-slots {:age :float :seed :int}
 :scene
 "{:ability :beam-session
   :do [(ray-beam {:start ?start :end ?end :grow-ticks ?grow-ticks :style ?style})
        (finish {:outcome :performed})]}"}

{:doc ["New-DSL conversion of ac/vfx/effects/beam_fade_audio.edn (S6). Old"
        ":vfx/timeline's dynamic :at (:beam-at/:fade-at, not a fixed 0) becomes"
        "an explicit (when (math/gte ?age at) ...) guard -- unlike the fixed-0"
        "children ported elsewhere this pass, these ARE real runtime-"
        "conditional gates, not provably-always-true ones."
        ""
        "Old :vfx/fade wraps a CHILD subtree and multiplies its constructed"
        "ops' [:material :alpha] by a computed fade factor"
        "(from-alpha + clamp((age-from-tick)/(to-tick-from-tick),0,1) *"
        "(to-alpha-from-alpha)) -- there is no generic \"wrap and post-process a"
        "child's ops\" concept in the new flat :do sequence, so the fade factor"
        "is computed as a local and threaded directly into the wrapped leaf's"
        "new :alpha field (see dsl_vocabulary.clj's :beam docstring for why"
        "that field exists)."]
 :schema-version 1
 :kind :vfx/system
 :asset/type :vfx/system
 :asset/version 1
 :id :beam-fade-audio
 :revision 1
 :lifecycle :transient
 :inputs
 {:spawn {:start :vec3 :end :vec3 :duration-ticks :int :beam-at :int
          :grow-ticks :int :layers :any :sound-id :string
          :sound-volume :float :sound-pitch :float :sound-position :vec3
          :fade-at :int :fade-from-tick :int :fade-to-tick :int
          :fade-from-alpha :float :fade-to-alpha :float :fade-layers :any}}
 :state-slots {:age :float :seed :int}
 :scene
 "{:ability :beam-fade-audio
   :do [(when (math/gte ?age ?beam-at)
          (beam {:start ?start :end ?end :grow-ticks ?grow-ticks :layers ?layers}))
        (audio-one-shot {:sound-id ?sound-id :volume ?sound-volume :pitch ?sound-pitch
                         :position ?sound-position})
        (when (math/gte ?age ?fade-at)
          (let fade-p (math/clamp
                       (math/div (math/sub ?age ?fade-from-tick)
                                (math/max 1.0 (math/sub ?fade-to-tick ?fade-from-tick)))
                       0.0 1.0))
          (let fade-alpha (math/lerp ?fade-from-alpha ?fade-to-alpha fade-p))
          (beam {:start ?start :end ?end :layers ?fade-layers :alpha fade-alpha}))
        (finish {:outcome :performed})]}"}

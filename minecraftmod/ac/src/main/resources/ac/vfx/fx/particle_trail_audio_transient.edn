;; New-DSL conversion of ac/vfx/effects/particle_trail_audio_transient.edn
;; (S6). Mixed file: :vfx/particle-trail has no sample-node case
;; (confirmed-dead class, see blood_retrograde_charge.edn's docstring)
;; and is dropped along with every field only it read -- only the
;; sibling :vfx/audio-one-shot is real. Old top-level :bounds dropped,
;; see blood_retrograde_charge.edn's docstring.
{:schema-version 2
 :kind :vfx/system
 :asset/type :vfx/system
 :asset/version 1
 :id :particle-trail-audio-transient
 :revision 1
 :lifecycle :transient
 :inputs
 {:spawn {:start :vec3 :end :vec3
          :spacing :any :radius :any :count-limit :int
          :life-ticks :int :texture :string :velocity :any
          :size :any :alpha :any :fade-in :int :fade-out :int
          :sound-id :string :sound-position :vec3
          :sound-volume :float :sound-pitch :float}}
 :state-slots {:age :float :seed :int}
 :scene
 "{:ability :particle-trail-audio-transient
   :do [(audio-one-shot {:sound-id ?sound-id :position ?sound-position
                         :volume ?sound-volume :pitch ?sound-pitch})
        (finish {:outcome :performed})]}"}

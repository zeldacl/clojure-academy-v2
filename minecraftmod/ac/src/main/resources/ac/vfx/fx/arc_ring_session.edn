{:doc ["New-DSL conversion of ac/vfx/effects/arc_ring_session.edn (S6)."
        ":vfx/arc-field has no sample-node case (confirmed-dead class, see"
        "blood_retrograde_charge.edn's docstring) -- dropped, only its sibling"
        ":vfx/ring/:vfx/audio-one-shot/:vfx/fade children are real. Same fade-"
        "into-:alpha and radius-lerp translations as ring_fade_audio.edn. Old"
        "top-level :bounds dropped, see blood_retrograde_charge.edn's"
        "docstring."]
 :schema-version 1
 :kind :vfx/system
 :asset/type :vfx/system
 :asset/version 1
 :id :arc-ring-session
 :revision 1
 :lifecycle :session
 :inputs
 {:spawn {:start :vec3 :end :vec3 :duration-ticks :int
          :arc-spacing :any :arc-radius :any :arc-count-limit :int
          :arc-life-ticks :int :ring-from :float :ring-to :float
          :ring-segments :int :ring-color :any :sound-id :string
          :sound-volume :float :sound-pitch :float :sound-position :vec3
          :fade-at :int :fade-to-tick :int :fade-ring-from :float
          :fade-ring-to :float :fade-segments :int :fade-color :any}
  :update {:end :vec3}}
 :state-slots {:age :float :seed :int}
 :scene
 "{:ability :arc-ring-session
   :do [(ring {:center ?end :radius (math/lerp ?ring-from ?ring-to ?progress)
              :segments ?ring-segments :color ?ring-color})
        (audio-one-shot {:sound-id ?sound-id :volume ?sound-volume :pitch ?sound-pitch
                         :position ?sound-position})
        (when (math/gte ?age ?fade-at)
          (let fade-p (math/clamp
                       (math/div (math/sub ?age ?fade-at)
                                (math/max 1.0 (math/sub ?fade-to-tick ?fade-at)))
                       0.0 1.0))
          (let fade-alpha (math/lerp 1.0 0.0 fade-p))
          (ring {:center ?end
                :radius (math/lerp ?fade-ring-from ?fade-ring-to ?progress)
                :segments ?fade-segments :color ?fade-color :alpha fade-alpha}))
        (finish {:outcome :performed})]}"}

;; New-DSL conversion of ac/vfx/effects/teleport_trail_transient.edn
;; (S6). Mixed file: :vfx/particle-trail has no sample-node case
;; (confirmed-dead class, see blood_retrograde_charge.edn's docstring)
;; and is dropped along with every field only it read -- only the
;; sibling :vfx/audio-one-shot is real. Old top-level :bounds dropped,
;; see blood_retrograde_charge.edn's docstring.
{:schema-version 2
 :kind :vfx/system
 :asset/type :vfx/system
 :asset/version 1
 :id :teleport-trail-transient
 :revision 1
 :lifecycle :transient
 :inputs
 {:spawn {:start :vec3 :end :vec3
          :sound-id :string :sound-volume :float :sound-pitch :float}
  :destroy {}}
 :state-slots {:age :float :seed :int}
 :scene
 "{:ability :teleport-trail-transient
   :do [(audio-one-shot {:sound-id ?sound-id :position ?end :volume ?sound-volume
                         :pitch ?sound-pitch})
        (finish {:outcome :performed})]}"}

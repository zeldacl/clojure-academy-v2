{:kind :composite
 :id :vfx.fx/block-progress
 :revision 1
 :layer :mid
 :doc "A shrinking, pulsing box outline around a block-sized target position -- the generic progress indicator used by block_progress_session.edn and (with :corner-length > 0) target_box_session.edn. Faithful port of the old :vfx/block-progress Clojure component's box-corner/edge/pulse math into real :vfx/line geometry, composed in pure EDN. :height defaults to :width when omitted (matches the original component's (or height width)). :vfx/group (not :vfx/timeline) fans out to all 12/24 fixed edges every tick -- see cn.li.vfx.final-engine's explicit :vfx/group sampler for why :vfx/timeline's {:at :node}-wrapped :children shape does not fit node-core's :seq expansion kind. :tx/:ty/:tz extract :target's x/y/z via {:expr :vec3/x|y|z ...}, NOT {:ref [:input :target :vec3 0]} -- composite expansion substitutes a composite's own declared :inputs at EXPAND TIME (compile time), before the caller's own {:ref [:input :position]}-style argument has a real value; a nested-path :ref tries to (get-in ...) into that argument's LITERAL shape immediately and silently returns nil when the argument is itself still an unresolved reference (which is what every real ability actually passes -- target_box_session.edn's call site is :target {:ref [:input :position]}, never a literal). Wrapping the extraction in {:expr ...} defers it to SAMPLE time instead, by which point resolve-value has already resolved the argument against the real runtime :input. A first version of this file used the nested-path shortcut and passed every test here only because the tests happened to call the composite directly with a literal {:vec3 [...]} -- never through a caller-scope reference the way real content does; see this file's own composite-loader test coverage for the regression that catches it now."
 :category :indicator
 :inputs {:target {:type :vec3}
          :progress {:type :double :default 0.0}
          :color {:type :color}
          :pulse-period {:type :double :default 0.0}
          :width {:type :double :default 1.0}
          :height {:type :double :default -1.0}
          :corner-length {:type :double :default 0.0}}
 :outputs {}
 :body
 {:component :vfx/let
  :bindings
  {:tx {:expr :vec3/x :args [{:ref [:input :target]}]}
   :ty {:expr :vec3/y :args [{:ref [:input :target]}]}
   :tz {:expr :vec3/z :args [{:ref [:input :target]}]}
   :progress-c {:expr :math/clamp :args [{:ref [:input :progress]} 0.0 1.0]}
   :age {:ref [:state :age]}
   :corner-decorated? {:expr :math/gt :args [{:ref [:input :corner-length]} 0.0]}
   :pulse-active? {:expr :math/gt :args [{:ref [:input :pulse-period]} 0.0]}
   :height-unset? {:expr :math/lt :args [{:ref [:input :height]} 0.0]}}
  :child
  {:component :vfx/let
   :bindings
   {:h {:expr :math/select
        :args [{:ref [:input :height-unset?]} {:ref [:input :width]} {:ref [:input :height]}]}
    :shrink {:expr :math/mul :args [0.05 {:expr :math/sub :args [1.0 {:ref [:input :progress-c]}]}]}
    :pulse {:expr :math/select
            :args [{:ref [:input :pulse-active?]}
                   {:expr :math/add
                    :args [0.5
                           {:expr :math/mul
                            :args [0.5 {:expr :math/sin
                                        :args [{:expr :math/mul
                                                :args [{:ref [:input :pulse-period]} {:ref [:input :age]}]}]}]}]}
                   1.0]}}
   :child
   {:component :vfx/let
    :bindings
    {:min-x {:expr :math/add :args [{:ref [:input :tx]} {:ref [:input :shrink]}]}
     :min-y {:expr :math/add :args [{:ref [:input :ty]} {:ref [:input :shrink]}]}
     :min-z {:expr :math/add :args [{:ref [:input :tz]} {:ref [:input :shrink]}]}
     :max-x {:expr :math/sub :args [{:expr :math/add :args [{:ref [:input :tx]} {:ref [:input :width]}]} {:ref [:input :shrink]}]}
     :max-y {:expr :math/sub :args [{:expr :math/add :args [{:ref [:input :ty]} {:ref [:input :h]}]} {:ref [:input :shrink]}]}
     :max-z {:expr :math/sub :args [{:expr :math/add :args [{:ref [:input :tz]} {:ref [:input :width]}]} {:ref [:input :shrink]}]}
     :alpha {:expr :math/mul :args [{:ref [:input :color 3]} {:ref [:input :pulse]}]}}
    :child
    {:component :vfx/let
     :bindings {:rgba [{:ref [:input :color 0]} {:ref [:input :color 1]} {:ref [:input :color 2]} {:ref [:input :alpha]}]}
     :child
     {:component :vfx/branch
      :when {:ref [:input :corner-decorated?]}

      :then
      {:component :vfx/group
       :nodes
       [
        ;; corner 0
        {:component :vfx/line :from {:x {:ref [:input :min-x]} :y {:ref [:input :min-y]} :z {:ref [:input :min-z]}} :to {:x {:ref [:input :min-x]} :y {:expr :math/add :args [{:ref [:input :min-y]} {:ref [:input :corner-length]}]} :z {:ref [:input :min-z]}} :color {:ref [:input :rgba]}}
        {:component :vfx/line :from {:x {:ref [:input :min-x]} :y {:ref [:input :min-y]} :z {:ref [:input :min-z]}} :to {:x {:expr :math/add :args [{:ref [:input :min-x]} {:ref [:input :corner-length]}]} :y {:ref [:input :min-y]} :z {:ref [:input :min-z]}} :color {:ref [:input :rgba]}}
        {:component :vfx/line :from {:x {:ref [:input :min-x]} :y {:ref [:input :min-y]} :z {:ref [:input :min-z]}} :to {:x {:ref [:input :min-x]} :y {:ref [:input :min-y]} :z {:expr :math/add :args [{:ref [:input :min-z]} {:ref [:input :corner-length]}]}} :color {:ref [:input :rgba]}}
        ;; corner 1
        {:component :vfx/line :from {:x {:ref [:input :max-x]} :y {:ref [:input :min-y]} :z {:ref [:input :min-z]}} :to {:x {:ref [:input :max-x]} :y {:expr :math/add :args [{:ref [:input :min-y]} {:ref [:input :corner-length]}]} :z {:ref [:input :min-z]}} :color {:ref [:input :rgba]}}
        {:component :vfx/line :from {:x {:ref [:input :max-x]} :y {:ref [:input :min-y]} :z {:ref [:input :min-z]}} :to {:x {:expr :math/sub :args [{:ref [:input :max-x]} {:ref [:input :corner-length]}]} :y {:ref [:input :min-y]} :z {:ref [:input :min-z]}} :color {:ref [:input :rgba]}}
        {:component :vfx/line :from {:x {:ref [:input :max-x]} :y {:ref [:input :min-y]} :z {:ref [:input :min-z]}} :to {:x {:ref [:input :max-x]} :y {:ref [:input :min-y]} :z {:expr :math/add :args [{:ref [:input :min-z]} {:ref [:input :corner-length]}]}} :color {:ref [:input :rgba]}}
        ;; corner 2
        {:component :vfx/line :from {:x {:ref [:input :max-x]} :y {:ref [:input :max-y]} :z {:ref [:input :min-z]}} :to {:x {:ref [:input :max-x]} :y {:expr :math/add :args [{:ref [:input :max-y]} {:ref [:input :corner-length]}]} :z {:ref [:input :min-z]}} :color {:ref [:input :rgba]}}
        {:component :vfx/line :from {:x {:ref [:input :max-x]} :y {:ref [:input :max-y]} :z {:ref [:input :min-z]}} :to {:x {:expr :math/sub :args [{:ref [:input :max-x]} {:ref [:input :corner-length]}]} :y {:ref [:input :max-y]} :z {:ref [:input :min-z]}} :color {:ref [:input :rgba]}}
        {:component :vfx/line :from {:x {:ref [:input :max-x]} :y {:ref [:input :max-y]} :z {:ref [:input :min-z]}} :to {:x {:ref [:input :max-x]} :y {:ref [:input :max-y]} :z {:expr :math/sub :args [{:ref [:input :min-z]} {:ref [:input :corner-length]}]}} :color {:ref [:input :rgba]}}
        ;; corner 3
        {:component :vfx/line :from {:x {:ref [:input :min-x]} :y {:ref [:input :max-y]} :z {:ref [:input :min-z]}} :to {:x {:ref [:input :min-x]} :y {:expr :math/add :args [{:ref [:input :max-y]} {:ref [:input :corner-length]}]} :z {:ref [:input :min-z]}} :color {:ref [:input :rgba]}}
        {:component :vfx/line :from {:x {:ref [:input :min-x]} :y {:ref [:input :max-y]} :z {:ref [:input :min-z]}} :to {:x {:expr :math/add :args [{:ref [:input :min-x]} {:ref [:input :corner-length]}]} :y {:ref [:input :max-y]} :z {:ref [:input :min-z]}} :color {:ref [:input :rgba]}}
        {:component :vfx/line :from {:x {:ref [:input :min-x]} :y {:ref [:input :max-y]} :z {:ref [:input :min-z]}} :to {:x {:ref [:input :min-x]} :y {:ref [:input :max-y]} :z {:expr :math/sub :args [{:ref [:input :min-z]} {:ref [:input :corner-length]}]}} :color {:ref [:input :rgba]}}
        ;; corner 4
        {:component :vfx/line :from {:x {:ref [:input :min-x]} :y {:ref [:input :min-y]} :z {:ref [:input :max-z]}} :to {:x {:ref [:input :min-x]} :y {:expr :math/sub :args [{:ref [:input :min-y]} {:ref [:input :corner-length]}]} :z {:ref [:input :max-z]}} :color {:ref [:input :rgba]}}
        {:component :vfx/line :from {:x {:ref [:input :min-x]} :y {:ref [:input :min-y]} :z {:ref [:input :max-z]}} :to {:x {:expr :math/add :args [{:ref [:input :min-x]} {:ref [:input :corner-length]}]} :y {:ref [:input :min-y]} :z {:ref [:input :max-z]}} :color {:ref [:input :rgba]}}
        {:component :vfx/line :from {:x {:ref [:input :min-x]} :y {:ref [:input :min-y]} :z {:ref [:input :max-z]}} :to {:x {:ref [:input :min-x]} :y {:ref [:input :min-y]} :z {:expr :math/add :args [{:ref [:input :max-z]} {:ref [:input :corner-length]}]}} :color {:ref [:input :rgba]}}
        ;; corner 5
        {:component :vfx/line :from {:x {:ref [:input :max-x]} :y {:ref [:input :min-y]} :z {:ref [:input :max-z]}} :to {:x {:ref [:input :max-x]} :y {:expr :math/sub :args [{:ref [:input :min-y]} {:ref [:input :corner-length]}]} :z {:ref [:input :max-z]}} :color {:ref [:input :rgba]}}
        {:component :vfx/line :from {:x {:ref [:input :max-x]} :y {:ref [:input :min-y]} :z {:ref [:input :max-z]}} :to {:x {:expr :math/sub :args [{:ref [:input :max-x]} {:ref [:input :corner-length]}]} :y {:ref [:input :min-y]} :z {:ref [:input :max-z]}} :color {:ref [:input :rgba]}}
        {:component :vfx/line :from {:x {:ref [:input :max-x]} :y {:ref [:input :min-y]} :z {:ref [:input :max-z]}} :to {:x {:ref [:input :max-x]} :y {:ref [:input :min-y]} :z {:expr :math/add :args [{:ref [:input :max-z]} {:ref [:input :corner-length]}]}} :color {:ref [:input :rgba]}}
        ;; corner 6
        {:component :vfx/line :from {:x {:ref [:input :max-x]} :y {:ref [:input :max-y]} :z {:ref [:input :max-z]}} :to {:x {:ref [:input :max-x]} :y {:expr :math/sub :args [{:ref [:input :max-y]} {:ref [:input :corner-length]}]} :z {:ref [:input :max-z]}} :color {:ref [:input :rgba]}}
        {:component :vfx/line :from {:x {:ref [:input :max-x]} :y {:ref [:input :max-y]} :z {:ref [:input :max-z]}} :to {:x {:expr :math/sub :args [{:ref [:input :max-x]} {:ref [:input :corner-length]}]} :y {:ref [:input :max-y]} :z {:ref [:input :max-z]}} :color {:ref [:input :rgba]}}
        {:component :vfx/line :from {:x {:ref [:input :max-x]} :y {:ref [:input :max-y]} :z {:ref [:input :max-z]}} :to {:x {:ref [:input :max-x]} :y {:ref [:input :max-y]} :z {:expr :math/sub :args [{:ref [:input :max-z]} {:ref [:input :corner-length]}]}} :color {:ref [:input :rgba]}}
        ;; corner 7
        {:component :vfx/line :from {:x {:ref [:input :min-x]} :y {:ref [:input :max-y]} :z {:ref [:input :max-z]}} :to {:x {:ref [:input :min-x]} :y {:expr :math/sub :args [{:ref [:input :max-y]} {:ref [:input :corner-length]}]} :z {:ref [:input :max-z]}} :color {:ref [:input :rgba]}}
        {:component :vfx/line :from {:x {:ref [:input :min-x]} :y {:ref [:input :max-y]} :z {:ref [:input :max-z]}} :to {:x {:expr :math/add :args [{:ref [:input :min-x]} {:ref [:input :corner-length]}]} :y {:ref [:input :max-y]} :z {:ref [:input :max-z]}} :color {:ref [:input :rgba]}}
        {:component :vfx/line :from {:x {:ref [:input :min-x]} :y {:ref [:input :max-y]} :z {:ref [:input :max-z]}} :to {:x {:ref [:input :min-x]} :y {:ref [:input :max-y]} :z {:expr :math/sub :args [{:ref [:input :max-z]} {:ref [:input :corner-length]}]}} :color {:ref [:input :rgba]}}
       ]}

      :else
      {:component :vfx/group
       :nodes
       [
        {:component :vfx/line :from {:x {:ref [:input :min-x]} :y {:ref [:input :min-y]} :z {:ref [:input :min-z]}} :to {:x {:ref [:input :max-x]} :y {:ref [:input :min-y]} :z {:ref [:input :min-z]}} :color {:ref [:input :rgba]}}
        {:component :vfx/line :from {:x {:ref [:input :max-x]} :y {:ref [:input :min-y]} :z {:ref [:input :min-z]}} :to {:x {:ref [:input :max-x]} :y {:ref [:input :max-y]} :z {:ref [:input :min-z]}} :color {:ref [:input :rgba]}}
        {:component :vfx/line :from {:x {:ref [:input :max-x]} :y {:ref [:input :max-y]} :z {:ref [:input :min-z]}} :to {:x {:ref [:input :min-x]} :y {:ref [:input :max-y]} :z {:ref [:input :min-z]}} :color {:ref [:input :rgba]}}
        {:component :vfx/line :from {:x {:ref [:input :min-x]} :y {:ref [:input :max-y]} :z {:ref [:input :min-z]}} :to {:x {:ref [:input :min-x]} :y {:ref [:input :min-y]} :z {:ref [:input :min-z]}} :color {:ref [:input :rgba]}}
        {:component :vfx/line :from {:x {:ref [:input :min-x]} :y {:ref [:input :min-y]} :z {:ref [:input :max-z]}} :to {:x {:ref [:input :max-x]} :y {:ref [:input :min-y]} :z {:ref [:input :max-z]}} :color {:ref [:input :rgba]}}
        {:component :vfx/line :from {:x {:ref [:input :max-x]} :y {:ref [:input :min-y]} :z {:ref [:input :max-z]}} :to {:x {:ref [:input :max-x]} :y {:ref [:input :max-y]} :z {:ref [:input :max-z]}} :color {:ref [:input :rgba]}}
        {:component :vfx/line :from {:x {:ref [:input :max-x]} :y {:ref [:input :max-y]} :z {:ref [:input :max-z]}} :to {:x {:ref [:input :min-x]} :y {:ref [:input :max-y]} :z {:ref [:input :max-z]}} :color {:ref [:input :rgba]}}
        {:component :vfx/line :from {:x {:ref [:input :min-x]} :y {:ref [:input :max-y]} :z {:ref [:input :max-z]}} :to {:x {:ref [:input :min-x]} :y {:ref [:input :min-y]} :z {:ref [:input :max-z]}} :color {:ref [:input :rgba]}}
        {:component :vfx/line :from {:x {:ref [:input :min-x]} :y {:ref [:input :min-y]} :z {:ref [:input :min-z]}} :to {:x {:ref [:input :min-x]} :y {:ref [:input :min-y]} :z {:ref [:input :max-z]}} :color {:ref [:input :rgba]}}
        {:component :vfx/line :from {:x {:ref [:input :max-x]} :y {:ref [:input :min-y]} :z {:ref [:input :min-z]}} :to {:x {:ref [:input :max-x]} :y {:ref [:input :min-y]} :z {:ref [:input :max-z]}} :color {:ref [:input :rgba]}}
        {:component :vfx/line :from {:x {:ref [:input :max-x]} :y {:ref [:input :max-y]} :z {:ref [:input :min-z]}} :to {:x {:ref [:input :max-x]} :y {:ref [:input :max-y]} :z {:ref [:input :max-z]}} :color {:ref [:input :rgba]}}
        {:component :vfx/line :from {:x {:ref [:input :min-x]} :y {:ref [:input :max-y]} :z {:ref [:input :min-z]}} :to {:x {:ref [:input :min-x]} :y {:ref [:input :max-y]} :z {:ref [:input :max-z]}} :color {:ref [:input :rgba]}}
       ]}}}}}}}

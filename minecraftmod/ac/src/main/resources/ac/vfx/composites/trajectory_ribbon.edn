{:kind :composite
 :id :vfx.fx/trajectory-ribbon
 :revision 1
 :layer :composite
 :doc "A ballistic path preview: :segments points along a drag/gravity trajectory from :origin, connected as a chain of :vfx/line segments. Faithful closed-form port of the old :vfx/trajectory-ribbon Clojure component's per-tick integration loop -- see vfx-core's cn.li.vfx.trajectory-ribbon-math-test for the numeric proof the closed form matches the original loop exactly, including the drag == 1.0 edge case. Renders as connected lines rather than a width/height mesh strip: no real ribbon/quad-strip render primitive exists yet, the same simplification block-progress and charge-ring already made for their own shapes -- :width/:style's :height are accepted but not yet drawn as a strip."
 :category :indicator
 :inputs {:origin {:type :vec3}
          :initial-velocity {:type :vec3}
          :look-dir {:type :vec3}
          :lateral-offset {:type :float :default 0.0}
          :forward-offset {:type :float :default 0.0}
          :vertical-offset {:type :float :default 0.0}
          :drag {:type :float :default 1.0}
          :gravity {:type :float :default 0.0}
          :dt {:type :float :default 0.02}
          :segments {:type :int :default 2}
          :width {:type :float :default 0.02}
          :style {:type :map :default {}}
          :can-perform? {:type :bool :default false}}
 :outputs {}
 :body
 {:component :vfx/let
  :bindings
  {:lx {:expr :vec3/x :args [{:ref [:input :look-dir]}]}
   :ly {:expr :vec3/y :args [{:ref [:input :look-dir]}]}
   :lz {:expr :vec3/z :args [{:ref [:input :look-dir]}]}
   :ox {:expr :vec3/x :args [{:ref [:input :origin]}]}
   :oy {:expr :vec3/y :args [{:ref [:input :origin]}]}
   :oz {:expr :vec3/z :args [{:ref [:input :origin]}]}
   :vx0 {:expr :vec3/x :args [{:ref [:input :initial-velocity]}]}
   :vy0 {:expr :vec3/y :args [{:ref [:input :initial-velocity]}]}
   :vz0 {:expr :vec3/z :args [{:ref [:input :initial-velocity]}]}
   :segments-n {:expr :math/clamp :args [{:ref [:input :segments]} 2.0 256.0]}
   :ready-color {:expr :map/get :args [{:ref [:input :style]} :ready-color]}
   :blocked-color {:expr :map/get :args [{:ref [:input :style]} :blocked-color]}
   :style-color {:expr :map/get :args [{:ref [:input :style]} :color]}}
  :child
  {:component :vfx/let
   :bindings
   {:horizontal {:expr :math/sqrt :args [{:expr :math/add :args [{:expr :math/mul :args [{:ref [:input :lx]} {:ref [:input :lx]}]} {:expr :math/mul :args [{:ref [:input :lz]} {:ref [:input :lz]}]}]}]}
    :primary-color {:expr :math/select :args [{:ref [:input :can-perform?]} {:ref [:input :ready-color]} {:ref [:input :blocked-color]}]}}
   :child
   {:component :vfx/let
    :bindings
    {:safe-horizontal {:expr :math/select :args [{:expr :math/gt :args [{:ref [:input :horizontal]} 0.0]} {:ref [:input :horizontal]} 1.0]}
     :color {:expr :math/select :args [{:ref [:input :primary-color]} {:ref [:input :primary-color]} {:expr :math/select :args [{:ref [:input :style-color]} {:ref [:input :style-color]} [255.0 255.0 255.0 255.0]]}]}}
   :child
   {:component :vfx/let
    :bindings
    {:sx {:expr :math/sub :args [{:expr :math/mul :args [-1.0 {:expr :math/mul :args [{:ref [:input :lateral-offset]} {:expr :math/div :args [{:ref [:input :lz]} {:ref [:input :safe-horizontal]}]}]}]} {:expr :math/mul :args [{:ref [:input :forward-offset]} {:ref [:input :lx]}]}]}
     :sy {:expr :math/sub :args [{:ref [:input :vertical-offset]} {:expr :math/mul :args [{:ref [:input :forward-offset]} {:ref [:input :ly]}]}]}
     :sz {:expr :math/add :args [{:expr :math/mul :args [{:ref [:input :lateral-offset]} {:expr :math/div :args [{:ref [:input :lx]} {:ref [:input :safe-horizontal]}]}]} {:expr :math/mul :args [-1.0 {:expr :math/mul :args [{:ref [:input :forward-offset]} {:ref [:input :lz]}]}]}]}}
    :child
    {:component :vfx/let
     :bindings
     {:p0x {:expr :math/add :args [{:ref [:input :ox]} {:ref [:input :sx]}]}
      :p0y {:expr :math/add :args [{:ref [:input :oy]} {:ref [:input :sy]}]}
      :p0z {:expr :math/add :args [{:ref [:input :oz]} {:ref [:input :sz]}]}}
     :child
     {:component :vfx/repeat
      :count {:expr :math/sub :args [{:ref [:input :segments-n]} 1.0]}
      :index-as :i
      :body {:component :vfx/line :from {:x {:expr :math/add :args [{:ref [:input :p0x]} {:expr :math/mul :args [{:expr :math/mul :args [{:expr :math/mul :args [{:ref [:input :dt]} {:ref [:input :drag]}]} {:ref [:input :vx0]}]} {:expr :math/select :args [{:expr :math/eq :args [{:ref [:input :drag]} 1.0]} {:ref [:input :i]} {:expr :math/div :args [{:expr :math/sub :args [1.0 {:expr :math/pow :args [{:ref [:input :drag]} {:ref [:input :i]}]}]} {:expr :math/sub :args [1.0 {:ref [:input :drag]}]}]}]}]}]} :y {:expr :math/sub :args [{:expr :math/add :args [{:ref [:input :p0y]} {:expr :math/mul :args [{:expr :math/mul :args [{:expr :math/mul :args [{:ref [:input :dt]} {:ref [:input :drag]}]} {:ref [:input :vy0]}]} {:expr :math/select :args [{:expr :math/eq :args [{:ref [:input :drag]} 1.0]} {:ref [:input :i]} {:expr :math/div :args [{:expr :math/sub :args [1.0 {:expr :math/pow :args [{:ref [:input :drag]} {:ref [:input :i]}]}]} {:expr :math/sub :args [1.0 {:ref [:input :drag]}]}]}]}]}]} {:expr :math/mul :args [{:expr :math/mul :args [{:expr :math/mul :args [{:ref [:input :dt]} {:ref [:input :dt]}]} {:expr :math/mul :args [{:ref [:input :drag]} {:ref [:input :gravity]}]}]} {:expr :math/select :args [{:expr :math/eq :args [{:ref [:input :drag]} 1.0]} {:expr :math/div :args [{:expr :math/mul :args [{:ref [:input :i]} {:expr :math/sub :args [{:ref [:input :i]} 1.0]}]} 2.0]} {:expr :math/div :args [{:expr :math/sub :args [{:ref [:input :i]} {:expr :math/select :args [{:expr :math/eq :args [{:ref [:input :drag]} 1.0]} {:ref [:input :i]} {:expr :math/div :args [{:expr :math/sub :args [1.0 {:expr :math/pow :args [{:ref [:input :drag]} {:ref [:input :i]}]}]} {:expr :math/sub :args [1.0 {:ref [:input :drag]}]}]}]}]} {:expr :math/sub :args [1.0 {:ref [:input :drag]}]}]}]}]}]} :z {:expr :math/add :args [{:ref [:input :p0z]} {:expr :math/mul :args [{:expr :math/mul :args [{:expr :math/mul :args [{:ref [:input :dt]} {:ref [:input :drag]}]} {:ref [:input :vz0]}]} {:expr :math/select :args [{:expr :math/eq :args [{:ref [:input :drag]} 1.0]} {:ref [:input :i]} {:expr :math/div :args [{:expr :math/sub :args [1.0 {:expr :math/pow :args [{:ref [:input :drag]} {:ref [:input :i]}]}]} {:expr :math/sub :args [1.0 {:ref [:input :drag]}]}]}]}]}]}} :to {:x {:expr :math/add :args [{:ref [:input :p0x]} {:expr :math/mul :args [{:expr :math/mul :args [{:expr :math/mul :args [{:ref [:input :dt]} {:ref [:input :drag]}]} {:ref [:input :vx0]}]} {:expr :math/select :args [{:expr :math/eq :args [{:ref [:input :drag]} 1.0]} {:expr :math/add :args [{:ref [:input :i]} 1.0]} {:expr :math/div :args [{:expr :math/sub :args [1.0 {:expr :math/pow :args [{:ref [:input :drag]} {:expr :math/add :args [{:ref [:input :i]} 1.0]}]}]} {:expr :math/sub :args [1.0 {:ref [:input :drag]}]}]}]}]}]} :y {:expr :math/sub :args [{:expr :math/add :args [{:ref [:input :p0y]} {:expr :math/mul :args [{:expr :math/mul :args [{:expr :math/mul :args [{:ref [:input :dt]} {:ref [:input :drag]}]} {:ref [:input :vy0]}]} {:expr :math/select :args [{:expr :math/eq :args [{:ref [:input :drag]} 1.0]} {:expr :math/add :args [{:ref [:input :i]} 1.0]} {:expr :math/div :args [{:expr :math/sub :args [1.0 {:expr :math/pow :args [{:ref [:input :drag]} {:expr :math/add :args [{:ref [:input :i]} 1.0]}]}]} {:expr :math/sub :args [1.0 {:ref [:input :drag]}]}]}]}]}]} {:expr :math/mul :args [{:expr :math/mul :args [{:expr :math/mul :args [{:ref [:input :dt]} {:ref [:input :dt]}]} {:expr :math/mul :args [{:ref [:input :drag]} {:ref [:input :gravity]}]}]} {:expr :math/select :args [{:expr :math/eq :args [{:ref [:input :drag]} 1.0]} {:expr :math/div :args [{:expr :math/mul :args [{:expr :math/add :args [{:ref [:input :i]} 1.0]} {:expr :math/sub :args [{:expr :math/add :args [{:ref [:input :i]} 1.0]} 1.0]}]} 2.0]} {:expr :math/div :args [{:expr :math/sub :args [{:expr :math/add :args [{:ref [:input :i]} 1.0]} {:expr :math/select :args [{:expr :math/eq :args [{:ref [:input :drag]} 1.0]} {:expr :math/add :args [{:ref [:input :i]} 1.0]} {:expr :math/div :args [{:expr :math/sub :args [1.0 {:expr :math/pow :args [{:ref [:input :drag]} {:expr :math/add :args [{:ref [:input :i]} 1.0]}]}]} {:expr :math/sub :args [1.0 {:ref [:input :drag]}]}]}]}]} {:expr :math/sub :args [1.0 {:ref [:input :drag]}]}]}]}]}]} :z {:expr :math/add :args [{:ref [:input :p0z]} {:expr :math/mul :args [{:expr :math/mul :args [{:expr :math/mul :args [{:ref [:input :dt]} {:ref [:input :drag]}]} {:ref [:input :vz0]}]} {:expr :math/select :args [{:expr :math/eq :args [{:ref [:input :drag]} 1.0]} {:expr :math/add :args [{:ref [:input :i]} 1.0]} {:expr :math/div :args [{:expr :math/sub :args [1.0 {:expr :math/pow :args [{:ref [:input :drag]} {:expr :math/add :args [{:ref [:input :i]} 1.0]}]}]} {:expr :math/sub :args [1.0 {:ref [:input :drag]}]}]}]}]}]}} :color {:ref [:input :color]}}}}}}}}}



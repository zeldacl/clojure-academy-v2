{:schema-version 1
 :kind :vfx-effect
 :id :mark-teleport-perform
 :revision 1
 :lifecycle :transient
 :inputs {:spawn {:position :vec3 :distance :double}}
 :state-slots {:age :double :seed :long}
 :graph
 {:component :vfx/timeline
  :duration-ticks 20
  :children [{:at 0
              :node {:component :vfx/ring
                     :center {:ref [:input :position]}
                     :radius {:from 0.25 :to 1.4}
                     :segments 24
                     :color [188 252 238 220]}}
             {:at 0
              :node {:component :vfx/arc-field
                     :start {:ref [:input :position]}
                     :end {:ref [:input :position]}
                     :spacing {:min 0.6 :max 1.2}
                     :radius {:min 0.08 :max 0.18}
                     :count-limit 32
                     :life-ticks 12
                     :seed {:ref [:state :seed]}}}
             {:at 0
              :node {:component :vfx/audio-one-shot
                     :sound-id "academy:em.teleport"
                     :volume 0.6
                     :pitch 1.0
                     :position {:ref [:input :position]}}}
             {:at 8
              :node {:component :vfx/fade
                     :from-tick 8
                     :to-tick 20
                     :from-alpha 1.0
                     :to-alpha 0.0
                     :child {:component :vfx/ring
                             :center {:ref [:input :position]}
                             :radius {:from 1.4 :to 2.0}
                             :segments 24
                             :color [236 170 93 180]}}}]}
 :bounds {:component :vfx/beam-bounds
          :start {:ref [:input :position]}
          :end {:ref [:input :position]}
          :radius 2.0}}

{:schema-version 1
 :kind :vfx/system
 :asset/type :vfx/system
 :asset/version 1
 :id :particle-session
 :revision 1
 :lifecycle :session
 ;; Generic moving particle field.  Audio is deliberately a separate
 ;; transient effect so callers can compose either output independently.
 :inputs {:spawn {:position :vec3 :rate-per-tick :int :limit :int
                  :particle :any}
          :update {:position :vec3}}
 :state-slots {:age :float :seed :int}
 :control-graph {:component :vfx/timeline
         :duration-ticks 4096
         :children [{:at 0
                     :node {:component :vfx/emitter
                            :anchor {:ref [:input :position]}
                            :rate-per-tick {:ref [:input :rate-per-tick]}
                            :limit {:ref [:input :limit]}
                            :particle {:ref [:input :particle]}}}]}}


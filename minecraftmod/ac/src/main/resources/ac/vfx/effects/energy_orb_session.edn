{:schema-version 1
 :kind :vfx-effect
 :id :energy-orb-session
 :revision 1
 :lifecycle :session
 ;; Generic moving energy body.  The effect deliberately has no skill name:
 ;; a caller supplies geometry, material, palette, audio and lifetime.
 :inputs
 {:spawn {:position :vec3
          :radius :double
          :segments :long
          :outer-color :object
          :inner-color :object
          :core-color :object
          :rate-per-tick :long
          :limit :long
          :particle :object}
  :update {:position :vec3}
  :destroy {:fade-ticks :long}}
 :state-slots {:age :double :seed :long}
 :graph {:component :vfx/timeline
         :duration-ticks 4096
         :children [{:at 0
                     :node {:component :vfx/ring
                            :center {:ref [:input :position]}
                            :radius {:from {:expr :math/mul
                                            :args [{:ref [:input :radius]} 0.65]}
                                     :to {:ref [:input :radius]}}
                            :segments {:ref [:input :segments]}
                            :color {:ref [:input :outer-color]}}}
                    {:at 0
                     :node {:component :vfx/ring
                            :center {:ref [:input :position]}
                            :radius {:from {:expr :math/mul
                                            :args [{:ref [:input :radius]} 0.35]}
                                     :to {:expr :math/mul
                                          :args [{:ref [:input :radius]} 0.72]}}
                            :segments {:ref [:input :segments]}
                            :color {:ref [:input :inner-color]}}}
                    {:at 0
                     :node {:component :vfx/ring
                            :center {:ref [:input :position]}
                            :radius {:from 0.0
                                     :to {:expr :math/mul
                                          :args [{:ref [:input :radius]} 0.35]}}
                            :segments {:ref [:input :segments]}
                            :color {:ref [:input :core-color]}}}
                    {:at 0
                     :node {:component :vfx/emitter
                            :anchor {:ref [:input :position]}
                            :rate-per-tick {:ref [:input :rate-per-tick]}
                            :limit {:ref [:input :limit]}
                            :particle {:ref [:input :particle]}}}
                    {:at 0
                     :node {:component :vfx/fade
                            :from-tick 0 :to-tick 4096
                            :from-alpha 1.0 :to-alpha 0.0
                            :child {:component :vfx/ring
                                    :center {:ref [:input :position]}
                                    :radius {:from {:ref [:input :radius]}
                                             :to 0.0}
                                    :segments {:ref [:input :segments]}
                                    :color {:ref [:input :outer-color]}}}}]}
 :bounds {:component :vfx/beam-bounds
          :start {:ref [:input :position]}
          :end {:ref [:input :position]}
          :radius {:ref [:input :radius]}}}

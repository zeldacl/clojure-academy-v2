{:schema-version 1
 :kind :vfx-effect
 :id :flashing-perform
 :revision 1
 :lifecycle :transient
 :inputs {:spawn {:from :vec3 :to :vec3 :distance :double}}
 :state-slots {:age :double :seed :long}
 :graph
 {:component :vfx/timeline
  :duration-ticks 8
  :children [{:at 0
              :node {:component :vfx/emitter
                     :anchor {:ref [:input :from]}
                     :rate-per-tick 2
                     :limit 64
                     :particle {:material :additive
                                :life-ticks 8
                                :speed 0.04
                                :color [188 252 238 220]}}}
             {:at 0
              :node {:component :vfx/emitter
                     :anchor {:ref [:input :to]}
                     :rate-per-tick 2
                     :limit 64
                     :particle {:material :additive
                                :life-ticks 8
                                :speed 0.04
                                :color [188 252 238 220]}}}
             {:at 0
              :node {:component :vfx/audio-one-shot
                     :sound-id "academy:tp.tp_flashing"
                     :volume 1.0
                     :pitch 1.0
                     :position {:ref [:input :to]}}}]}
 :bounds {:component :vfx/beam-bounds
          :start {:ref [:input :from]}
          :end {:ref [:input :to]}
          :radius 1.2}}

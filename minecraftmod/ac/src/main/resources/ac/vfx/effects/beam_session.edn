{:schema-version 2
 :kind :vfx/system
 :asset/type :vfx/system
 :asset/version 1
 :id :beam-session
 :revision 1
 :lifecycle :session
 :inputs
 {:spawn {:start :vec3 :end :vec3 :life-ticks :int :grow-ticks :int
          :style :any :bounds-radius :float}
  :update {:start {:type :vec3} :end {:type :vec3}
           :life-ticks {:type :int} :grow-ticks {:type :int}
           :style {:type :any} :bounds-radius {:type :float}}
  :destroy {:fade-ticks :int}}
 :state-slots {:age :float :seed :int}
 :control-graph {:component :vfx/ray-beam
         :start {:ref [:input :start]}
         :end {:ref [:input :end]}
         :life-ticks {:ref [:input :life-ticks]}
         :grow-ticks {:ref [:input :grow-ticks]}
         :style {:ref [:input :style]}}
 :bounds {:component :vfx/beam-bounds
          :start {:ref [:input :start]}
          :end {:ref [:input :end]}
          :radius {:ref [:input :bounds-radius]}}}


{:schema-version 1
 :kind :vfx-effect
 :id :particle-audio-session
 :revision 1
 :lifecycle :session
 :inputs {:spawn {:position :vec3 :rate-per-tick :long :limit :long
                  :particle :object :sound-id :string :sound-volume :double
                  :sound-pitch :double}
           :update {:position :vec3}}
 :state-slots {:age :double :seed :long}
 :graph {:component :vfx/timeline
         :duration-ticks 4096
         :children [{:at 0
                     :node {:component :vfx/emitter
                            :anchor {:ref [:input :position]}
                            :rate-per-tick {:ref [:input :rate-per-tick]}
                            :limit {:ref [:input :limit]}
                            :particle {:ref [:input :particle]}}}
                    {:at 0
                     :node {:component :vfx/audio-one-shot
                            :sound-id {:ref [:input :sound-id]}
                            :volume {:ref [:input :sound-volume]}
                            :pitch {:ref [:input :sound-pitch]}
                            :position {:ref [:input :position]}}}]}}

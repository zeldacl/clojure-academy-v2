{:schema-version 1
 :kind :vfx-effect
 :id :billboard-session
 :revision 1
 :lifecycle :session
 :inputs {:spawn {:anchor :object :duration-ticks :long :texture-pattern :string
                  :frame-count :long :frame-duration-ms :long :half-size :double}}
 :state-slots {:age :double :seed :long}
 :graph {:component :vfx/timeline
         :duration-ticks {:ref [:input :duration-ticks]}
         :children [{:at 0
                     :node {:component :vfx/billboard-sequence
                            :anchor {:ref [:input :anchor]}
                            :texture-pattern {:ref [:input :texture-pattern]}
                            :frame-count {:ref [:input :frame-count]}
                            :frame-duration-ms {:ref [:input :frame-duration-ms]}
                            :half-size {:ref [:input :half-size]}}}]}}

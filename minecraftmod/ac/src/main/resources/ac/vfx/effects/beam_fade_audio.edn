{:schema-version 1
 :kind :vfx/system
 :asset/type :vfx/system
 :asset/version 1
 :id :beam-fade-audio
 :revision 1
 :lifecycle :transient
 :inputs
 {:spawn {:start :vec3 :end :vec3 :duration-ticks :int :beam-at :int
          :grow-ticks :int :layers :any :sound-id :string
          :sound-volume :float :sound-pitch :float :sound-position :vec3
          :fade-at :int :fade-from-tick :int :fade-to-tick :int
          :fade-from-alpha :float :fade-to-alpha :float :fade-layers :any}}
 :state-slots {:age :float :seed :int}
 :control-graph {:component :vfx/timeline
         :duration-ticks {:ref [:input :duration-ticks]}
         :children [{:at {:ref [:input :beam-at]}
                     :node {:component :vfx/beam
                            :start {:ref [:input :start]}
                            :end {:ref [:input :end]}
                            :grow-ticks {:ref [:input :grow-ticks]}
                            :layers {:ref [:input :layers]}}}
                    {:at 0
                     :node {:component :vfx/audio-one-shot
                            :sound-id {:ref [:input :sound-id]}
                            :volume {:ref [:input :sound-volume]}
                            :pitch {:ref [:input :sound-pitch]}
                            :position {:ref [:input :sound-position]}}}
                    {:at {:ref [:input :fade-at]}
                     :node {:component :vfx/fade
                            :from-tick {:ref [:input :fade-from-tick]}
                            :to-tick {:ref [:input :fade-to-tick]}
                            :from-alpha {:ref [:input :fade-from-alpha]}
                            :to-alpha {:ref [:input :fade-to-alpha]}
                            :child {:component :vfx/beam
                                    :start {:ref [:input :start]}
                                    :end {:ref [:input :end]}
                                    :layers {:ref [:input :fade-layers]}}}}]}
 :bounds {:component :vfx/beam-bounds
          :start {:ref [:input :start]}
          :end {:ref [:input :end]}
          :radius 0.8}}



{:schema-version 1
 :kind :vfx-effect
 :id :vec-reflection-field
 :revision 1
 :lifecycle :session
 :inputs {:spawn {:position :vec3}
          :update {:position :vec3}
          :destroy {}}
 :state-slots {:age :double :seed :long}
 :graph {:component :vfx/timeline
         :duration-ticks 4096
         :children [{:at 0
                     :node {:component :vfx/ring
                            :center {:ref [:input :position]}
                            :radius {:from 0.45 :to 0.9}
                            :segments 20
                            :color [188 252 238 150]}}
                    {:at 0
                     :node {:component :vfx/emitter
                            :anchor {:ref [:input :position]}
                            :rate-per-tick 2
                            :limit 128
                            :particle {:material :additive
                                       :life-ticks 12
                                       :speed 0.04}}}]}
 :bounds {:component :vfx/beam-bounds
          :start {:ref [:input :position]}
          :end {:ref [:input :position]}
          :radius 1.2}}

{:schema-version 1
 :kind :vfx-effect
 :id :scatter-bomb-charge
 :revision 1
 :lifecycle :session
 :inputs {:spawn {:owner :owner-id :position :vec3 :balls :long}
          :update {:position :vec3 :balls :long}}
 :state-slots {:age :double :seed :long}
 :graph {:component :vfx/timeline
         :duration-ticks 4096
         :children [{:at 0
                     :node {:component :vfx/emitter
                            :anchor {:ref [:input :position]}
                            :rate-per-tick 2
                            :limit 128
                            :particle {:material :additive
                                       :life-ticks 10
                                       :speed 0.04}}}
                    {:at 0
                     :node {:component :vfx/audio-one-shot
                            :sound-id "academy:md.sb_charge"
                            :volume 0.5
                            :pitch 1.0
                            :position {:ref [:input :position]}}}]}}

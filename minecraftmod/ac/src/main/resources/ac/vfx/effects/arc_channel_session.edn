{:schema-version 1
 :kind :vfx-effect
 :id :arc-channel-session
 :revision 1
 :lifecycle :session
 :inputs
 {:spawn {:mode :keyword :caster :vec3 :target :object
          :block-pos :object :block-bounds :object :good? :boolean
          :charge-ticks :long :visual-max-ticks :long :style :object}
  :update {:mode :keyword :caster :vec3 :target :object
           :block-pos :object :block-bounds :object :good? :boolean
           :charge-ticks :long :visual-max-ticks :long :style :object}
  :destroy {:fade-ticks :long}}
 :state-slots {:age :double :seed :long}
 :graph {:component :vfx/channel-arc
         :mode {:ref [:input :mode]}
         :caster {:ref [:input :caster]}
         :target {:ref [:input :target]}
         :block-pos {:ref [:input :block-pos]}
         :block-bounds {:ref [:input :block-bounds]}
         :good? {:ref [:input :good?]}
         :charge-ticks {:ref [:input :charge-ticks]}
         :visual-max-ticks {:ref [:input :visual-max-ticks]}
         :style {:ref [:input :style]}
         :seed {:ref [:state :seed]}}
 :bounds {:component :vfx/beam-bounds
          :start {:ref [:input :caster]}
          :end {:ref [:input :target]}
          :radius 2.0}}

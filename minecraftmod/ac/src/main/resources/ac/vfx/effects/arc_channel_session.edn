{:schema-version 1
 :kind :vfx/system
 :asset/type :vfx/system
 :asset/version 1
 :id :arc-channel-session
 :revision 1
 :lifecycle :session
 :inputs
 {:spawn {:mode :resource-id :caster :vec3 :target :any
          :block-pos :any :block-bounds :any :good? :bool
          :charge-ticks :int :visual-max-ticks :int :style :any}
  :update {:mode :resource-id :caster :vec3 :target :any
           :block-pos :any :block-bounds :any :good? :bool
           :charge-ticks :int :visual-max-ticks :int :style :any}
  :destroy {:fade-ticks :int}}
 :state-slots {:age :float :seed :int}
 :control-graph {:component :vfx/channel-arc
         :mode {:ref [:input :mode]}
         :caster {:ref [:input :caster]}
         :target {:ref [:input :target]}
         :block-pos {:ref [:input :block-pos]}
         :block-bounds {:ref [:input :block-bounds]}
         :good? {:ref [:input :good?]}
         :charge-ticks {:ref [:input :charge-ticks]}
         :visual-max-ticks {:ref [:input :visual-max-ticks]}
         :style {:ref [:input :style]}
         :seed {:ref [:state :seed]}}
 :bounds {:component :vfx/beam-bounds
          :start {:ref [:input :caster]}
          :end {:ref [:input :target]}
          :radius 2.0}}



{:schema-version 1
 :kind :vfx-effect
 :id :railgun-beam
 :revision 1
 :lifecycle :transient
 :inputs {:spawn {:start :vec3
                  :end :vec3
                  :mode [:enum :main :reflected]
                  :life-ticks :long}}
 :state-slots {:age :double :seed :long}
 :graph {:component :vfx/beam-arc-fade
         :duration-ticks 50
         :beam-at 0
         :start {:ref [:input :start]}
         :end {:ref [:input :end]}
         :grow-ticks 3
         :layers [{:shape :tube :radius 0.13 :color [236 170 93 60]}
                  {:shape :tube :radius 0.09 :color [241 240 222 200]}
                  {:shape :line :width 0.02 :color [165 230 255 160]}]
         :arc-at 3
         :arc-spacing {:min 1.0 :max 2.0}
         :arc-radius {:min 0.1 :max 0.25}
         :arc-count-limit 64
         :arc-life-ticks 30
         :seed {:ref [:state :seed]}
         :fade-at 30
         :fade-from-tick 30
         :fade-to-tick 50
         :fade-from-alpha 1.0
         :fade-to-alpha 0.0
         :ring-radius 0.34
         :ring-segments 12
         :ring-color [188 252 238 180]}
 :bounds {:component :vfx/beam-bounds
          :start {:ref [:input :start]}
          :end {:ref [:input :end]}
          :radius 1.2}}

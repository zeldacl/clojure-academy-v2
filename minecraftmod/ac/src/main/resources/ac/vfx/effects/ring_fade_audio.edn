{:schema-version 1
 :kind :vfx/system
 :asset/type :vfx/system
 :asset/version 1
 :id :ring-fade-audio
 :revision 1
 :lifecycle :transient
 :inputs
 {:spawn {:position :vec3 :duration-ticks :int :ring-from :float
          :ring-to :float :ring-segments :int :ring-color :any
          :fade-at :int :fade-to-tick :int :fade-ring-from :float
          :fade-ring-to :float :fade-segments :int :fade-color :any
          :sound-id :string :sound-volume :float :sound-pitch :float}}
 :state-slots {:age :float :seed :int}
 :control-graph {:component :vfx/timeline
         :duration-ticks {:ref [:input :duration-ticks]}
         :children [{:at 0
                     :node {:component :vfx/ring
                            :center {:ref [:input :position]}
                            :radius {:from {:ref [:input :ring-from]}
                                     :to {:ref [:input :ring-to]}}
                            :segments {:ref [:input :ring-segments]}
                            :color {:ref [:input :ring-color]}}}
                    {:at 0
                     :node {:component :vfx/audio-one-shot
                            :sound-id {:ref [:input :sound-id]}
                            :volume {:ref [:input :sound-volume]}
                            :pitch {:ref [:input :sound-pitch]}
                            :position {:ref [:input :position]}}}
                    {:at {:ref [:input :fade-at]}
                     :node {:component :vfx/fade
                            :from-tick {:ref [:input :fade-at]}
                            :to-tick {:ref [:input :fade-to-tick]}
                            :from-alpha 1.0 :to-alpha 0.0
                            :child {:component :vfx/ring
                                    :center {:ref [:input :position]}
                                    :radius {:from {:ref [:input :fade-ring-from]}
                                             :to {:ref [:input :fade-ring-to]}}
                                    :segments {:ref [:input :fade-segments]}
                                    :color {:ref [:input :fade-color]}}}}]}
 :bounds {:component :vfx/beam-bounds
          :start {:ref [:input :position]}
          :end {:ref [:input :position]}
          :radius 1.4}}


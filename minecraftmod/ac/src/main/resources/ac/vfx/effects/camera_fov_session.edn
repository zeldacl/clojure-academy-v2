{:schema-version 1
 :kind :vfx-effect
 :id :camera-fov-session
 :revision 1
 :lifecycle :session
 ;; Camera FOV is a first-person-only effect; broadcasting it to nearby
 ;; players would offset THEIR camera, not the caster's.
 :audience {:scope :self}
 :inputs {:spawn {:offset :double}
          :update {:offset :double}
          :destroy {}}
 :state-slots {:offset :double}
 :graph {:component :vfx/timeline
         :duration-ticks 4096
         :children [{:at 0
                     :node {:component :vfx/camera
                            :operation :fov-offset
                            :value {:ref [:input :offset]}
                            :duration-ticks 1}}]}}

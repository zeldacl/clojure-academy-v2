{:schema-version 1
 :kind :vfx-effect
 :id :vortex-column-session
 :revision 1
 :lifecycle :session
 ;; An independently reusable rotating column.  It has no knowledge of an
 ;; orb, projectile or skill; callers choose the axis, geometry and palette
 ;; through the payload.
 :inputs
 {:spawn {:base :vec3 :axis :vec3 :height :double :spacing :object
          :radius :object :count-limit :long :life-ticks :long
          :seed :long :orientation {:type :object :default nil}}
  :update {:base :vec3 :orientation {:type :object :default nil}}
  :destroy {:fade-ticks :long}}
 :state-slots {:age :double :seed :long}
 :graph {:component :vfx/timeline
         :duration-ticks 4096
         :children [{:at 0
                     :node {:component :vfx/vortex-column
                            :base {:ref [:input :base]}
                            :axis {:ref [:input :axis]}
                            :orientation {:ref [:input :orientation]}
                            :height {:ref [:input :height]}
                            :spacing {:ref [:input :spacing]}
                            :radius {:ref [:input :radius]}
                            :count-limit {:ref [:input :count-limit]}
                            :life-ticks {:ref [:input :life-ticks]}
                            :seed {:ref [:input :seed]}}}]}}

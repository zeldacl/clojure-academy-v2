{:schema-version 1
 :kind :vfx/system
 :asset/type :vfx/system
 :asset/version 1
 :id :vortex-column-session
 :revision 1
 :lifecycle :session
 ;; An independently reusable rotating column.  It has no knowledge of an
 ;; orb, projectile or skill; callers choose the axis, geometry and palette
 ;; through the payload.
 :inputs
 {:spawn {:base :vec3 :axis :vec3 :height :float :spacing :any
          :radius :any :count-limit :int :life-ticks :int
          :seed :int :alpha {:type :float :default 1.0}
          :orientation {:type :any :default nil}}
  :update {:base :vec3 :alpha {:type :float :default 1.0}
           :orientation {:type :any :default nil}}
  :destroy {:fade-ticks :int}}
 :state-slots {:age :float :seed :int}
 :control-graph {:component :vfx/timeline
         :duration-ticks 4096
         :children [{:at 0
                     :node {:component :vfx/vortex-column
                            :base {:ref [:input :base]}
                            :axis {:ref [:input :axis]}
                            :alpha {:ref [:input :alpha]}
                            :orientation {:ref [:input :orientation]}
                            :height {:ref [:input :height]}
                            :spacing {:ref [:input :spacing]}
                            :radius {:ref [:input :radius]}
                            :count-limit {:ref [:input :count-limit]}
                            :life-ticks {:ref [:input :life-ticks]}
                            :seed {:ref [:input :seed]}}}]}}



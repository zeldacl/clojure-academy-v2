{:schema-version 1
 :kind :vfx-effect
 :id :penetrate-teleport-marker
 :revision 1
 :lifecycle :session
 :inputs
 {:spawn {:owner :owner-id
          :position :vec3
          :available? :bool
          :distance :double
          :color :object
          :particle-chance :double}
  :update {:position :vec3
           :available? :bool
           :distance :double
           :color :object
           :particle-chance :double}}
 :state-slots {:age :double :seed :long}
 :graph
 {:component :vfx/timeline
  :duration-ticks 120
  :children [{:at 0
              :node {:component :vfx/humanoid-marker
                     :anchor {:ref [:input :position]}
                     :owner {:ref [:input :owner]}
                     :texture-pattern "academy:textures/effects/tp_mark/%d.png"
                     :frame-count 7
                     :frame-period-ticks 2.5
                     :color {:ref [:input :color]}
                     :facing :owner}}
             {:at 0
              :node {:component :vfx/emitter
                     :anchor {:ref [:input :position]}
                     :rate-per-tick 1
                     :chance {:ref [:input :particle-chance]}
                     :limit 256
                     :particle {:material :additive
                                :life-ticks 12
                                :speed 0.08
                                :color {:ref [:input :color]}
                                :spread {:x 1.0 :y 1.4 :z 1.0}
                                :velocity {:x 0.03 :y 0.05 :z 0.03}
                                :size {:min 0.1 :max 0.2}
                                :alpha {:min 153 :max 204}
                                :fade-in-ticks 5
                                :fade-out-ticks 20}}}]}
 :bounds {:component :vfx/beam-bounds
          :start {:ref [:input :position]}
          :end {:ref [:input :position]}
          :radius 1.2}}


{:schema-version 2
 :kind :vfx/system
 :asset/type :vfx/system
 :asset/version 1
 :id :particle-burst
 :revision 1
 :lifecycle :transient
 :inputs
 {:spawn {:position :vec3 :rate-per-tick :int :limit :int :particle :any}}

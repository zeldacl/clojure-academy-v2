{:schema-version 2
 :kind :vfx-effect
 :id :particle-burst
 :revision 1
 :lifecycle :transient
 :inputs
 {:spawn {:position :vec3 :rate-per-tick :long :limit :long :particle :object}}
 :state-slots {:age :double :seed :long}
 :graph {:component :vfx/timeline
         :duration-ticks 1
         :children [{:at 0
                     :node {:component :vfx/emitter
                            :anchor {:ref [:input :position]}
                            :rate-per-tick {:ref [:input :rate-per-tick]}
                            :limit {:ref [:input :limit]}
                            :particle {:ref [:input :particle]}}}]}}

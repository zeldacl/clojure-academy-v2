{:schema-version 1
 :kind :vfx-effect
 :id :penetrate-teleport-release
 :revision 1
 :lifecycle :transient
 :inputs {:spawn {:position :vec3 :distance :double}}
 :state-slots {:age :double :seed :long}
 :graph
 {:component :vfx/timeline
  :duration-ticks 1
  :children [{:at 0
              :node {:component :vfx/audio-one-shot
                     :sound-id "academy:tp.tp"
                     :volume 0.5
                     :pitch 1.0
                     :position {:ref [:input :position]}}}]}
 :bounds {:component :vfx/beam-bounds
          :start {:ref [:input :position]}
          :end {:ref [:input :position]}
          :radius 1.0}}


{:schema-version 2
 :kind :vfx/system
 :asset/type :vfx/system
 :asset/version 1
 :id :target-box-session
 :revision 1
 :lifecycle :session
 :inputs
 {:spawn {:position :vec3 :width :float :height :float :color :any}
  :update {:position :vec3 :width :float :height :float :color :any}
  :destroy {}}
 :state-slots {:age :float :seed :int}
 :control-graph {:component :vfx/block-progress
  :target {:ref [:input :position]}
  :progress 0.0
  :color {:ref [:input :color]}
  :width {:ref [:input :width]}
  :height {:ref [:input :height]}
  :corner-length 0.2
  :pulse-period 0.0}
 :bounds {:component :vfx/beam-bounds
          :start {:ref [:input :position]}
          :end {:ref [:input :position]}
          :radius 1.2}}



{:schema-version 2
 :kind :vfx-effect
 :id :target-box-session
 :revision 1
 :lifecycle :session
 :inputs
 {:spawn {:position :vec3 :width :double :height :double :color :object}
  :update {:position :vec3 :width :double :height :double :color :object}
  :destroy {}}
 :state-slots {:age :double :seed :long}
 :graph
 {:component :vfx/block-progress
  :target {:ref [:input :position]}
  :progress 0.0
  :color {:ref [:input :color]}
  :width {:ref [:input :width]}
  :height {:ref [:input :height]}
  :corner-length 0.2
  :pulse-period 0.0}
 :bounds {:component :vfx/beam-bounds
          :start {:ref [:input :position]}
          :end {:ref [:input :position]}
          :radius 1.2}}

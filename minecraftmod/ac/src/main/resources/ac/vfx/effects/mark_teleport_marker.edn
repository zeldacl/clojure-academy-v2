{:schema-version 1
 :kind :vfx-effect
 :id :mark-teleport-marker
 :revision 1
 :lifecycle :session
 :inputs
 {:spawn {:owner :owner-id :position :vec3 :distance :double}
  :update {:position :vec3 :distance :double}}
 :state-slots {:age :double :seed :long}
 :graph
 {:component :vfx/timeline
  :duration-ticks 120
  :children [{:at 0
              :node {:component :vfx/ring
                     :center {:ref [:input :position]}
                     :radius {:from 0.25 :to 0.5}
                     :segments 16
                     :color [188 252 238 210]}}
             {:at 0
              :node {:component :vfx/emitter
                     :anchor {:ref [:input :position]}
                     :rate-per-tick 1
                     :chance 0.4
                     :limit 256
                     :particle {:material :additive
                                :life-ticks 12
                                :speed 0.08
                                :color [188 252 238 200]
                                :spread {:x 1.0 :y 1.4 :z 1.0}
                                :velocity {:x 0.03 :y 0.05 :z 0.03}
                                :size {:min 0.1 :max 0.2}
                                :alpha {:min 153 :max 204}
                                :fade-in-ticks 5
                                :fade-out-ticks 20}}}
             {:at 0
              ;; The source implementation is a seven-part 3D biped, not a
              ;; billboard.  Keep that geometry in the reusable VFX composite;
              ;; this effect supplies only its asset/position parameters.
              :node {:component :vfx/humanoid-marker
                     :anchor {:ref [:input :position]}
                     :owner {:ref [:input :owner]}
                     :texture-pattern "academy:textures/effects/tp_mark/%d.png"
                     :frame-count 7
                     :frame-period-ticks 2.5
                     :color [188 252 238 255]
                     :facing :owner}}
             {:at 0
              :node {:component :vfx/audio-loop
                     :sound-id "academy:em.teleport.mark"
                     :volume 0.25
                     :pitch 1.0
                     :instance-key [:effect-instance :mark-loop]
                     :stop-on-destroy? true}}]}
 :bounds {:component :vfx/beam-bounds
          :start {:ref [:input :position]}
          :end {:ref [:input :position]}
          :radius 1.2}}

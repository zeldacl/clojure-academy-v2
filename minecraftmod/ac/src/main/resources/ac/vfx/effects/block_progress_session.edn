{:schema-version 2
 :kind :vfx/system
 :asset/type :vfx/system
 :asset/version 1
 :id :block-progress-session
 :revision 1
 :lifecycle :session
 :inputs
 {:spawn {:target :vec3 :progress :float :color :any
          :pulse-period {:type :float :default 0.3}}

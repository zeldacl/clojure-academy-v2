{:schema-version 2
 :kind :vfx-effect
 :id :block-progress-session
 :revision 1
 :lifecycle :session
 :inputs
 {:spawn {:target :vec3 :progress :double :color :object
          :pulse-period {:type :double :default 0.3}}
  :update {:target {:type :vec3} :progress {:type :double}
           :color {:type :object} :pulse-period {:type :double}}
  :destroy {:fade-ticks :long}}
 :state-slots {:age :double :seed :long}
 :graph {:component :vfx/block-progress
         :target {:ref [:input :target]}
         :progress {:ref [:input :progress]}
         :color {:ref [:input :color]}
         :pulse-period {:ref [:input :pulse-period]}}}

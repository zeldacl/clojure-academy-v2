{:schema-version 1
 :kind :vfx-effect
 :id :railgun-beam
 :revision 1
 :lifecycle :transient
 :inputs {:spawn {:start :vec3
                  :end :vec3
                  :mode [:enum :main :reflected]
                  :life-ticks :long}}
 :state-slots {:age :double :seed :long}
 :graph {:component :vfx/timeline
         :duration-ticks 50
         :children [{:at 0
                     :node {:component :vfx/beam
                            :start {:ref [:input :start]}
                            :end {:ref [:input :end]}
                            :grow-ticks 3
                            :layers [{:shape :tube :radius 0.13 :color [236 170 93 60]}
                                     {:shape :tube :radius 0.09 :color [241 240 222 200]}
                                     {:shape :line :width 0.02 :color [165 230 255 160]}]}}
                    {:at 3
                     :node {:component :vfx/arc-field
                            :start {:ref [:input :start]}
                            :end {:ref [:input :end]}
                            :spacing {:min 1.0 :max 2.0}
                            :radius {:min 0.1 :max 0.25}
                            :count-limit 64
                            :life-ticks 30
                            :seed {:ref [:state :seed]}}}
                    {:at 30
                     :node {:component :vfx/fade
                            :from-tick 30
                            :to-tick 50
                            :from-alpha 1.0
                            :to-alpha 0.0
                            :child {:component :vfx/ring
                                    :center {:ref [:input :end]}
                                    :radius 0.34
                                    :segments 12
                                    :color [188 252 238 180]}}}]}
 :bounds {:component :vfx/beam-bounds
          :start {:ref [:input :start]}
          :end {:ref [:input :end]}
          :radius 1.2}}

{:schema-version 1
 :kind :vfx-effect
 :id :arc-gen
 :revision 1
 :lifecycle :transient
 :inputs {:spawn {:start :vec3
                  :end :vec3
                  :hit-type [:enum :entity :block :miss]
                  :sound-pos :vec3
                  :life-ticks :long}}
 :state-slots {:age :double :seed :long}
 :graph {:component :vfx/timeline
         :duration-ticks 10
         :children [{:at 0
                     :node {:component :vfx/beam
                            :start {:ref [:input :start]}
                            :end {:ref [:input :end]}
                            :grow-ticks 2
                            :layers [{:shape :tube :radius 0.08 :color [236 170 93 60]}
                                     {:shape :tube :radius 0.05 :color [241 240 222 200]}
                                     {:shape :line :width 0.015 :color [165 230 255 160]}]}}
                    {:at 0
                     :node {:component :vfx/arc-field
                            :start {:ref [:input :start]}
                            :end {:ref [:input :end]}
                            :spacing {:min 1.0 :max 2.0}
                            :radius {:min 0.06 :max 0.14}
                            :count-limit 32
                            :life-ticks 8
                            :seed {:ref [:state :seed]}}}
                    {:at 3
                     :node {:component :vfx/fade
                            :from-tick 3
                            :to-tick 10
                            :from-alpha 1.0
                            :to-alpha 0.0
                            :child {:component :vfx/ring
                                    :center {:ref [:input :end]}
                                    :radius {:from 0.12 :to 0.28}
                                    :segments 10
                                    :color [188 252 238 180]}}}
                    {:at 0
                     :node {:component :vfx/audio-one-shot
                            :sound-id "academy:em.arc_weak"
                            :volume 0.5
                            :pitch 1.0
                            :position {:ref [:input :sound-pos]}}}]}
 :bounds {:component :vfx/beam-bounds
          :start {:ref [:input :start]}
          :end {:ref [:input :end]}
          :radius 0.8}}

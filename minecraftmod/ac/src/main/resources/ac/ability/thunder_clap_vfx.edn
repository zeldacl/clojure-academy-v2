{:schema-version 1
 :kind :vfx-effect
 :id :thunder-clap
 :revision 1
 :lifecycle :session
 :inputs {:spawn {:caster :owner-id :caster-position :vec3 :target :vec3 :ticks :long}
          :update {:target :vec3 :ticks :long :ratio :double}
          :perform {:target :vec3 :ticks :long :ratio :double}}
 :state-slots {:age :double :seed :long}
 :graph {:component :vfx/timeline
         :duration-ticks 64
         :children [{:at 0
                     :node {:component :vfx/arc-field
                            :start {:ref [:input :caster-position]}
                            :end {:ref [:input :target]}
                            :spacing {:min 1.0 :max 2.0}
                            :radius {:min 0.08 :max 0.22}
                            :count-limit 64
                            :life-ticks 60
                            :seed {:ref [:state :seed]}}}
                    {:at 0
                     :node {:component :vfx/ring
                            :center {:ref [:input :target]}
                            :radius {:from 0.25 :to 1.5}
                            :segments 24
                            :color [188 252 238 210]}}
                    {:at 0
                     :node {:component :vfx/audio-one-shot
                            :sound-id "minecraft:entity.lightning_bolt.thunder"
                            :volume 0.7
                            :pitch 1.0
                            :position {:ref [:input :target]}}}
                    {:at 40
                     :node {:component :vfx/fade
                            :from-tick 40
                            :to-tick 64
                            :from-alpha 1.0
                            :to-alpha 0.0
                            :child {:component :vfx/ring
                                    :center {:ref [:input :target]}
                                    :radius {:from 1.5 :to 2.0}
                                    :segments 24
                                    :color [236 170 93 150]}}}]}
 :bounds {:component :vfx/beam-bounds
          :start {:ref [:input :caster-position]}
          :end {:ref [:input :target]}
          :radius 2.0}}

{:kind :composite, :id :target/directional-destination, :revision 1, :layer :mid, :doc "Generic directional landing query: given a neutral movement direction keyword (:forward/:back/:left/:right), resolve where the caster would land. The host owns only raycast and block reads and applies the EDN-supplied landing policy. Port of the old v2 :target/directional-destination composite (ac/combat/components/target_directional_destination.edn) into the v3 model.", :category :targeting, :inputs {:origin {:type :vec3}, :look {:type :vec3}, :eye-y {:type :double}, :direction {:type :keyword, :default :forward}, :distance {:type :double}, :policy {:type :map, :default {}}}, :outputs {:destination {:type :destination, :from [:local :destination]}}, :body {:component :target/directional-destination-query, :origin {:ref [:input :origin]}, :look {:ref [:input :look]}, :eye-y {:ref [:input :eye-y]}, :direction {:ref [:input :direction]}, :distance {:ref [:input :distance]}, :policy {:ref [:input :policy]}, :bind {:destination :destination}}}

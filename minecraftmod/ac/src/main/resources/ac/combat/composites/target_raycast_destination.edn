{:kind :composite, :id :target/raycast-destination, :revision 1, :layer :composite, :doc "Generic two-stage target query: cast a ray, then resolve its neutral landing point. The host performs only neutral raycast and landing-point resolution; callers decide the policy and distance. Both the raw :hit and the resolved :destination are exposed as outputs so a caller that needs the raw hit (e.g. for entity-specific follow-up) doesn't have to re-raycast. Port of the old v2 :target/raycast-destination composite (ac/combat/components/target_raycast_destination.edn) into the v3 model.", :category :targeting, :inputs {:origin {:type :vec3}, :direction {:type :vec3}, :distance {:type :float}, :policy {:type :map, :default {}}, :include-entities? {:type :bool, :default true}, :include-blocks? {:type :bool, :default true}}, :outputs {:hit {:type :hit-result, :from [:local :hit]}, :destination {:type :destination, :from [:local :destination]}}, :body {:component :flow/sequence, :steps [{:component :target/raycast, :origin {:ref [:input :origin]}, :direction {:ref [:input :direction]}, :distance {:ref [:input :distance]}, :include-entities? {:ref [:input :include-entities?]}, :include-blocks? {:ref [:input :include-blocks?]}, :bind {:hit :hit}} {:component :target/resolve-destination, :hit {:ref [:local :hit]}, :origin {:ref [:input :origin]}, :direction {:ref [:input :direction]}, :distance {:ref [:input :distance]}, :policy {:ref [:input :policy]}, :bind {:destination :destination}}]}}



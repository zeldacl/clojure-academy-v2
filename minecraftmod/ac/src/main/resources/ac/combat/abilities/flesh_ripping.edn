{:schema-version 2
  :kind :ability
  :id :flesh-ripping
  :revision 2
  :engine :final
  :activation :session
  :status :migrated
  :requires [:caster/id
    :caster/eye
    :caster/aim
    :caster/creative?
    :world/id
    :rng/seed]
  :prerequisites [{:skill-id :mark-teleport
      :min-exp 0.5}
    {:skill-id :penetrate-teleport
      :min-exp 0.5}]
  :tunables {:targeting-range {:curve :mastery-lerp}
    :damage {:curve :mastery-lerp}
    :nausea-chance {:curve :const}
    :nausea-duration-ticks {:curve :const
      :type :long}
    :nausea-amplifier {:curve :const
      :type :long}
    :release-cp {:curve :mastery-lerp}
    :release-overload {:curve :mastery-lerp}
    :cooldown-ticks {:curve :mastery-lerp
      :type :long}
    :exp-hit {:curve :const}}
  :costs {:release {:resources {:cp {:tunable :release-cp}
        :overload {:tunable :release-overload}}}}
  :progression {:hit {:per-mark {:tunable :exp-hit}}}
  :cooldown {:main {:ticks {:tunable :cooldown-ticks}}}
  :program {:component :flow/phases
    :start {:component :flow/sequence
      :steps [{:component :ability/caster
          :bind {:eye :eye
            :aim :aim
            :id :owner-id
            :creative? :creative?
            :world-id :wid}}
        {:component :ability/tunable
          :name :targeting-range
          :bind {:value :targeting-range}}
        {:component :target/raycast
          :origin {:ref [:local
              :eye]}
          :direction {:ref [:local
              :aim]}
          :distance {:ref [:local
              :targeting-range]}
          :include-entities? true
          :include-blocks? false
          :living-only? true
          :bind {:hit :trace}}
        {:component :effect/vfx
          :effect-id :target-box-session
          :operation :spawn
          :instance-key [:activation
            :flesh-ripping-marker]
          :payload {:position {:ref [:local
                :trace
                :position]}
            :width {:expr :math/select
              :args [{:ref [:local
                    :trace
                    :attacked?]}
                {:ref [:local
                    :trace
                    :target-width]}
                1.0]}
            :height {:expr :math/select
              :args [{:ref [:local
                    :trace
                    :attacked?]}
                {:ref [:local
                    :trace
                    :target-height]}
                1.0]}
            :color {:expr :math/select
              :args [{:ref [:local
                    :trace
                    :attacked?]}
                [185
                  25
                  25
                  180]
                [74
                  74
                  74
                  160]]}}
          :audience {:type :nearby
            :radius 64.0}}
        {:component :flow/finish
          :outcome :started}]}
    :pulse {:component :flow/sequence
      :steps [{:component :ability/caster
          :bind {:creative? :creative?}}
        {:component :ability/tunable
          :name :release-cp
          :bind {:value :release-cp}}
        {:component :ability/context
          :name :resources
          :bind {:value :context-resources}}
        {:component :flow/branch
          :when {:expr :bool/or
            :args [{:ref [:local
                  :creative?]}
              {:expr :math/gte
                :args [{:ref [:local
                      :context-resources
                      :cp]}
                  {:ref [:local
                      :release-cp]}]}]}
          :then {:component :flow/sequence
            :steps [{:component :ability/caster
                :bind {:eye :eye
                  :aim :aim
                  :id :owner-id
                  :creative? :creative?
                  :world-id :wid}}
              {:component :ability/tunable
                :name :targeting-range
                :bind {:value :targeting-range}}
              {:component :target/raycast
                :origin {:ref [:local
                    :eye]}
                :direction {:ref [:local
                    :aim]}
                :distance {:ref [:local
                    :targeting-range]}
                :include-entities? true
                :include-blocks? false
                :living-only? true
                :bind {:hit :trace}}
              {:component :effect/vfx
                :effect-id :target-box-session
                :operation :update
                :instance-key [:activation
                  :flesh-ripping-marker]
                :payload {:position {:ref [:local
                      :trace
                      :position]}
                  :width {:expr :math/select
                    :args [{:ref [:local
                          :trace
                          :attacked?]}
                      {:ref [:local
                          :trace
                          :target-width]}
                      1.0]}
                  :height {:expr :math/select
                    :args [{:ref [:local
                          :trace
                          :attacked?]}
                      {:ref [:local
                          :trace
                          :target-height]}
                      1.0]}
                  :color {:expr :math/select
                    :args [{:ref [:local
                          :trace
                          :attacked?]}
                      [185
                        25
                        25
                        180]
                      [74
                        74
                        74
                        160]]}}
                :audience {:type :nearby
                  :radius 64.0}}
              {:component :flow/finish
                :outcome :continue}]}
          :else {:component :flow/sequence
            :steps [{:component :effect/vfx
                :effect-id :target-box-session
                :operation :destroy
                :instance-key [:activation
                  :flesh-ripping-marker]
                :payload {}}
              {:component :flow/finish
                :outcome :insufficient-resource
                :finish-session? true}]}}]}
    :release {:component :flow/sequence
      :steps [{:component :ability/caster
          :bind {:eye :eye
            :aim :aim
            :id :owner-id
            :creative? :creative?
            :world-id :wid}}
        {:component :ability/tunable
          :name :targeting-range
          :bind {:value :targeting-range}}
        {:component :target/raycast
          :origin {:ref [:local
              :eye]}
          :direction {:ref [:local
              :aim]}
          :distance {:ref [:local
              :targeting-range]}
          :include-entities? true
          :include-blocks? false
          :living-only? true
          :bind {:hit :trace}}
        {:component :flow/branch
          :when {:ref [:local
              :trace
              :attacked?]}
          :then {:component :flow/sequence
            :steps [{:component :ability/tunable
                :name :damage
                :bind {:value :damage}}
              {:component :ability/tunable
                :name :nausea-chance
                :bind {:value :nausea-chance}}
              {:component :ability/tunable
                :name :nausea-duration-ticks
                :bind {:value :nausea-duration-ticks}}
              {:component :ability/tunable
                :name :nausea-amplifier
                :bind {:value :nausea-amplifier}}
              {:component :ability/budget
                :name :release
                :bind {:budget :release-budget}}
              {:component :ability/progression
                :name :hit
                :bind {:progression :hit-progression}}
              {:component :ability/cooldown
                :name :main
                :bind {:cooldown :main-cooldown}}
              {:component :cost/spend
                :budget {:ref [:local
                    :release-budget]}
                :bind {:insufficient? :insufficient?}}
              {:component :flow/branch
                :when {:ref [:local
                    :insufficient?]}
                :then {:component :flow/sequence
                  :steps [{:component :effect/vfx
                      :effect-id :particle-burst
                      :operation :spawn
                      :payload {:position {:ref [:local
                            :trace
                            :position]}
                        :rate-per-tick 6
                        :limit 6
                        :particle {:material :additive
                          :color [180
                            20
                            20
                            230]
                          :life-ticks 10
                          :speed 0.08
                          :spread {:x 0.35
                            :y 0.55
                            :z 0.35}}}
                      :audience {:type :nearby
                        :radius 64.0}}
                    {:component :effect/vfx
                      :effect-id :audio-one-shot
                      :operation :spawn
                      :payload {:position {:ref [:local
                            :trace
                            :position]}
                        :sound-id "academy:tp.guts"
                        :volume 0.6
                        :pitch 1.0}
                      :audience {:type :nearby
                        :radius 64.0}}
                    {:component :effect/vfx
                      :effect-id :target-box-session
                      :operation :destroy
                      :instance-key [:activation
                        :flesh-ripping-marker]
                      :payload {}}
                    {:component :flow/finish
                      :outcome :insufficient-resource
                      :finish-session? true}]}
                :else {:component :flow/sequence
                  :steps [{:component :combat/damage
                      :target {:ref [:local
                          :trace
                          :target-id]}
                      :amount {:ref [:local
                          :damage]}
                      :damage-type :magic}
                    {:component :flow/branch
                      :when {:expr :random/chance
                        :args [{:ref [:local
                              :nausea-chance]}]}
                      :then {:component :combat/status
                        :target {:ref [:local
                            :owner-id]}
                        :status-id :nausea
                        :duration-ticks {:ref [:local
                            :nausea-duration-ticks]}
                        :amplifier {:ref [:local
                            :nausea-amplifier]}}}
                    {:component :score/mark
                      :progression {:ref [:local
                          :hit-progression]}}
                    {:component :cooldown/start
                      :name :main
                      :cooldown {:ref [:local
                          :main-cooldown]}}
                    {:component :effect/vfx
                      :effect-id :particle-burst
                      :operation :spawn
                      :payload {:position {:ref [:local
                            :trace
                            :position]}
                        :rate-per-tick 6
                        :limit 6
                        :particle {:material :additive
                          :color [180
                            20
                            20
                            230]
                          :life-ticks 10
                          :speed 0.08
                          :spread {:x 0.35
                            :y 0.55
                            :z 0.35}}}
                      :audience {:type :nearby
                        :radius 64.0}}
                    {:component :effect/vfx
                      :effect-id :audio-one-shot
                      :operation :spawn
                      :payload {:position {:ref [:local
                            :trace
                            :position]}
                        :sound-id "academy:tp.guts"
                        :volume 0.6
                        :pitch 1.0}
                      :audience {:type :nearby
                        :radius 64.0}}
                    {:component :effect/vfx
                      :effect-id :target-box-session
                      :operation :destroy
                      :instance-key [:activation
                        :flesh-ripping-marker]
                      :payload {}}
                    {:component :flow/finish
                      :outcome :performed
                      :finish-session? true}]}}]}
          :else {:component :flow/sequence
            :steps [{:component :effect/vfx
                :effect-id :target-box-session
                :operation :destroy
                :instance-key [:activation
                  :flesh-ripping-marker]
                :payload {}}
              {:component :effect/vfx
                :effect-id :audio-one-shot
                :operation :spawn
                :payload {:position {:ref [:local
                      :trace
                      :position]}
                  :sound-id "academy:tp.guts"
                  :volume 0.6
                  :pitch 1.0}
                :audience {:type :nearby
                  :radius 64.0}}
              {:component :flow/finish
                :outcome :miss
                :finish-session? true}]}}]}
    :abort {:component :flow/sequence
      :steps [{:component :effect/vfx
          :effect-id :target-box-session
          :operation :destroy
          :instance-key [:activation
            :flesh-ripping-marker]
          :payload {}}
        {:component :flow/finish
          :outcome :aborted
          :finish-session? true}]}
    :events {}}}

{:schema-version 2
 :kind :ability
 :id :electron-bomb
 :revision 1
 :engine :final
 :activation :instant
 :status :migrated
 :requires [:caster/id :caster/eye :caster/aim :world/id
            :progression/mastery :rng/seed]
 :tunables
 {:damage {:curve :mastery-lerp}
  :cooldown-ticks {:curve :mastery-lerp}
  :exp-hit {:curve :const}
  :settle-ticks {:curve :const :type :long}
  :settle-ticks-improved {:curve :const :type :long}
  :improved-exp-threshold {:curve :const}}
 :cooldown {:main {:ticks {:tunable :cooldown-ticks}}}
 :progression {:cast {:per-mark {:tunable :exp-hit}}}
 :program
 {:component :flow/sequence
  :steps
  [{:component :ability/caster :bind {:id :owner-id :eye :eye :aim :aim :world-id :wid :mastery :mastery :seed :seed}}
   {:component :ability/tunable :name :improved-exp-threshold :bind {:value :improved-exp-threshold}}
   {:component :ability/tunable :name :settle-ticks :bind {:value :settle-ticks}}
   {:component :ability/tunable :name :settle-ticks-improved :bind {:value :settle-ticks-improved}}
   {:component :ability/tunable :name :damage :bind {:value :damage}}
   {:component :ability/progression :name :cast :bind {:progression :cast-progression}}
   {:component :ability/cooldown :name :main :bind {:cooldown :main-cooldown}}
   ;; EntityMdBall is a neutral transient projectile carrier.  Its renderer
   ;; supplies the visible orb; the EDN only supplies owner, position and
   ;; lifetime, so the same primitive can be reused by other skills.
   {:component :data/bind
    :to :ball-life-ticks
    :value {:expr :math/select
            :args [{:expr :math/gt :args [{:ref [:local :mastery]} {:ref [:local :improved-exp-threshold]}]}
                   {:ref [:local :settle-ticks-improved]} {:ref [:local :settle-ticks]}]}}
   {:component :entity/spawn
    :world-id {:ref [:local :wid]}
    :entity-type "academy:entity_md_ball"
    :owner {:ref [:local :owner-id]}
    :position {:ref [:local :eye]}
    :velocity {:vec3 [0.0 0.0 0.0]}
    :life-ticks {:ref [:local :ball-life-ticks]}}
   ;; The generic delayed beam resolves both selectors on settlement.  The
   ;; owner may turn or move during the delay, while the transient entity's
   ;; current position remains the ray origin.  `settlement-vfx` is a neutral
   ;; deferred presentation signal; no skill code is called by the scheduler.
   {:component :data/bind
    :to :destination
    :value {:expr :vec3/add :args [{:ref [:local :eye]} {:expr :vec3/scale :args [{:ref [:local :aim]} 15.0]}]}}
   {:component :projectile/schedule-beam
    :world-id {:ref [:local :wid]}
    :owner {:ref [:local :owner-id]}
    :origin {:ref [:local :eye]}
    :destination {:ref [:local :destination]}
    :origin-selector {:entity-type "academy:entity_md_ball"
                      :owner-id {:ref [:local :owner-id]}
                      :radius 3.5}
    :destination-selector {:mode :owner-raycast :distance 15.0}
    :exclude-owner? true
    :damage {:ref [:local :damage]}
    :damage-type :magic
    :delay-ticks {:expr :math/sub :args [{:ref [:local :ball-life-ticks]} 2]}
    :seed {:ref [:local :seed]}
    :instance-key [:activation :electron-bomb-ray]
    :settlement-vfx
    {:effect-id :arc-strike-transient
     :operation :spawn
     :audience {:type :nearby :radius 64.0}
     :payload {:aoe-origin {:ref [:local :eye]}
               :aoe-points []
               :arc-life-ticks 10
               :pattern :weak
               :hand-origin? false
               :sound-id nil
               :sound-volume 0.0
               :sound-pitch 1.0
               :sound-position {:ref [:local :eye]}
               :bounds-radius 0.8}}}
   ;; Original grants both progression and cooldown at cast time, before the
   ;; delayed ray can hit.  Keeping these nodes before the terminal finish
   ;; preserves that ordering and makes a no-hit ray side-effect free only in
   ;; the damage dimension.
   {:component :score/mark :progression {:ref [:local :cast-progression]}}
   {:component :cooldown/start :name :main :cooldown {:ref [:local :main-cooldown]}}
   {:component :flow/finish :outcome :performed}]}}

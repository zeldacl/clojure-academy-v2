{:schema-version 2
 :kind :ability
 :id :mine-detect
 :revision 2
 :engine :final
 :activation :instant
 :status :migrated
 :requires [:caster/id :caster/eye :world/id :progression/mastery
            :progression/level :rng/seed]
 :prerequisites [{:skill-id :mag-manip :min-exp 1.0}]
 :tunables
 {:targeting-range {:curve :mastery-lerp}
  :blindness-duration-ticks {:curve :const :type :long}
  :blindness-amplifier {:curve :const :type :long}
  :cost-down-cp {:curve :mastery-lerp}
  :cost-down-overload {:curve :mastery-lerp}
  :cooldown-ticks {:curve :mastery-lerp :type :long}
  :exp-cast {:curve :const}}
 :costs
 {:activate {:resources {:cp {:tunable :cost-down-cp}
                         :overload {:tunable :cost-down-overload}}}}
 :cooldown {:main {:ticks {:tunable :cooldown-ticks}}}
 :progression {:cast {:per-mark {:tunable :exp-cast}}}
 :program
 {:component :flow/sequence
  :steps
  [{:component :ability/caster
    :bind {:id :owner-id :eye :eye :world-id :wid :mastery :mastery :level :level}}
   {:component :ability/tunable :name :blindness-duration-ticks :bind {:value :blindness-duration-ticks}}
   {:component :ability/tunable :name :blindness-amplifier :bind {:value :blindness-amplifier}}
   {:component :ability/tunable :name :targeting-range :bind {:value :targeting-range}}
   {:component :ability/budget :name :activate :bind {:budget :activate-budget}}
   {:component :ability/progression :name :cast :bind {:progression :cast-progression}}
   {:component :ability/cooldown :name :main :bind {:cooldown :main-cooldown}}
   {:component :cost/spend :budget {:ref [:local :activate-budget]} :bind {:insufficient? :insufficient?}}
   {:component :flow/branch
    :when {:ref [:local :insufficient?]}
    :then {:component :flow/finish :outcome :insufficient-resource}
    :else
    {:component :flow/sequence
     :steps
     [{:component :combat/status
       :target {:ref [:local :owner-id]}
       :status-id :blindness
       :duration-ticks {:ref [:local :blindness-duration-ticks]}
       :amplifier {:ref [:local :blindness-amplifier]}}
      {:component :effect/vfx
       :effect-id :block-scan-transient
       :operation :spawn
       :instance-key [:activation :scan]
       :audience {:type :owner}
       :payload {:origin {:ref [:local :eye]}
                 :range {:ref [:local :targeting-range]}
                 :max-range 28.0
                 :filter {:include-suffixes ["_ore"]
                          :include-substrings ["ancient_debris"]
                          :include-tags ["forge:ores"]}
                 :advanced? {:expr :bool/and
                             :args [{:expr :math/gt :args [{:ref [:local :mastery]} 0.5]}
                                    {:expr :math/gte :args [{:ref [:local :level]} 4]}]}
                 :life-ticks 100 :rescan-interval 5 :max-results 8400
                 :texture "academy:textures/effects/mineview.png"
                 :base-color [220 235 255 185]
                 :tier-colors [{:harvest-level 0 :color [161 181 188 165]}
                               {:harvest-level 1 :color [87 231 248 190]}
                               {:harvest-level 2 :color [97 204 94 210]}
                               {:harvest-level 3 :color [235 109 84 225]}]}}
      {:component :score/mark :progression {:ref [:local :cast-progression]}}
      {:component :cooldown/start :name :main :cooldown {:ref [:local :main-cooldown]}}
      {:component :flow/finish :outcome :performed}]}}]}}

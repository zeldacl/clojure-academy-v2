{:schema-version 2
  :kind :ability
  :id :electron-missile
  :revision 2
  :engine :final
  :activation :session
  :status :migrated
  :requires [:caster/body
    :caster/id
    :world/id
    :progression/mastery
    :rng/seed]
  :prerequisites [{:skill-id :jet-engine
      :min-exp 0.3}]
  :tunables {:seek-range {:curve :mastery-lerp}
    :max-hold-ticks {:curve :mastery-lerp
      :type :long}
    :max-balls {:curve :const
      :type :long}
    :spawn-interval-ticks {:curve :const
      :type :long}
    :fire-interval-ticks {:curve :const
      :type :long}
    :damage {:curve :mastery-lerp}
    :cost-down-overload {:curve :const}
    :cost-attack-cp {:curve :mastery-lerp}
    :cost-attack-overload {:curve :mastery-lerp}
    :cost-tick-cp {:curve :mastery-lerp}
    :cooldown-ticks {:curve :const
      :type :long}
    :exp-hit {:curve :const}}
  :costs {:activate {:resources {:overload {:tunable :cost-down-overload}}}
    :charging {:resources {:cp {:tunable :cost-tick-cp}}}}
  :progression {:hit {:per-mark {:tunable :exp-hit}}}
  :cooldown {:main {:ticks {:tunable :cooldown-ticks}}}
  :session-state {:ticks {:type :long
      :default 0}
    :balls {:type :long
      :default 0}
    :next-spawn-tick {:type :long
      :default 0}
    :next-fire-tick {:type :long
      :default 0}
    :overload-floor {:type :double
      :default 0.0}}
  :program {:component :flow/phases
    :start {:component :flow/sequence
      :steps [{:component :ability/caster
          :bind {:id :owner-id
            :body :body
            :world-id :wid}}
        {:component :ability/budget
          :name :activate
          :bind {:budget :activate-budget}}
        {:component :ability/tunable
          :name :fire-interval-ticks
          :bind {:value :fire-interval-ticks}}
        {:component :ability/tunable
          :name :cost-down-overload
          :bind {:value :cost-down-overload}}
        {:component :ability/context
          :name :resources
          :bind {:value :context-resources}}
        {:component :cost/spend
          :budget {:ref [:local
              :activate-budget]}
          :bind {:insufficient? :insufficient?}}
        {:component :flow/branch
          :when {:ref [:local
              :insufficient?]}
          :then {:component :flow/finish
            :outcome :insufficient-resource
            :finish-session? true}
          :else {:component :flow/sequence
            :steps [{:component :session/write
                :key :ticks
                :value 0}
              {:component :session/write
                :key :balls
                :value 0}
              {:component :session/write
                :key :next-spawn-tick
                :value 0}
              {:component :session/write
                :key :next-fire-tick
                :value {:ref [:local
                    :fire-interval-ticks]}}
              {:component :session/write
                :key :overload-floor
                :value {:expr :math/sub
                  :args [{:ref [:local
                        :context-resources
                        :overload]}
                    {:ref [:local
                        :cost-down-overload]}]}}
              {:component :effect/vfx
                :effect-id :particle-session
                :operation :spawn
                :instance-key [:activation
                  :electron-missile-charge]
                :payload {:position {:ref [:local
                      :body]}
                  :rate-per-tick 2
                  :limit 256
                  :particle {:material :additive
                    :texture "academy:textures/effects/md_particle.png"
                    :life-ticks 10
                    :speed 1.0
                    :spread {:x 0.5
                      :y 0.8
                      :z 0.5}
                    :velocity {:x 0.02
                      :y 0.03
                      :z 0.02}}}
                :audience {:type :nearby
                  :radius 32.0}}
              {:component :effect/vfx
                :effect-id :audio-one-shot
                :operation :spawn
                :payload {:position {:ref [:local
                      :body]}
                  :sound-id "academy:md.em_start"
                  :volume 0.5
                  :pitch 1.0}
                :audience {:type :nearby
                  :radius 32.0}}
              {:component :flow/finish
                :outcome :started}]}}]}
    :pulse {:component :flow/sequence
      :steps [{:component :ability/caster
          :bind {:id :owner-id
            :body :body
            :world-id :wid}}
        {:component :session/read
          :key :overload-floor
          :bind {:value :overload-floor}}
        {:component :ability/budget
          :name :charging
          :bind {:budget :charging-budget}}
        {:component :resource/enforce-floor
          :resource :overload
          :minimum {:ref [:local
              :overload-floor]}}
        {:component :cost/spend
          :budget {:ref [:local
              :charging-budget]}
          :bind {:insufficient? :charging-insufficient?}}
        {:component :flow/branch
          :when {:ref [:local
              :charging-insufficient?]}
          :then {:component :flow/sequence
            :steps [{:component :ability/caster
                :bind {:id :owner-id
                  :body :body
                  :world-id :wid}}
              {:component :ability/tunable
                :name :max-balls
                :bind {:value :max-balls}}
              {:component :ability/cooldown
                :name :main
                :bind {:cooldown :main-cooldown}}
              {:component :target/entities
                :shape {:type :sphere
                  :center {:ref [:local
                      :body]}
                  :radius 4.0}
                :filter {:entity-types ["academy:entity_md_ball"]
                  :owner-id {:ref [:local
                      :owner-id]}}
                :projection [:id
                  :type
                  :position
                  :owner-id]
                :limit {:ref [:local
                    :max-balls]}
                :bind {:entities :remaining-balls}}
              {:component :flow/foreach
                :items {:ref [:local
                    :remaining-balls]}
                :as :ball
                :limit {:ref [:local
                    :max-balls]}
                :body {:component :entity/discard
                  :entity {:ref [:local
                      :ball]}}}
              {:component :effect/vfx
                :effect-id :particle-session
                :operation :destroy
                :instance-key [:activation
                  :electron-missile-charge]
                :payload {}}
              {:component :cooldown/start
                :name :main
                :cooldown {:ref [:local
                    :main-cooldown]}}
              {:component :flow/finish
                :outcome :insufficient-resource
                :finish-session? true}]}
          :else {:component :flow/sequence
            :steps [{:component :effect/vfx
                :effect-id :particle-session
                :operation :update
                :instance-key [:activation
                  :electron-missile-charge]
                :payload {:position {:ref [:local
                      :body]}}}
              {:component :ability/tunable
                :name :max-hold-ticks
                :bind {:value :max-hold-ticks}}
              {:component :session/read
                :key :ticks
                :bind {:value :ticks-check}}
              {:component :flow/branch
                :when {:expr :math/gt
                  :args [{:ref [:local
                        :ticks-check]}
                    {:ref [:local
                        :max-hold-ticks]}]}
                :then {:component :flow/sequence
                  :steps [{:component :ability/caster
                      :bind {:id :owner-id
                        :body :body
                        :world-id :wid}}
                    {:component :ability/tunable
                      :name :max-balls
                      :bind {:value :max-balls}}
                    {:component :ability/cooldown
                      :name :main
                      :bind {:cooldown :main-cooldown}}
                    {:component :target/entities
                      :shape {:type :sphere
                        :center {:ref [:local
                            :body]}
                        :radius 4.0}
                      :filter {:entity-types ["academy:entity_md_ball"]
                        :owner-id {:ref [:local
                            :owner-id]}}
                      :projection [:id
                        :type
                        :position
                        :owner-id]
                      :limit {:ref [:local
                          :max-balls]}
                      :bind {:entities :remaining-balls}}
                    {:component :flow/foreach
                      :items {:ref [:local
                          :remaining-balls]}
                      :as :ball
                      :limit {:ref [:local
                          :max-balls]}
                      :body {:component :entity/discard
                        :entity {:ref [:local
                            :ball]}}}
                    {:component :effect/vfx
                      :effect-id :particle-session
                      :operation :destroy
                      :instance-key [:activation
                        :electron-missile-charge]
                      :payload {}}
                    {:component :cooldown/start
                      :name :main
                      :cooldown {:ref [:local
                          :main-cooldown]}}
                    {:component :flow/finish
                      :outcome :timeout
                      :finish-session? true}]}
                :else {:component :flow/sequence
                  :steps [{:component :ability/tunable
                      :name :max-balls
                      :bind {:value :max-balls}}
                    {:component :ability/tunable
                      :name :seek-range
                      :bind {:value :seek-range}}
                    {:component :ability/tunable
                      :name :spawn-interval-ticks
                      :bind {:value :spawn-interval-ticks}}
                    {:component :ability/tunable
                      :name :fire-interval-ticks
                      :bind {:value :fire-interval-ticks}}
                    {:component :ability/tunable
                      :name :damage
                      :bind {:value :damage}}
                    {:component :ability/tunable
                      :name :cost-attack-cp
                      :bind {:value :cost-attack-cp}}
                    {:component :ability/tunable
                      :name :cost-attack-overload
                      :bind {:value :cost-attack-overload}}
                    {:component :ability/progression
                      :name :hit
                      :bind {:progression :hit-progression}}
                    {:component :session/read
                      :key :ticks
                      :bind {:value :ticks}}
                    {:component :session/read
                      :key :balls
                      :bind {:value :balls}}
                    {:component :session/read
                      :key :next-spawn-tick
                      :bind {:value :next-spawn-tick}}
                    {:component :session/read
                      :key :next-fire-tick
                      :bind {:value :next-fire-tick}}
                    {:component :target/entities
                      :shape {:type :sphere
                        :center {:ref [:local
                            :body]}
                        :radius 4.0}
                      :filter {:entity-types ["academy:entity_md_ball"]
                        :owner-id {:ref [:local
                            :owner-id]}}
                      :projection [:id
                        :type
                        :position
                        :owner-id]
                      :limit {:ref [:local
                          :max-balls]}
                      :bind {:entities :balls-list}}
                    {:component :target/entities
                      :shape {:type :sphere
                        :center {:ref [:local
                            :body]}
                        :radius {:ref [:local
                            :seek-range]}}
                      :filter {:living? true}
                      :projection [:id
                        :type
                        :position
                        :eye-height
                        :living?]
                      :sort [{:by :distance-squared
                          :order :ascending}]
                      :limit 1
                      :bind {:entities :targets}}
                    {:component :data/bind
                      :to :balls-out
                      :value {:ref [:local
                          :balls]}}
                    {:component :data/bind
                      :to :next-spawn-tick-out
                      :value {:ref [:local
                          :next-spawn-tick]}}
                    {:component :flow/branch
                      :when {:expr :math/gte
                        :args [{:ref [:local
                              :ticks]}
                          {:ref [:local
                              :next-spawn-tick]}]}
                      :then {:component :flow/sequence
                        :steps [{:component :flow/branch
                            :when {:expr :math/lt
                              :args [{:ref [:local
                                    :balls]}
                                {:ref [:local
                                    :max-balls]}]}
                            :then {:component :entity/spawn
                              :owner {:ref [:local
                                  :owner-id]}
                              :entity-type "academy:entity_md_ball"
                              :position {:ref [:local
                                  :body]}
                              :velocity {:vec3 [0.0
                                  0.0
                                  0.0]}
                              :life-ticks 400}}
                          {:component :data/bind
                            :to :next-spawn-tick-out
                            :value {:expr :math/add
                              :args [{:ref [:local
                                    :next-spawn-tick]}
                                {:ref [:local
                                    :spawn-interval-ticks]}]}}
                          {:component :session/write
                            :key :next-spawn-tick
                            :value {:ref [:local
                                :next-spawn-tick-out]}}
                          {:component :data/bind
                            :to :balls-delta
                            :value {:expr :math/select
                              :args [{:expr :math/lt
                                  :args [{:ref [:local
                                        :balls]}
                                    {:ref [:local
                                        :max-balls]}]}
                                1.0
                                0.0]}}
                          {:component :data/bind
                            :to :balls-out
                            :value {:expr :math/add
                              :args [{:ref [:local
                                    :balls]}
                                {:ref [:local
                                    :balls-delta]}]}}
                          {:component :session/write
                            :key :balls
                            :value {:ref [:local
                                :balls-out]}}]}}
                    {:component :flow/branch
                      :when {:expr :bool/and
                        :args [{:expr :math/gte
                            :args [{:ref [:local
                                  :ticks]}
                              {:ref [:local
                                  :next-fire-tick]}]}
                          {:expr :collection/nonempty
                            :args [{:ref [:local
                                  :balls-list]}]}
                          {:expr :collection/nonempty
                            :args [{:ref [:local
                                  :targets]}]}]}
                      :then {:component :flow/sequence
                        :steps [{:component :cost/spend
                            :budget {:resources {:cp {:ref [:local
                                    :cost-attack-cp]}
                                :overload {:ref [:local
                                    :cost-attack-overload]}}}
                            :bind {:insufficient? :attack-insufficient?}}
                          {:component :flow/branch
                            :when {:expr :bool/not
                              :args [{:ref [:local
                                    :attack-insufficient?]}]}
                            :then {:component :flow/sequence
                              :steps [{:component :data/random-item
                                  :items {:ref [:local
                                      :balls-list]}
                                  :bind {:item :ball}}
                                {:component :data/bind
                                  :to :target
                                  :value {:expr :collection/first
                                    :args [{:ref [:local
                                          :targets]}]}}
                                {:component :combat/damage
                                  :target {:ref [:local
                                      :target
                                      :id]}
                                  :amount {:ref [:local
                                      :damage]}
                                  :damage-type :magic
                                  :reset-invulnerable-time? true}
                                {:component :entity/discard
                                  :entity {:ref [:local
                                      :ball]}}
                                {:component :data/bind
                                  :to :balls-after-fire
                                  :value {:expr :math/sub
                                    :args [{:ref [:local
                                          :balls-out]}
                                      1.0]}}
                                {:component :session/write
                                  :key :balls
                                  :value {:ref [:local
                                      :balls-after-fire]}}
                                {:component :score/mark
                                  :progression {:ref [:local
                                      :hit-progression]}}
                                {:component :effect/vfx
                                  :effect-id :beam-fade-audio
                                  :operation :spawn
                                  :payload {:start {:ref [:local
                                        :ball
                                        :position]}
                                    :end {:expr :vec3/add
                                      :args [{:ref [:local
                                            :target
                                            :position]}
                                        {:vec3 [0.0
                                            {:ref [:local
                                                :target
                                                :eye-height]}
                                            0.0]}]}
                                    :duration-ticks 14
                                    :beam-at 0
                                    :grow-ticks 4
                                    :layers [{:shape :tube
                                        :radius 0.045
                                        :color [106
                                          242
                                          106
                                          50]}
                                      {:shape :tube
                                        :radius 0.03
                                        :color [216
                                          248
                                          216
                                          230]}
                                      {:shape :line
                                        :width 0.3
                                        :color [255
                                          255
                                          255
                                          127]}]
                                    :sound-id "academy:md.ray_small"
                                    :sound-volume 0.8
                                    :sound-pitch 1.0
                                    :sound-position {:ref [:local
                                        :ball
                                        :position]}
                                    :fade-at 6
                                    :fade-from-tick 6
                                    :fade-to-tick 14
                                    :fade-from-alpha 1.0
                                    :fade-to-alpha 0.0
                                    :fade-layers []}
                                  :audience {:type :nearby
                                    :radius 64.0}}
                                {:component :data/bind
                                  :to :next-fire-tick-out
                                  :value {:expr :math/add
                                    :args [{:ref [:local
                                          :next-fire-tick]}
                                      {:ref [:local
                                          :fire-interval-ticks]}]}}
                                {:component :session/write
                                  :key :next-fire-tick
                                  :value {:ref [:local
                                      :next-fire-tick-out]}}]}}]}}
                    {:component :data/bind
                      :to :ticks-out
                      :value {:expr :math/add
                        :args [{:ref [:local
                              :ticks]}
                          1]}}
                    {:component :session/write
                      :key :ticks
                      :value {:ref [:local
                          :ticks-out]}}
                    {:component :flow/finish
                      :outcome :continue}]}}]}}]}
    :release {:component :flow/sequence
      :steps [{:component :ability/caster
          :bind {:id :owner-id
            :body :body
            :world-id :wid}}
        {:component :ability/tunable
          :name :max-balls
          :bind {:value :max-balls}}
        {:component :ability/cooldown
          :name :main
          :bind {:cooldown :main-cooldown}}
        {:component :target/entities
          :shape {:type :sphere
            :center {:ref [:local
                :body]}
            :radius 4.0}
          :filter {:entity-types ["academy:entity_md_ball"]
            :owner-id {:ref [:local
                :owner-id]}}
          :projection [:id
            :type
            :position
            :owner-id]
          :limit {:ref [:local
              :max-balls]}
          :bind {:entities :remaining-balls}}
        {:component :flow/foreach
          :items {:ref [:local
              :remaining-balls]}
          :as :ball
          :limit {:ref [:local
              :max-balls]}
          :body {:component :entity/discard
            :entity {:ref [:local
                :ball]}}}
        {:component :effect/vfx
          :effect-id :particle-session
          :operation :destroy
          :instance-key [:activation
            :electron-missile-charge]
          :payload {}}
        {:component :cooldown/start
          :name :main
          :cooldown {:ref [:local
              :main-cooldown]}}
        {:component :flow/finish
          :outcome :released
          :finish-session? true}]}
    :abort {:component :flow/sequence
      :steps [{:component :ability/caster
          :bind {:id :owner-id
            :body :body
            :world-id :wid}}
        {:component :ability/tunable
          :name :max-balls
          :bind {:value :max-balls}}
        {:component :ability/cooldown
          :name :main
          :bind {:cooldown :main-cooldown}}
        {:component :target/entities
          :shape {:type :sphere
            :center {:ref [:local
                :body]}
            :radius 4.0}
          :filter {:entity-types ["academy:entity_md_ball"]
            :owner-id {:ref [:local
                :owner-id]}}
          :projection [:id
            :type
            :position
            :owner-id]
          :limit {:ref [:local
              :max-balls]}
          :bind {:entities :remaining-balls}}
        {:component :flow/foreach
          :items {:ref [:local
              :remaining-balls]}
          :as :ball
          :limit {:ref [:local
              :max-balls]}
          :body {:component :entity/discard
            :entity {:ref [:local
                :ball]}}}
        {:component :effect/vfx
          :effect-id :particle-session
          :operation :destroy
          :instance-key [:activation
            :electron-missile-charge]
          :payload {}}
        {:component :cooldown/start
          :name :main
          :cooldown {:ref [:local
              :main-cooldown]}}
        {:component :flow/finish
          :outcome :aborted
          :finish-session? true}]}
    :events {}}}

{:schema-version 1
 :kind :ability
 :id :thunder-clap
 :revision 1
 :activation :session
 :parameters
 {:targeting-range {:source :config :path [:thunder-clap :targeting.range]
                    :type :double :snapshot :activation}
  :charge-min {:source :config :path [:thunder-clap :charge.min-ticks]
               :type :long :snapshot :activation}
  :charge-max {:source :config :path [:thunder-clap :charge.max-ticks]
               :type :long :snapshot :activation}
  :cost-down-overload {:source :config :path [:thunder-clap :cost.down.overload]
                       :type [:tuple :double 2] :snapshot :activation}
  :cost-tick-cp {:source :config :path [:thunder-clap :cost.tick.cp]
                 :type [:tuple :double 2] :snapshot :activation}
  :damage {:source :config :path [:thunder-clap :combat.damage]
           :type [:tuple :double 2] :snapshot :activation}
  :overcharge-multiplier {:source :config
                          :path [:thunder-clap :combat.overcharge-multiplier]
                          :type [:tuple :double 2] :snapshot :activation}
  :aoe-radius {:source :config :path [:thunder-clap :combat.aoe-radius]
               :type [:tuple :double 2] :snapshot :activation}
  :cooldown-per-hold {:source :config
                      :path [:thunder-clap :cooldown.ticks-per-hold]
                      :type [:tuple :double 2] :snapshot :activation}
  :exp-use {:source :config :path [:thunder-clap :progression.exp-use]
            :type :double :snapshot :activation}}
 :external-triggers []
 :reactions []
 :vfx-contracts
 {:charge-started {:effect-id :thunder-clap :op :spawn
 :payload {:caster :owner-id :caster-position :vec3 :target :vec3 :ticks :long}}
  :charge-updated {:effect-id :thunder-clap :op :update
                   :payload {:target :vec3 :ticks :long :ratio :double}}
  :charge-performed {:effect-id :thunder-clap :op :update
                     :payload {:target :vec3 :ticks :long :ratio :double}}}
 :program
 {:component :flow/phases
  :start
  {:component :flow/sequence
   :steps
   [{:component :target/raycast
     :origin {:ref [:context :eye-pos]}
     :direction {:ref [:context :look]}
     :distance {:ref [:param :targeting-range]}
     :include-entities? false
     :include-blocks? true
     :result :aim-hit}
    {:component :txn/atomic
     :guards [{:component :guard/resource
               :cost {:overload {:expr :math/lerp
                                  :args [{:ref [:param :cost-down-overload 0]}
                                         {:ref [:param :cost-down-overload 1]}
                                         {:ref [:context :skill-exp]}]}}}]
     :reservations []
     :body {:component :flow/sequence
            :steps [{:component :owner/patch
                     :entries [{:path [:resources :overload]
                                :mode :increment
                                :value {:expr :math/mul
                                        :args [-1.0
                                               {:expr :math/lerp
                                                :args [{:ref [:param :cost-down-overload 0]}
                                                       {:ref [:param :cost-down-overload 1]}
                                                       {:ref [:context :skill-exp]}]}]}}]}
                    {:component :effect/vfx
                     :effect-id :thunder-clap
                     :operation :spawn
                     :instance-key [:activation :thunder-clap]
                     :audience {:type :nearby :radius 64.0}
                     :payload {:caster {:ref [:context :owner]}
                               :caster-position {:ref [:context :eye-pos]}
                               :target {:ref [:slot :aim-hit :position]}
                               :ticks 0}}]}
     :on-success {:component :flow/finish :outcome :started}
     :on-fail {:component :flow/finish
               :outcome :insufficient-resource
               :finish-session? true}}]}
  :pulse
  {:component :flow/branch
   :when {:expr :math/gte
          :args [{:ref [:context :hold-ticks]}
                 {:ref [:param :charge-max]}]}
   :then {:component :flow/sequence
          :steps [{:component :data/bind
                   :to :overcharge-ratio
                   :value {:expr :math/clamp
                           :args [{:expr :math/div
                                   :args [{:expr :math/sub
                                           :args [{:ref [:context :hold-ticks]}
                                                  {:ref [:param :charge-min]}]}
                                          {:ref [:param :charge-max]}]}
                                  0.0 1.0]}}
                  {:component :target/raycast
                   :origin {:ref [:context :eye-pos]}
                   :direction {:ref [:context :look]}
                   :distance {:ref [:param :targeting-range]}
                   :include-entities? false
                   :include-blocks? true
                   :result :aim-hit}
                  {:component :combat/area-damage
                   :center {:ref [:slot :aim-hit :position]}
                   :radius {:expr :math/lerp
                            :args [{:ref [:param :aoe-radius 0]}
                                   {:ref [:param :aoe-radius 1]}
                                   {:ref [:context :skill-exp]}]}
                   :filter {}
                   :projection [:id :type :position]
                   :limit 256
                   :damage {:expr :math/mul
                            :args [{:expr :math/lerp
                                    :args [{:ref [:param :damage 0]}
                                           {:ref [:param :damage 1]}
                                           {:ref [:context :skill-exp]}]}
                                   {:expr :math/mul
                                    :args [{:expr :math/lerp
                                            :args [{:ref [:param :overcharge-multiplier 0]}
                                                   {:ref [:param :overcharge-multiplier 1]}
                                                   {:ref [:slot :overcharge-ratio]}]}
                                           {:expr :math/max
                                            :args [0.0
                                                   {:expr :math/sub
                                                    :args [1.0
                                                           {:expr :math/div
                                                            :args [{:expr :vec3/distance
                                                                    :args [{:ref [:slot :area-target :position]}
                                                                           {:ref [:slot :aim-hit :position]}]}
                                                                   {:expr :math/lerp
                                                                    :args [{:ref [:param :aoe-radius 0]}
                                                                           {:ref [:param :aoe-radius 1]}
                                                                           {:ref [:context :skill-exp]}]}]}]}]}]}]}
                   :damage-type :skill
                   :on-impact {:component :flow/sequence :steps []}}
                  {:component :world/lightning
                   :world-id {:ref [:context :world-id]}
                   :position {:ref [:slot :aim-hit :position]}
                   :visual-only? true}
                  {:component :owner/patch
                   :entries [{:path [:ability-data :skill-exps :thunder-clap]
                              :mode :increment
                              :value {:ref [:param :exp-use]}}
                              {:path [:cooldown-data :thunder-clap :main]
                               :mode :assign
                               :value {:expr :math/mul
                                       :args [{:ref [:context :hold-ticks]}
                                              {:expr :math/lerp
                                               :args [{:ref [:param :cooldown-per-hold 0]}
                                                      {:ref [:param :cooldown-per-hold 1]}
                                                      {:ref [:context :skill-exp]}]}]}}]}
                  {:component :effect/vfx
                   :effect-id :thunder-clap
                   :operation :update
                   :payload {:target {:ref [:slot :aim-hit :position]}
                             :ticks {:ref [:context :hold-ticks]}
                              :ratio {:ref [:context :hold-ticks]}}}
                  {:component :effect/vfx
                   :effect-id :thunder-clap
                   :operation :destroy
                   :payload {}}
                  {:component :domain/event
                   :event-type :achievement/trigger
                   :payload {:id "electromaster.thunder_clap"
                             :owner {:ref [:context :owner]}}}
                  {:component :flow/finish :outcome :performed
                   :finish-session? true}]}
   :else {:component :flow/sequence
          :steps [{:component :target/raycast
                   :origin {:ref [:context :eye-pos]}
                   :direction {:ref [:context :look]}
                   :distance {:ref [:param :targeting-range]}
                   :include-entities? false
                   :include-blocks? true
                   :result :aim-hit}
                  {:component :effect/vfx
                   :effect-id :thunder-clap
                   :operation :update
                   :payload {:target {:ref [:slot :aim-hit :position]}
                             :ticks {:ref [:context :hold-ticks]}
                              :ratio {:ref [:context :hold-ticks]}}}
                  {:component :flow/branch
                   :when {:expr :math/lte
                          :args [{:ref [:context :hold-ticks]}
                                 {:ref [:param :charge-min]}]}
                   :then {:component :txn/atomic
                          :guards [{:component :guard/resource
                                    :cost {:cp {:expr :math/lerp
                                                :args [{:ref [:param :cost-tick-cp 0]}
                                                       {:ref [:param :cost-tick-cp 1]}
                                                       {:ref [:context :skill-exp]}]}}}]
                          :reservations []
                          :body {:component :owner/patch
                                 :entries [{:path [:resources :cp]
                                            :mode :increment
                                             :value {:expr :math/mul
                                                     :args [-1.0
                                                            {:expr :math/lerp
                                                             :args [{:ref [:param :cost-tick-cp 0]}
                                                                    {:ref [:param :cost-tick-cp 1]}
                                                                    {:ref [:context :skill-exp]}]}]}}]}
                          :on-success {:component :flow/finish :outcome :continue}
                          :on-fail {:component :flow/sequence
                                    :steps [{:component :effect/vfx
                                             :effect-id :thunder-clap
                                             :operation :destroy
                                             :payload {}}
                                            {:component :flow/finish
                                             :outcome :insufficient-resource
                                             :finish-session? true}]}}
                   :else {:component :flow/finish :outcome :continue}}]}}
  :release
  {:component :flow/sequence
   :steps [{:component :target/raycast
            :origin {:ref [:context :eye-pos]}
            :direction {:ref [:context :look]}
            :distance {:ref [:param :targeting-range]}
            :include-entities? false
            :include-blocks? true
            :result :aim-hit}
           {:component :flow/branch
            :when {:expr :math/gte
                   :args [{:ref [:context :hold-ticks]}
                          {:ref [:param :charge-min]}]}
            :then {:component :flow/sequence
                   :steps [{:component :data/bind
                            :to :overcharge-ratio
                            :value {:expr :math/clamp
                                    :args [{:expr :math/div
                                            :args [{:expr :math/sub
                                                    :args [{:ref [:context :hold-ticks]}
                                                           {:ref [:param :charge-min]}]}
                                                   {:ref [:param :charge-max]}]}
                                           0.0 1.0]}}
                           {:component :combat/area-damage
                            :center {:ref [:slot :aim-hit :position]}
                            :radius {:expr :math/lerp
                                     :args [{:ref [:param :aoe-radius 0]}
                                            {:ref [:param :aoe-radius 1]}
                                            {:ref [:context :skill-exp]}]}
                            :filter {}
                            :projection [:id :type :position]
                            :limit 256
                            :damage {:expr :math/mul
                                     :args [{:expr :math/lerp
                                             :args [{:ref [:param :damage 0]}
                                                    {:ref [:param :damage 1]}
                                                    {:ref [:context :skill-exp]}]}
                                            {:expr :math/mul
                                             :args [{:expr :math/lerp
                                                     :args [{:ref [:param :overcharge-multiplier 0]}
                                                            {:ref [:param :overcharge-multiplier 1]}
                                                            {:ref [:slot :overcharge-ratio]}]}
                                                    {:expr :math/max
                                                     :args [0.0
                                                            {:expr :math/sub
                                                             :args [1.0
                                                                    {:expr :math/div
                                                                     :args [{:expr :vec3/distance
                                                                             :args [{:ref [:slot :area-target :position]}
                                                                                    {:ref [:slot :aim-hit :position]}]}
                                                                            {:expr :math/lerp
                                                                             :args [{:ref [:param :aoe-radius 0]}
                                                                                    {:ref [:param :aoe-radius 1]}
                                                                                    {:ref [:context :skill-exp]}]}]}]}]}]}]}
                            :damage-type :skill
                            :on-impact {:component :flow/sequence :steps []}}
                           {:component :world/lightning
                            :world-id {:ref [:context :world-id]}
                            :position {:ref [:slot :aim-hit :position]}
                            :visual-only? true}
                           {:component :owner/patch
                            :entries [{:path [:ability-data :skill-exps :thunder-clap]
                                       :mode :increment
                                       :value {:ref [:param :exp-use]}}
                                       {:path [:cooldown-data :thunder-clap :main]
                                        :mode :assign
                                        :value {:expr :math/mul
                                                :args [{:ref [:context :hold-ticks]}
                                                       {:expr :math/lerp
                                                        :args [{:ref [:param :cooldown-per-hold 0]}
                                                               {:ref [:param :cooldown-per-hold 1]}
                                                               {:ref [:context :skill-exp]}]}]}}]}
                           {:component :effect/vfx
                            :effect-id :thunder-clap :operation :update
                            :payload {:target {:ref [:slot :aim-hit :position]}
                                      :ticks {:ref [:context :hold-ticks]}
                                      :ratio 1.0}}
                           {:component :effect/vfx
                            :effect-id :thunder-clap :operation :destroy
                            :payload {}}
                           {:component :domain/event
                            :event-type :achievement/trigger
                            :payload {:id "electromaster.thunder_clap"
                                      :owner {:ref [:context :owner]}}}
                           {:component :flow/finish :outcome :performed
                            :finish-session? true}]}
            :else {:component :flow/sequence
                   :steps [{:component :effect/vfx
                            :effect-id :thunder-clap
                            :operation :destroy
                            :payload {}}
                           {:component :flow/finish :outcome :undercharged
                            :finish-session? true}]}}]}
  :abort {:component :flow/sequence
          :steps [{:component :effect/vfx
                   :effect-id :thunder-clap
                   :operation :destroy
                   :payload {}}
                  {:component :flow/finish :outcome :aborted
                   :finish-session? true}]}}}

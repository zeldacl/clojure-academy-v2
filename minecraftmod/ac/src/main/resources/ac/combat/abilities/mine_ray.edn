{:schema-version 2
 :kind :ability
 :id :mine-ray
 :revision 2
 :engine :v3
 :activation :session
 :status :migrated
 :requires [:caster/body :caster/eye :caster/aim :caster/id :caster/creative?
            :world/id :progression/mastery :rng/seed]
 :prerequisites [{:skill-id :meltdowner :min-exp 0.3}]
 :tunables
 {:targeting-range {:curve :const}
  :break-speed {:curve :mastery-lerp}
  :cost-down-overload {:curve :mastery-lerp}
  :cost-tick-cp {:curve :mastery-lerp}
  :cooldown-ticks {:curve :mastery-lerp :type :long}
  :exp-block {:curve :const}}
 :costs
 {:activate {:resources {:overload {:tunable :cost-down-overload}}}
  :tick {:resources {:cp {:tunable :cost-tick-cp}}}}
 :cooldown {:main {:ticks {:tunable :cooldown-ticks}}}
 :progression {:block {:per-mark {:tunable :exp-block}}}
 :session-state
 {:target {:type :any :default nil}
  :hardness-left {:type :double :default nil}
  :starting-hardness {:type :double :default nil}
  :overload-floor {:type :double :default nil}}
 :program
 {:component :flow/phases
  :start
  {:component :flow/sequence
   :steps
   [{:component :ability/caster :bind {:eye :eye :aim :aim :body :body}}
    {:component :ability/budget :name :activate :bind {:budget :activate-budget}}
    {:component :ability/tunable :name :cost-down-overload :bind {:value :cost-down-overload}}
    {:component :ability/context :name :resources :bind {:value :context-resources}}
    {:component :ability/context :name :ability-runtime :bind {:value :runtime}}
    {:component :cost/spend :budget {:ref [:local :activate-budget]} :bind {:insufficient? :insufficient?}}
    {:component :flow/branch
     :when {:ref [:local :insufficient?]}
     :then {:component :flow/finish :outcome :insufficient-resource :finish-session? true}
     :else
     {:component :flow/sequence
      :steps
      [{:component :session/write :key :target :value nil}
       {:component :session/write :key :hardness-left :value 3.4028235E38}
       {:component :session/write :key :starting-hardness :value 3.4028235E38}
       {:component :data/bind
        :to :overload-floor
        :value {:expr :math/sub :args [{:ref [:local :context-resources :overload]} {:ref [:local :cost-down-overload]}]}}
       {:component :session/write :key :overload-floor :value {:ref [:local :overload-floor]}}
       {:component :data/bind
        :to :beam-end
        :value {:expr :vec3/add :args [{:ref [:local :eye]} {:expr :vec3/scale :args [{:ref [:local :aim]} 15.0]}]}}
       {:component :effect/vfx
        :effect-id :beam-session :operation :spawn
        :instance-key [:activation :beam]
        :audience {:type :nearby :radius 32.0}
        :payload {:start {:ref [:local :eye]}
                  :end {:ref [:local :beam-end]}
                  :life-ticks 4096 :grow-ticks 0
                  :style {:ref [:local :runtime :beam-style]}
                  :bounds-radius 0.6}}
       {:component :effect/vfx
        :effect-id :block-progress-session :operation :spawn
        :instance-key [:activation :progress]
        :audience {:type :nearby :radius 32.0}
        :payload {:target nil :progress 0.0
                  :color {:ref [:local :runtime :progress-color]}
                  :pulse-period 0.3}}
       {:component :effect/vfx
        :effect-id :audio-loop-session :operation :spawn
        :instance-key [:activation :loop]
        :audience {:type :nearby :radius 32.0}
        :payload {:position {:ref [:local :body]}
                  :sound-id {:ref [:local :runtime :loop-sound-id]}
                  :volume 0.3 :pitch 1.0}}
       {:component :effect/vfx
        :effect-id :audio-one-shot :operation :spawn
        :audience {:type :nearby :radius 32.0}
        :payload {:position {:ref [:local :body]}
                  :sound-id {:ref [:local :runtime :startup-sound-id]}
                  :volume 0.4 :pitch 1.0}}
       {:component :flow/finish :outcome :started}]}}]}
  :pulse
  {:component :flow/sequence
   :steps
   [{:component :ability/caster :bind {:eye :eye :aim :aim :body :body}}
    {:component :ability/context :name :ability-runtime :bind {:value :runtime}}
    {:component :ability/tunable :name :targeting-range :bind {:value :targeting-range}}
    {:component :ability/tunable :name :break-speed :bind {:value :break-speed}}
    {:component :session/read :key :overload-floor :bind {:value :overload-floor}}
    {:component :resource/enforce-floor :resource :overload :minimum {:ref [:local :overload-floor]}}
    {:component :ability/budget :name :tick :bind {:budget :tick-budget}}
    {:component :cost/spend :budget {:ref [:local :tick-budget]} :bind {:insufficient? :insufficient?}}
    {:component :flow/branch
     :when {:ref [:local :insufficient?]}
     :then
     {:component :flow/sequence
      :steps
      [{:component :effect/vfx :effect-id :beam-session :operation :destroy
        :instance-key [:activation :beam] :payload {:fade-ticks 0}}
       {:component :effect/vfx :effect-id :block-progress-session :operation :destroy
        :instance-key [:activation :progress] :payload {:fade-ticks 0}}
       {:component :effect/vfx :effect-id :audio-loop-session :operation :destroy
        :instance-key [:activation :loop] :payload {:fade-ticks 0}}
       {:component :ability/cooldown :name :main :bind {:cooldown :main-cooldown}}
       {:component :cooldown/start :name :main :cooldown {:ref [:local :main-cooldown]}}
       {:component :flow/finish :outcome :insufficient-resource :finish-session? true}]}
     :else
     {:component :flow/sequence
      :steps
      [{:component :effect/vfx
        :effect-id :beam-session :operation :update
        :instance-key [:activation :beam]
        :payload {:start {:ref [:local :eye]}
                  :end {:expr :vec3/add :args [{:ref [:local :eye]} {:expr :vec3/scale :args [{:ref [:local :aim]} 15.0]}]}
                  :life-ticks 4096 :grow-ticks 0
                  :style {:ref [:local :runtime :beam-style]}
                  :bounds-radius 0.6}}
       {:component :effect/vfx
        :effect-id :audio-loop-session :operation :update
        :instance-key [:activation :loop]
        :payload {:position {:ref [:local :body]}}}
       {:component :target/blocks
        :shape {:type :line :start {:ref [:local :eye]} :direction {:ref [:local :aim]}
                :length {:ref [:local :targeting-range]} :step 0.5}
        :projection [:position :hardness :block-id :breakable? :requires-high-tier-tool?]
        :limit 1
        :bind {:blocks :blocks}}
       {:component :data/bind :to :block :value {:expr :collection/first :args [{:ref [:local :blocks]}]}}
       {:component :session/read :key :target :bind {:value :session-target}}
       {:component :flow/branch
        :when {:expr :collection/nonempty :args [{:ref [:local :blocks]}]}
        :then
        {:component :flow/branch
         :when {:expr :value/eq :args [{:ref [:local :block :position]} {:ref [:local :session-target]}]}
         :then
         {:component :flow/sequence
          :steps
          [{:component :session/read :key :hardness-left :bind {:value :hardness-left}}
           {:component :session/read :key :starting-hardness :bind {:value :starting-hardness}}
           {:component :data/bind
            :to :new-hardness
            :value {:expr :math/sub :args [{:ref [:local :hardness-left]} {:ref [:local :break-speed]}]}}
           {:component :data/bind
            :to :progress
            :value {:expr :math/clamp
                    :args [{:expr :math/sub
                            :args [1.0 {:expr :math/div :args [{:ref [:local :new-hardness]} {:ref [:local :starting-hardness]}]}]}
                           0.0 1.0]}}
           {:component :effect/vfx
            :effect-id :block-progress-session :operation :update
            :instance-key [:activation :progress]
            :payload {:target {:ref [:local :block :position]}
                      :progress {:ref [:local :progress]}
                      :color {:ref [:local :runtime :progress-color]}
                      :pulse-period 0.3}}
           {:component :effect/vfx
            :effect-id :particle-burst :operation :spawn
            :instance-key [:activation :particle]
            :audience {:type :nearby :radius 32.0}
            :payload {:position {:expr :vec3/add :args [{:ref [:local :block :position]} {:vec3 [0.5 0.5 0.5]}]}
                      :rate-per-tick 3 :limit 3
                      :particle {:ref [:local :runtime :particle]}}}
           {:component :flow/branch
            :when {:expr :math/lte :args [{:ref [:local :new-hardness]} 0.0]}
            :then
            {:component :flow/sequence
             :steps
             [{:component :block/break
               :position {:ref [:local :block :position]}
               :expected-block-id {:ref [:local :block :block-id]}
               :drop? true
               :fortune-level {:ref [:local :runtime :fortune-level]}
               :tool-tier-capped? {:ref [:local :runtime :tool-tier-capped?]}}
              {:component :ability/progression :name :block :bind {:progression :block-progression}}
              {:component :score/mark :progression {:ref [:local :block-progression]}}
              {:component :session/write :key :target :value nil}
              {:component :session/write :key :hardness-left :value 3.4028235E38}
              {:component :session/write :key :starting-hardness :value 3.4028235E38}]}
            :else {:component :session/write :key :hardness-left :value {:ref [:local :new-hardness]}}}]}
         :else
         {:component :flow/branch
          :when {:expr :bool/and
                 :args [{:ref [:local :block :breakable?]}
                        {:expr :bool/not
                         :args [{:expr :bool/and
                                 :args [{:ref [:local :runtime :tool-tier-capped?]} {:ref [:local :block :requires-high-tier-tool?]}]}]}]}
          :then
          {:component :flow/sequence
           :steps
           [{:component :session/write :key :target :value {:ref [:local :block :position]}}
            {:component :data/bind
             :to :init-hardness
             :value {:expr :math/select
                     :args [{:expr :math/lt :args [{:ref [:local :block :hardness]} 0.0]} 3.4028235E38 {:ref [:local :block :hardness]}]}}
            {:component :session/write :key :hardness-left :value {:ref [:local :init-hardness]}}
            {:component :session/write :key :starting-hardness :value {:ref [:local :init-hardness]}}]}
          :else
          {:component :flow/sequence
           :steps
           [{:component :session/write :key :target :value nil}
            {:component :session/write :key :hardness-left :value 3.4028235E38}
            {:component :session/write :key :starting-hardness :value 3.4028235E38}]}}}
        :else
        {:component :flow/sequence
         :steps
         [{:component :session/write :key :target :value nil}
          {:component :session/write :key :hardness-left :value 3.4028235E38}
          {:component :session/write :key :starting-hardness :value 3.4028235E38}]}}
       {:component :flow/finish :outcome :continue}]}}]}
  :release
  {:component :flow/sequence
   :steps
   [{:component :effect/vfx :effect-id :beam-session :operation :destroy
     :instance-key [:activation :beam] :payload {:fade-ticks 0}}
    {:component :effect/vfx :effect-id :block-progress-session :operation :destroy
     :instance-key [:activation :progress] :payload {:fade-ticks 0}}
    {:component :effect/vfx :effect-id :audio-loop-session :operation :destroy
     :instance-key [:activation :loop] :payload {:fade-ticks 0}}
    {:component :ability/cooldown :name :main :bind {:cooldown :main-cooldown}}
    {:component :cooldown/start :name :main :cooldown {:ref [:local :main-cooldown]}}
    {:component :flow/finish :outcome :released :finish-session? true}]}
  :abort
  {:component :flow/sequence
   :steps
   [{:component :effect/vfx :effect-id :beam-session :operation :destroy
     :instance-key [:activation :beam] :payload {:fade-ticks 0}}
    {:component :effect/vfx :effect-id :block-progress-session :operation :destroy
     :instance-key [:activation :progress] :payload {:fade-ticks 0}}
    {:component :effect/vfx :effect-id :audio-loop-session :operation :destroy
     :instance-key [:activation :loop] :payload {:fade-ticks 0}}
    {:component :ability/cooldown :name :main :bind {:cooldown :main-cooldown}}
    {:component :cooldown/start :name :main :cooldown {:ref [:local :main-cooldown]}}
    {:component :flow/finish :outcome :aborted :finish-session? true}]}
  :events {}}}

{:schema-version 2
 :kind :ability
 :id :vec-reflection
 :revision 2
 :activation :toggle
 :status :migrated
 :requires [:caster/eye :caster/aim]
 ;; The damage :reactions block below is a separate subsystem
 ;; (combat_runtime's apply-edn-damage-reactions) not yet folded into the
 ;; :costs/:progression policy evaluator -- deferred to the plan's Phase 6.
 ;; It still reads these 5 fields through the legacy :parameters/:param path.
 :parameters
 {:damage-multiplier {:type [:tuple :double 2] :snapshot :activation}
  :min-reflected-damage {:type :double :snapshot :activation}
  :damage-cp {:type [:tuple :double 2] :snapshot :activation}
  :exp-damage-scale {:type :double :snapshot :activation}
  :max-reflections {:type :long :snapshot :activation}}
 :tunables
 {:tick-cp {:curve :mastery-lerp}
  :overload-keep {:curve :mastery-lerp}
  :target-radius {:curve :const}
  :affected-entity-difficulty {:curve :const :type :string-list}
  :excluded-entity-ids {:curve :const :type :string-list}
  :large-fireball-ids {:curve :const :type :string-list}
  :reflect-entity-cp {:curve :mastery-lerp}
  :exp-reflect-entity-scale {:curve :const}}
 :costs
 {:activate {:resources {:overload {:tunable :overload-keep}}}
  :per-tick {:resources {:cp {:tunable :tick-cp}}}
  :per-reflect {:resources {:cp {:tunable :reflect-entity-cp}}}}
 :invariants {:overload-floor {:tunable :overload-keep}}
 :progression {:reflect-entity {:per-mark {:tunable :exp-reflect-entity-scale}}}
 :reactions
 [{:on :combat/damage
   :priority 60
   :when {:expr :bool/and
          :args [{:ref [:context :enabled?]}
                 {:expr :math/gt
                  :args [{:ref [:request :base]} 0.0]}]}
   :program {:component :damage/reflect
             :multiplier {:expr :math/lerp
                          :args [{:ref [:param :damage-multiplier 0]}
                                 {:ref [:param :damage-multiplier 1]}
                                 {:ref [:context :skill-exp]}]}
             :cost-per-damage {:expr :math/lerp
                               :args [{:ref [:param :damage-cp 0]}
                                      {:ref [:param :damage-cp 1]}
                                      {:ref [:context :skill-exp]}]}
             :minimum {:ref [:param :min-reflected-damage]}
             :max-depth {:ref [:param :max-reflections]}
             :exp-scale {:ref [:param :exp-damage-scale]}}}]
 :vfx
 {:reflection-start {:effect-id :ring-particle-field :op :spawn
                     :payload {:position :vec3 :ring-from :double
                               :ring-to :double :segments :long
                               :ring-color :object :rate-per-tick :long
                               :limit :long :particle :object}}
  :projectile-reflected {:effect-id :ring-fade-audio :op :spawn
                         :payload {:position :vec3 :duration-ticks :long
                                   :ring-from :double :ring-to :double
                                   :ring-segments :long :ring-color :object
                                   :fade-at :long :fade-to-tick :long
                                   :fade-ring-from :double :fade-ring-to :double
                                   :fade-segments :long :fade-color :object
                                   :sound-id :string :sound-volume :double
                                   :sound-pitch :double}}
  :damage-reflected {:effect-id :ring-fade-audio :op :spawn
                     :payload {:position :vec3 :duration-ticks :long
                               :ring-from :double :ring-to :double
                               :ring-segments :long :ring-color :object
                               :fade-at :long :fade-to-tick :long
                               :fade-ring-from :double :fade-ring-to :double
                               :fade-segments :long :fade-color :object
                               :sound-id :string :sound-volume :double
                               :sound-pitch :double}}}
 :program
 {:component :flow/phases
  :start
  {:component :flow/sequence
   :steps [{:component :cost/spend
            :budget :activate
            :on-insufficient {:component :flow/finish :outcome :insufficient-resource
                              :finish-session? true}}
           {:component :effect/vfx
            :effect-id :ring-particle-field
            :operation :spawn
            :instance-key [:activation :vec-reflection]
            :audience {:type :nearby :radius 64.0}
            :payload {:position {:from :caster/eye}
                      :ring-from 0.45 :ring-to 0.9 :segments 20
                      :ring-color [188 252 238 150]
                      :rate-per-tick 2 :limit 128
                      :particle {:material :additive
                                 :life-ticks 12 :speed 0.04}}}
           {:component :flow/finish :outcome :started}]}
  :pulse
  {:component :flow/sequence
   :steps [{:component :cost/spend
            :budget :per-tick
            :on-insufficient {:component :flow/sequence
                              :steps [{:component :effect/vfx
                                       :effect-id :ring-particle-field
                                       :operation :destroy
                                       :instance-key [:activation :vec-reflection]
                                       :payload {}}
                                      {:component :flow/finish :outcome :insufficient-resource
                                       :finish-session? true}]}}
           {:component :resource/enforce-floor
            :resource :overload
            :minimum {:invariant :overload-floor}}
           {:component :target/raycast
            :origin {:from :caster/eye} :direction {:from :caster/aim}
            :distance 20.0
            :include-entities? true :include-blocks? true
            :result :aim-point}
           {:component :combat/projectile-reflection-scan
            :center {:from :caster/eye}
            :radius {:tunable :target-radius}
            :difficulty-entries {:tunable :affected-entity-difficulty}
            :excluded-entity-ids {:tunable :excluded-entity-ids}
            :limit 64
            :body {:component :flow/once
                   :scope :owner
                   :storage-path [:visited-projectiles]
                   :strategy :last-key
                   :key {:ref [:slot :projectile :id]}
                   ;; No :else / :on-duplicate result: a non-reflectable or
                   ;; already-seen projectile simply produces nil, which
                   ;; :flow/foreach (in combat/projectile-reflection-scan's
                   ;; body) reads as "move on to the next one" -- not a
                   ;; :flow/finish, which would end the whole activation
                   ;; over a single skipped projectile.
                   :on-first {:component :flow/branch
                              :when {:expr :math/gt
                                     :args [{:ref [:slot :projectile :difficulty]} 0.0]}
                              :then {:component :flow/sequence
                                     :steps [{:component :cost/spend
                                              :budget :per-reflect
                                              :scale {:ref [:slot :projectile :difficulty]}
                                              :on-insufficient
                                              {:component :flow/control :signal :skip-item}}
                                             {:component :projectile/redirect
                                              :entity {:ref [:slot :projectile]}
                                              :target-position {:ref [:slot :aim-point :position]}
                                              :velocity {:ref [:slot :projectile :velocity]}
                                              :difficulty {:ref [:slot :projectile :difficulty]}
                                              :replacement-types {:tunable :large-fireball-ids}}
                                             {:component :score/mark
                                              :tag :reflect-entity
                                              :weight {:ref [:slot :projectile :difficulty]}}
                                             {:component :effect/vfx
                                              :effect-id :ring-fade-audio
                                              :operation :spawn
                                              :instance-key [:projectile {:ref [:slot :projectile :id]}]
                                              :payload {:position {:ref [:slot :projectile :position]}
                                                        :duration-ticks 12 :ring-from 0.15 :ring-to 1.1
                                                        :ring-segments 16 :ring-color [236 170 93 180]
                                                        :fade-at 6 :fade-to-tick 12
                                                        :fade-ring-from 1.1 :fade-ring-to 1.3
                                                        :fade-segments 16
                                                        :fade-color [188 252 238 130]
                                                        :sound-id "academy:vecmanip.vec_reflection"
                                                        :sound-volume 0.5 :sound-pitch 1.0}}]}}}}
           {:component :flow/finish :outcome :continue}]}
  :release
  {:component :flow/sequence
   :steps [{:component :effect/vfx
            :effect-id :ring-particle-field
            :operation :destroy
            :instance-key [:activation :vec-reflection]
            :payload {}}
           {:component :flow/finish :outcome :released
            :finish-session? true}]}
  :abort
  {:component :flow/sequence
   :steps [{:component :effect/vfx
            :effect-id :ring-particle-field
            :operation :destroy
            :instance-key [:activation :vec-reflection]
            :payload {}}
           {:component :flow/finish :outcome :aborted
            :finish-session? true}]}}}

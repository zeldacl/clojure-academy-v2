{:schema-version 2
 :kind :ability
 :id :meltdowner
 :revision 1
 :activation :session
 :status :migrated
 :requires [:caster/body :caster/eye :caster/aim :caster/id :caster/creative?
            :world/id :progression/mastery :rng/seed]
 :prerequisites [{:skill-id :scatter-bomb :min-exp 0.8}
                 {:skill-id :light-shield :min-exp 0.8}]
 :tunables
 {:charge-min-ticks {:curve :const :type :long}
  :charge-max-ticks {:curve :const :type :long}
  :charge-max-tolerant-ticks {:curve :const :type :long}
  :charge-time-rate {:curve :pair}
  :beam-radius {:curve :mastery-lerp}
  :beam-query-radius {:curve :const}
  :beam-step {:curve :const}
  :beam-max-distance {:curve :const}
  :beam-visual-distance {:curve :const}
  :beam-damage {:curve :mastery-lerp}
  :beam-block-energy {:curve :mastery-lerp}
  :reflection-shot-distance {:curve :const}
  :reflection-damage-multiplier {:curve :const}
  :reflection-base-damage {:curve :mastery-lerp}
  :cost-down-overload {:curve :mastery-lerp}
  :cost-tick-cp {:curve :mastery-lerp}
  :cooldown-base-multiplier {:curve :const}
  :cooldown-ticks {:curve :mastery-lerp}
  :exp-use {:curve :const}}
 :costs
 {:activate {:resources {:overload {:tunable :cost-down-overload}}}
  :tick {:resources {:cp {:tunable :cost-tick-cp}}}}
 :cooldown
 {:main {:ticks {:expr :math/mul
                  :args [{:ref [:session :time-rate]}
                         {:tunable :cooldown-base-multiplier}
                         {:tunable :cooldown-ticks}]}}}
 :progression {:use {:per-mark {:tunable :exp-use}
                      :weight {:ref [:session :time-rate]}}}
 :vfx
 {:charge-audio {:effect-id :audio-loop-session :op :spawn
                 :payload {:position :vec3 :sound-id :string
                           :volume :double :pitch :double}}
  :charge-particles {:effect-id :particle-session :op :spawn
                     :payload {:position :vec3 :rate-per-tick :long
                               :limit :long :particle :object}}
  :beam-fired {:effect-id :beam-arc-fade :op :spawn
               :payload {:start :vec3 :end :vec3 :duration-ticks :long
                         :beam-at :long :grow-ticks :long :layers :object
                         :arc-at :long :arc-spacing :object :arc-radius :object
                         :arc-count-limit :long :arc-life-ticks :long
                         :fade-at :long :fade-from-tick :long :fade-to-tick :long
                         :fade-from-alpha :double :fade-to-alpha :double
                         :ring-radius :object :ring-segments :long
                         :ring-color :object}}
  :reflected-beam {:effect-id :ray-beam-transient :op :spawn
                   :payload {:start :vec3 :end :vec3 :life-ticks :long
                             :grow-ticks :long :style :object :bounds-radius :double}}}
 :fragments
 {:stop-vfx
  {:inputs {}
   :body {:component :flow/sequence
          :steps [{:component :effect/vfx :effect-id :audio-loop-session
                   :operation :destroy :instance-key [:activation :meltdowner-audio]
                   :payload {:fade-ticks 0}}
                  {:component :effect/vfx :effect-id :particle-session
                   :operation :destroy :instance-key [:activation :meltdowner-particles]
                   :payload {}}]}}
  :finish
  {:inputs {:performed? :boolean}
   :body {:component :flow/sequence
          :steps [{:component :stop-vfx}
                  {:component :flow/branch
                   :when {:ref [:input :performed?]}
                   :then {:component :flow/sequence
                          :steps [{:component :cooldown/start :name :main}
                                  {:component :score/mark :tag :use
                                   :weight {:ref [:session :time-rate]}}]}
                   :else nil}]}}}
 :program
 {:component :flow/phases
  :start {:component :flow/sequence
          :steps [{:component :cost/spend :budget :activate
                   :on-insufficient {:component :flow/finish
                                     :outcome :insufficient-resource
                                     :finish-session? true}}
                  {:component :session/patch
                   :entries [{:path [:hold-ticks] :mode :assign :value 0}
                             {:path [:time-rate] :mode :assign :value 0.8}
                             {:path [:overload-floor] :mode :assign
                              :value {:expr :math/sub
                                      :args [{:ref [:context :resources :overload]}
                                             {:tunable :cost-down-overload}]}}]}
                  {:component :effect/vfx :effect-id :audio-loop-session
                   :operation :spawn :instance-key [:activation :meltdowner-audio]
                   :audience {:type :owner}
                   :payload {:position {:from :caster/body}
                             :sound-id "academy:md.md_charge"
                             :volume 0.5 :pitch 1.0}}
                  {:component :effect/vfx :effect-id :particle-session
                   :operation :spawn :instance-key [:activation :meltdowner-particles]
                   :audience {:type :nearby :radius 32.0}
                   :payload {:position {:from :caster/body} :rate-per-tick 4
                             :limit 256
                             :particle {:material :additive :life-ticks 10 :speed 0.04
                                        :color [106 242 106 150]
                                        :spread {:x 0.7 :y 0.7 :z 0.7}}}}
                  {:component :flow/finish :outcome :started}]}
  :pulse {:component :flow/sequence
          :steps [{:component :resource/enforce-floor :resource :overload
                   :minimum {:ref [:session :overload-floor]}}
                  {:component :cost/spend :budget :tick
                   :on-insufficient {:component :flow/sequence
                                     :steps [{:component :stop-vfx}
                                             {:component :flow/finish
                                              :outcome :insufficient-resource
                                              :finish-session? true}]}}
                  {:component :session/patch
                   :entries [{:path [:hold-ticks] :mode :increment :value 1}
                             {:path [:time-rate] :mode :assign
                              :value {:expr :math/lerp
                                      :args [{:tunable :charge-time-rate :path [0]}
                                             {:tunable :charge-time-rate :path [1]}
                                             {:expr :math/clamp
                                              :args [{:expr :math/div
                                                      :args [{:expr :math/sub
                                                              :args [{:ref [:session :hold-ticks]}
                                                                     {:tunable :charge-min-ticks}]}
                                                             {:expr :math/sub
                                                              :args [{:tunable :charge-max-ticks}
                                                                     {:tunable :charge-min-ticks}]}]}
                                                     0.0 1.0]}]}}]}
                  {:component :effect/vfx :effect-id :audio-loop-session
                   :operation :update :instance-key [:activation :meltdowner-audio]
                   :payload {:position {:from :caster/body}}}
                  {:component :effect/vfx :effect-id :particle-session
                   :operation :update :instance-key [:activation :meltdowner-particles]
                   :payload {:position {:from :caster/body}}}
                  {:component :flow/branch
                   :when {:expr :math/gt
                          :args [{:ref [:session :hold-ticks]}
                                 {:tunable :charge-max-tolerant-ticks}]}
                   :then {:component :flow/sequence
                          :steps [{:component :stop-vfx}
                                  {:component :flow/finish :outcome :overcharged
                                   :finish-session? true}]}
                   :else {:component :flow/finish :outcome :continue}}]}
  :release {:component :flow/branch
            :when {:expr :math/lt
                   :args [{:ref [:session :hold-ticks]}
                          {:tunable :charge-min-ticks}]}
            :then {:component :flow/sequence
                   :steps [{:component :stop-vfx}
                           {:component :flow/finish :outcome :undercharged
                            :finish-session? true}]}
            :else {:component :flow/sequence
                   :steps [{:component :host/beam-trace
                            :origin {:from :caster/eye}
                            :direction {:from :caster/aim}
                            :length {:tunable :beam-max-distance}
                            :visual-length {:tunable :beam-visual-distance}
                            :radius {:tunable :beam-radius}
                            :query-radius {:tunable :beam-query-radius}
                            :step {:tunable :beam-step}
                            :damage {:expr :math/mul
                                     :args [{:ref [:session :time-rate]}
                                            {:tunable :beam-damage}]}
                            :damage-type :magic :entity-limit 256
                            :reflection-policy {:shot-distance {:tunable :reflection-shot-distance}
                                                :damage-multiplier {:tunable :reflection-damage-multiplier}
                                                :reflection-base-damage {:tunable :reflection-base-damage}}
                            :block-policy {:component :block/break-budget
                                           :blocks []
                                           :energy {:expr :math/mul
                                                    :args [{:ref [:session :time-rate]}
                                                           {:tunable :beam-block-energy}]}
                                           :step {:tunable :beam-step}
                                           :drop-chance 0.05
                                           :neighbor-break-chance 0.05
                                           :limit 4096}
                            :result :beam-result}
                           {:component :flow/foreach
                            :items {:ref [:slot :beam-result :entities]}
                            :as :target :limit 256
                            :body {:component :flow/branch
                                   :when {:ref [:slot :target :reflection-accepted?]}
                                   :then {:component :flow/sequence
                                          :steps [{:component :combat/damage
                                                   :target {:ref [:slot :target :reflection-target]}
                                                   :amount {:ref [:slot :target :reflection-damage]}
                                                   :damage-type :magic}
                                                  {:component :effect/vfx
                                                   :effect-id :ray-beam-transient
                                                   :operation :spawn
                                                   :instance-key [:activation :meltdowner-reflected]
                                                   :audience {:type :nearby :radius 64.0}
                                                   :payload {:start {:ref [:slot :target :reflection-start]}
                                                             :end {:ref [:slot :target :reflection-end]}
                                                             :life-ticks 50 :grow-ticks 3
                                                             :style {:layers [{:shape :tube :radius 0.17
                                                                               :color [106 242 106 180]}]}
                                                             :bounds-radius 0.4}}]}
                                   :else {:component :combat/damage
                                          :target {:ref [:slot :target :id]}
                                          :amount {:ref [:slot :target :damage]}
                                          :damage-type :magic}}}
                           {:component :block/break-budget
                            :blocks {:ref [:slot :beam-result :blocks]}
                            :energy {:expr :math/mul
                                     :args [{:ref [:session :time-rate]}
                                            {:tunable :beam-block-energy}]}
                            :step {:tunable :beam-step} :limit 4096
                            :drop-chance 0.05 :neighbor-break-chance 0.05
                            :seed {:from :rng/seed}}
                           {:component :effect/vfx :effect-id :beam-arc-fade
                            :operation :spawn :instance-key [:activation :meltdowner-beam]
                            :audience {:type :nearby :radius 64.0}
                            :payload {:start {:ref [:slot :beam-result :start]}
                                      :end {:ref [:slot :beam-result :end]}
                                      :duration-ticks 50 :beam-at 0 :grow-ticks 4
                                      :layers [{:shape :tube :radius 0.22 :color [106 242 106 50]}
                                               {:shape :tube :radius 0.17 :color [216 248 216 230]}
                                               {:shape :line :width 0.02 :color [180 255 180 180]}]
                                      :arc-at 3 :arc-spacing {:min 1.0 :max 2.0}
                                      :arc-radius {:min 0.1 :max 0.25}
                                      :arc-count-limit 64 :arc-life-ticks 30
                                      :fade-at 30 :fade-from-tick 30 :fade-to-tick 50
                                      :fade-from-alpha 1.0 :fade-to-alpha 0.0
                                      :ring-radius 0.34 :ring-segments 12
                                      :ring-color [188 252 238 180]}}
                           {:component :effect/vfx :effect-id :audio-one-shot
                            :operation :spawn :instance-key [:activation :meltdowner-shot]
                            :audience {:type :nearby :radius 64.0}
                            :payload {:position {:from :caster/eye}
                                      :sound-id "academy:md.meltdowner"
                                      :volume 0.5 :pitch 1.0}}
                           {:component :cooldown/start :name :main}
                           {:component :score/mark :tag :use
                            :weight {:ref [:session :time-rate]}}
                           {:component :stop-vfx}
                           {:component :flow/finish :outcome :performed
                            :finish-session? true}]}}
  :abort {:component :flow/sequence
          :steps [{:component :stop-vfx}
                  {:component :flow/finish :outcome :aborted
                   :finish-session? true}]}
  :events {}}}

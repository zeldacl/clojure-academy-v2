{:schema-version 2
 :kind :ability
 :id :arc-gen
 :revision 2
 :activation :instant
 :status :migrated
 :requires [:caster/eye :caster/aim :world/id]
 :tunables
 {:damage {:curve :mastery-lerp}
  :max-distance {:curve :mastery-lerp}
  :ignite-probability {:curve :mastery-lerp}
  :fishing-probability {:curve :const}
  :fishing-exp-threshold {:curve :const}
  :creeper-charge-chance {:curve :const}
  :cost-cp {:curve :mastery-lerp}
  :cost-overload {:curve :mastery-lerp}
  :cooldown-ticks {:curve :mastery-lerp}
  :exp-entity {:curve :affine}
  :exp-block {:curve :affine}}
 :costs
 {:activate {:resources {:cp {:tunable :cost-cp}
                         :overload {:tunable :cost-overload}}}}
 :cooldown {:main {:ticks {:tunable :cooldown-ticks}}}
 :progression {:hit-entity {:per-mark {:tunable :exp-entity}}
               :hit-block {:per-mark {:tunable :exp-block}}}
 :vfx
 {:arc-fired {:effect-id :arc-gen :op :spawn
              :payload {:start :vec3 :end :vec3
                        :hit-type [:enum :entity :block :miss]
                        :life-ticks :long}}}
 :program
 {:component :flow/sequence
  :steps
  [{:component :cost/spend
    :budget :activate
    :on-insufficient {:component :flow/finish
                      :outcome :insufficient-resource
                      :finish-session? true}}
   {:component :target/raycast
    :origin {:from :caster/eye}
    :direction {:from :caster/aim}
    :distance {:tunable :max-distance}
    :include-entities? true :include-blocks? true
    :result :aim-hit}
   {:component :effect/vfx
    :effect-id :arc-gen :operation :spawn
    :instance-key [:activation :arc-fired]
    :audience {:type :nearby :radius 32.0}
    :payload {:start {:from :caster/eye}
              :end {:ref [:slot :aim-hit :position]}
              :hit-type {:ref [:slot :aim-hit :hit-type]}
              :life-ticks 10}}
   {:component :flow/branch
    :when {:ref [:slot :aim-hit :entity-id]}
    :then {:component :flow/sequence
           :steps [{:component :combat/impact-strike
                    :target {:ref [:slot :aim-hit :entity-id]}
                    :amount {:tunable :damage}
                    :damage-type :skill
                    :on-impact {:component :flow/branch
                                :when {:expr :bool/and
                                       :args [{:ref [:slot :aim-hit :creeper?]}
                                              {:expr :random/chance
                                               :args [{:tunable :creeper-charge-chance}]}]}
                                :then {:component :combat/status
                                       :target {:ref [:slot :aim-hit :entity-id]}
                                       :status-id :powered-creeper
                                       :duration-ticks 1 :amplifier 0}}}
                   {:component :score/mark :tag :hit-entity}
                   {:component :domain/event
                    :event-type :achievement/trigger
                    :payload {:id "electromaster.arc_gen"}}]}
    :else {:component :flow/sequence
           :steps [{:component :domain/event
                    :event-type :world/block-impact
                    :payload {:world-id {:from :world/id}
                              :position {:ref [:slot :aim-hit :position]}
                              :block-position {:ref [:slot :aim-hit :block-position]}
                              :water? {:ref [:slot :aim-hit :water?]}
                              :skill-exp {:from :progression/mastery}
                              :seed {:from :rng/seed}
                              :ignite-probability {:tunable :ignite-probability}
                              :fishing-probability {:tunable :fishing-probability}
                              :fishing-exp-threshold {:tunable :fishing-exp-threshold}}}
                   {:component :score/mark :tag :hit-block}]}}
   {:component :cooldown/start :name :main}
   {:component :flow/finish :outcome :performed :finish-session? true}]}}

{:schema-version 1
 :kind :ability
 :id :railgun
 :revision 2
 :activation :session
 :parameters {:beam-damage {:source :config
                            :path [:railgun :beam.damage]
                            :type [:tuple :double 2]
                            :snapshot :activation}
              :beam-radius {:source :config
                            :path [:railgun :beam.radius]
                            :type :double
                            :snapshot :activation}
              :beam-query-radius {:source :config
                                  :path [:railgun :beam.query-radius]
                                  :type :double
                                  :snapshot :activation}
              :beam-step {:source :config
                          :path [:railgun :beam.step]
                          :type :double
                          :snapshot :activation}
              :beam-block-energy {:source :config
                                  :path [:railgun :beam.block-energy]
                                  :type [:tuple :double 2]
                                  :snapshot :activation}
              :beam-visual-distance {:source :config
                                     :path [:railgun :beam.visual-distance]
                                     :type :double
                                     :snapshot :activation}
              :max-distance {:source :config
                             :path [:railgun :beam.max-distance]
                             :type :double
                             :snapshot :activation}
              :charge-ticks {:source :config
                             :path [:railgun :charge.item-charge-ticks]
                             :type :long
                             :snapshot :activation}
              :cost-down-cp {:source :config
                             :path [:railgun :cost.down.cp]
                             :type [:tuple :double 2]
                             :snapshot :activation}
              :cost-down-overload {:source :config
                                   :path [:railgun :cost.down.overload]
                                   :type [:tuple :double 2]
                                   :snapshot :activation}}
 :external-triggers [{:source :item/use
                      :filter {:item-ids ["ac:coin" "academy:coin"]
                               :ability-mode? true}
                      :dispatch {:ability :railgun :event :coin-thrown}}]
 :reactions []
 :vfx-contracts {:beam-fired {:effect-id :railgun-beam
                              :op :spawn
                              :payload {:start :vec3
                                        :end :vec3
                                        :mode [:enum :main :reflected]
                                        :life-ticks :long}}
                 :charge-started {:effect-id :railgun-charge
                                  :op :spawn
                                  :payload {:source-owner :owner-id
                                            :charge-ticks :long}}}
 :program {:component :flow/phases
           :start {:component :flow/sequence
                   :steps [{:component :target/entities
                            :shape {:type :sphere
                                    :center {:ref [:context :eye-pos]}
                                    :radius 4.0}
                            :filter {:entity-types ["academy:entity_coin_throwing"]}
                            :projection [:id :age-ms :motion-progress]
                            :limit 8
                            :result :coins}
                           {:component :effect/vfx
                            :effect-id :railgun-charge
                            :operation :spawn
                            :instance-key [:activation :railgun-charge]
                            :audience {:type :nearby :radius 32.0}
                            :payload {:source-owner {:ref [:context :owner]}
                                      :charge-ticks {:ref [:param :charge-ticks]}}}
                           {:component :flow/finish :outcome :started}]}
           :pulse {:component :flow/sequence
                   :steps [{:component :target/raycast
                            :origin {:ref [:context :eye-pos]}
                            :direction {:ref [:context :look]}
                            :distance {:ref [:param :max-distance]}
                            :include-entities? true
                            :include-blocks? true
                            :result :aim-hit}
                           {:component :host/beam-trace
                            :origin {:ref [:slot :muzzle]}
                            :direction {:ref [:context :look]}
                            :length {:ref [:param :max-distance]}
                            :visual-length {:ref [:param :beam-visual-distance]}
                            :radius {:ref [:param :beam-radius]}
                            :query-radius {:ref [:param :beam-query-radius]}
                            :step {:ref [:param :beam-step]}
                            :damage {:expr :math/lerp
                                     :args [{:ref [:param :beam-damage 0]}
                                            {:ref [:param :beam-damage 1]}
                                            {:ref [:context :skill-exp]}]}
                            :entity-limit 256
                            :block-policy {:component :block/break-budget
                                           :blocks {:ref [:slot :blocks]}
                                           :energy {:expr :math/lerp
                                                    :args [{:ref [:param :beam-block-energy 0]}
                                                           {:ref [:param :beam-block-energy 1]}
                                                           {:ref [:context :skill-exp]}]}
                                           :step {:ref [:param :beam-step]}
                                           :limit 4096}
                            :result :beam-result}
                           {:component :effect/vfx
                            :effect-id :railgun-beam
                            :operation :spawn
                            :payload {:start {:ref [:slot :beam-result :start]}
                                      :end {:ref [:slot :beam-result :end]}
                                      :mode :main
                                      :life-ticks 50}}
                           {:component :flow/finish :outcome :continue}]}
           :release {:component :flow/sequence
                     :steps [{:component :effect/vfx
                              :effect-id :railgun-charge
                              :operation :destroy
                              :instance-key [:activation :railgun-charge]
                              :payload {}}
                             {:component :txn/atomic
                              :guards [{:component :guard/resource
                              :cost {:cp {:expr :math/lerp
                                          :args [{:ref [:param :cost-down-cp 0]}
                                                 {:ref [:param :cost-down-cp 1]}
                                                 {:ref [:context :skill-exp]}]}
                                      :overload {:expr :math/lerp
                                                 :args [{:ref [:param :cost-down-overload 0]}
                                                        {:ref [:param :cost-down-overload 1]}
                                                        {:ref [:context :skill-exp]}]}}}
                              {:component :guard/held-item
                               :source :main-hand
                               :item-ids ["minecraft:iron_ingot"
                                          "minecraft:iron_block"]}]
                              :reservations [{:component :inventory/consume
                                     :source :main-hand
                                     :count 1}]
                              :body {:component :world/sound
                            :sound-id "academy:em.railgun"
                            :position {:ref [:context :eye-pos]}}
                              :on-success {:component :flow/finish
                                           :outcome :committed}
                              :on-fail {:component :flow/finish
                                        :outcome :insufficient-resource}}]}
           :abort {:component :flow/sequence
                   :steps [{:component :effect/vfx
                            :effect-id :railgun-charge
                            :operation :destroy
                            :instance-key [:activation :railgun-charge]
                            :payload {}}
                           {:component :flow/finish :outcome :aborted}]}
           :events {:coin-thrown {:component :flow/finish
                                  :outcome :received}}}}

{:schema-version 2
 :kind :ability
 :id :railgun
 :revision 4
 :activation :session
 :status :migrated
 :requires [:caster/eye :caster/aim :caster/id]
 :tunables
 {:beam-damage {:curve :mastery-lerp}
  :beam-radius {:curve :const}
  :beam-query-radius {:curve :const}
  :beam-step {:curve :const}
  :beam-block-energy {:curve :mastery-lerp}
  :beam-visual-distance {:curve :const}
  :max-distance {:curve :const}
  :charge-ticks {:curve :const :type :long}
  :cost-down-cp {:curve :mastery-lerp}
  :cost-down-overload {:curve :mastery-lerp}}
 ;; Only spent at :release -- :start/:pulse are free (charge-up costs
 ;; nothing; the shot itself does).
 :costs {:fire {:resources {:cp {:tunable :cost-down-cp}
                            :overload {:tunable :cost-down-overload}}}}
 :external-triggers [{:source :item/use
                      :filter {:item-ids ["ac:coin" "academy:coin"]
                               :ability-mode? true}
                      :dispatch {:ability :railgun :event :coin-thrown}}]
 :program
 {:component :flow/phases
  :start
  {:component :flow/sequence
   :steps [{:component :target/entities
            :shape {:type :sphere :center {:from :caster/eye} :radius 4.0}
            :filter {:entity-types ["academy:entity_coin_throwing"]}
            :projection [:id :age-ms :motion-progress]
            :limit 8
            :result :coins}
           {:component :effect/vfx
            :effect-id :billboard-session
            :operation :spawn
            :instance-key [:activation :railgun-charge]
            :audience {:type :nearby :radius 32.0}
            :payload {:anchor :owner-hand :duration-ticks 64
                      :texture-pattern "academy:textures/effects/arc_burst/%d.png"
                      :frame-count 40 :frame-duration-ms 40 :half-size 0.4}}
           {:component :flow/finish :outcome :started}]}
  ;; Charge-up only -- the beam is a release-time weapon discharge, not a
  ;; continuous per-tick trace (spawning a 50-tick beam VFX and re-querying
  ;; the beam every pulse tick, as this used to, fired the shot effect the
  ;; whole time the trigger was held down, and there was no :combat/damage
  ;; node anywhere in the file, so nothing the beam passed through was ever
  ;; actually damaged). :aim-hit is unused by :release below (:host/beam-trace
  ;; there reads :caster/eye/:caster/aim directly) -- :pulse has nothing left
  ;; to compute.
  :pulse {:component :flow/finish :outcome :continue}
  :release
  {:component :flow/sequence
   :steps [{:component :effect/vfx
            :effect-id :billboard-session
            :operation :destroy
            :instance-key [:activation :railgun-charge]
            :payload {}}
           {:component :target/item-held :source :main-hand :result :hand-item}
           {:component :txn/atomic
            :guards [{:component :guard/value-in
                     :value {:ref [:slot :hand-item :item-id]}
                     :one-of ["minecraft:iron_ingot" "minecraft:iron_block"]}]
            :reservations [{:component :inventory/consume
                            :source :main-hand
                            :count 1}]
            :body {:component :flow/sequence
                   :steps [{:component :cost/spend
                            :budget :fire
                            :on-insufficient {:component :flow/finish
                                              :outcome :insufficient-resource}}
                           {:component :host/beam-trace
                            :origin {:from :caster/eye}
                            :direction {:from :caster/aim}
                            :length {:tunable :max-distance}
                            :visual-length {:tunable :beam-visual-distance}
                            :radius {:tunable :beam-radius}
                            :query-radius {:tunable :beam-query-radius}
                            :step {:tunable :beam-step}
                            :damage {:tunable :beam-damage}
                            :damage-type :skill :entity-limit 256
                            :block-limit 4096
                            :result :beam-result}
                           {:component :flow/foreach
                            :items {:ref [:slot :beam-result :entities]}
                            :as :target :limit 256
                            :body {:component :combat/damage
                                   :target {:ref [:slot :target :id]}
                                   :amount {:ref [:slot :target :damage]}
                                   :damage-type :skill}}
                           {:component :block/break-budget
                            :world-id {:from :world/id}
                            :blocks {:ref [:slot :beam-result :blocks]}
                            :energy {:tunable :beam-block-energy}
                            :limit 4096
                            :seed {:from :rng/seed}}
                           {:component :effect/vfx
                            :effect-id :beam-arc-fade
                            :operation :spawn
                            :payload {:start {:ref [:slot :beam-result :start]}
                                      :end {:ref [:slot :beam-result :end]}
                                      :duration-ticks 50 :beam-at 0 :grow-ticks 3
                                      :layers [{:shape :tube :radius 0.13 :color [236 170 93 60]}
                                               {:shape :tube :radius 0.09 :color [241 240 222 200]}
                                               {:shape :line :width 0.02 :color [165 230 255 160]}]
                                      :arc-at 3 :arc-spacing {:min 1.0 :max 2.0}
                                      :arc-radius {:min 0.1 :max 0.25}
                                      :arc-count-limit 64 :arc-life-ticks 30
                                      :fade-at 30 :fade-from-tick 30 :fade-to-tick 50
                                      :fade-from-alpha 1.0 :fade-to-alpha 0.0
                                      :ring-radius 0.34 :ring-segments 12
                                      :ring-color [188 252 238 180]}}
                           {:component :world/sound
                            :world-id {:from :world/id}
                            :sound-id "academy:em.railgun"
                            :position {:from :caster/eye}}
                           {:component :flow/finish :outcome :committed}]}
            :on-fail {:component :flow/finish
                      :outcome :insufficient-resource}}]}
  :abort
  {:component :flow/sequence
   :steps [{:component :effect/vfx
            :effect-id :billboard-session
            :operation :destroy
            :instance-key [:activation :railgun-charge]
            :payload {}}
           {:component :flow/finish :outcome :aborted}]}
  :events {:coin-thrown {:component :flow/finish :outcome :received}}}}

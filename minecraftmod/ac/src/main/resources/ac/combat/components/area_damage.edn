{:schema-version 1
 :kind :composite
 :id :combat/area-damage
 :revision 1
 ;; :area-target is this composite's own :flow/foreach loop variable
 ;; (bound below at :as :area-target) -- private to this body. :iterates
 ;; publishes it as the abstract :item port instead, so a caller's :damage
 ;; expression can vary per struck entity (e.g. falloff by distance)
 ;; without ever knowing this internal name; see recipe.clj's
 ;; check-per-item-input for the compile-time contract this enforces.
 :iterates {:item {:as :area-target :fields [:id :type :position]}}
 :inputs
 {:center {:type :object}
  :radius {:type :object}
  :filter {:type :object}
  :projection {:type :object}
  :limit {:type :object}
  :damage {:type :expr-per-item :port :item}
  :damage-type {:type :keyword}
  :on-impact {:type :node}}
 :body
 {:component :flow/sequence
  :steps [{:component :target/entities
           :shape {:type :sphere
                   :center {:ref [:input :center]}
                   :radius {:ref [:input :radius]}}
           :filter {:ref [:input :filter]}
           :projection {:ref [:input :projection]}
           :limit {:ref [:input :limit]}
           :result :area-targets}
          {:component :flow/foreach
           :items {:ref [:slot :area-targets]}
           :as :area-target
           :limit {:ref [:input :limit]}
           :body {:component :combat/impact-strike
                  :target {:ref [:slot :area-target :id]}
                  :amount {:ref [:input :damage]}
                  :damage-type {:ref [:input :damage-type]}
                  :on-impact {:ref [:input :on-impact]}}}]}}

{:schema :ac/vfx-v4,
 :id :ray-beam-transient,
 :lifecycle {:mode :transient},
 :inputs
 {:start {:type :vec3},
  :end {:type :vec3},
  :life-ticks {:type :int},
  :grow-ticks {:type :int},
  :style {:type :any},
  :bounds-radius {:type :float}},
 :graphs
 {:render
  {:nodes
   #:n{:start {:type :start, :nid :n/start},
       :n--entry--default-0
       {:type :component,
        :component :ray-beam,
        :nid :n/n--entry--default-0},
       :n001 {:type :context-ref, :key :start, :nid :n/n001},
       :n002 {:type :context-ref, :key :end, :nid :n/n002},
       :n003 {:type :context-ref, :key :grow-ticks, :nid :n/n003},
       :n004 {:type :context-ref, :key :style, :nid :n/n004},
       :n--entry--default-1
       {:type :end,
        :result {},
        :nid :n/n--entry--default-1,
        :inputs {:outcome :performed}}},
   :links
   [{:id :e/link001,
     :kind :data,
     :from [:n/n001 :value],
     :to [:n/n--entry--default-0 :start]}
    {:id :e/link002,
     :kind :data,
     :from [:n/n002 :value],
     :to [:n/n--entry--default-0 :end]}
    {:id :e/link003,
     :kind :data,
     :from [:n/n003 :value],
     :to [:n/n--entry--default-0 :grow-ticks]}
    {:id :e/link004,
     :kind :data,
     :from [:n/n004 :value],
     :to [:n/n--entry--default-0 :style]}
    {:id :e/link005,
     :kind :exec,
     :from [:n/n--entry--default-0 :out],
     :to [:n/n--entry--default-1 :in]}
    {:id :e/link006,
     :kind :exec,
     :from [:n/start :out],
     :to [:n/n--entry--default-0 :in]}]}}}

{:schema :ac/vfx-v4,
 :id :audio-loop-session,
 :lifecycle {:mode :session},
 :activation :instant,
 :parameters
 {:position {:type :vec3},
  :sound-id {:type :string},
  :volume {:type :float},
  :pitch {:type :float},
  :looping? {:type :boolean, :default true}},
 :entry-triggers {:render :vfx/render},
 :phases
 {:render
  [^{:nid "n/n--entry--default-0"}
   (audio-loop
    {:position ?position,
     :sound-id ?sound-id,
     :volume ?volume,
     :pitch ?pitch,
     :looping? ?looping?})
   ^{:nid "n/n--entry--default-1"}
   (finish {:outcome :performed})]}}

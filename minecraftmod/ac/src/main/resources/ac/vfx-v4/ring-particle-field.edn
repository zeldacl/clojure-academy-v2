{:schema :ac/vfx-v4,
 :id :ring-particle-field,
 :lifecycle {:mode :session},
 :activation :instant,
 :parameters
 {:position {:type :vec3},
  :ring-from {:type :float},
  :ring-to {:type :float},
  :segments {:type :int},
  :ring-color {:type :any},
  :rate-per-tick {:type :int},
  :limit {:type :int},
  :particle {:type :any}},
 :entry-triggers {:render :vfx/render},
 :phases
 {:render
  [^{:nid "n/n002"}
   (let __v4_n002 (math/lerp ?ring-from ?ring-to ?progress))
   ^{:nid "n/n--entry--default-0"}
   (ring
    {:center ?position,
     :radius __v4_n002,
     :segments ?segments,
     :color ?ring-color})
   ^{:nid "n/n--entry--default-1"}
   (emitter
    {:anchor ?position,
     :rate-per-tick ?rate-per-tick,
     :limit ?limit,
     :particle ?particle})
   ^{:nid "n/n--entry--default-2"}
   (finish {:outcome :performed})]}}

{:schema :ac/vfx-v4,
 :id :trajectory-ribbon-session,
 :activation :instant,
 :parameters
 {:lateral-offset {:type :float},
  :look-dir {:type :vec3},
  :can-perform? {:type :bool},
  :dt {:type :float},
  :vertical-offset {:type :float},
  :width {:type :float},
  :segments {:type :int},
  :gravity {:type :float},
  :forward-offset {:type :float},
  :style {:type :any},
  :init-vel {:type :vec3},
  :origin {:type :vec3},
  :drag {:type :float}},
 :entry-triggers {:render :vfx/render},
 :phases
 {:render
  [^{:nid "n/trajectory"}
   (trajectory
    {:lateral-offset ?lateral-offset,
     :look-dir ?look-dir,
     :can-perform? ?can-perform?,
     :dt ?dt,
     :vertical-offset ?vertical-offset,
     :width ?width,
     :segments ?segments,
     :gravity ?gravity,
     :forward-offset ?forward-offset,
     :style ?style,
     :init-vel ?init-vel,
     :origin ?origin,
     :drag ?drag})
   ^{:nid "n/end"}
   (finish {:outcome :performed})]},
 :lifecycle {:mode :session}}

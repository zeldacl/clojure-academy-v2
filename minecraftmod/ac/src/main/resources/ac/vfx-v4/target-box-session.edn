{:schema :ac/vfx-v4,
 :id :target-box-session,
 :lifecycle {:mode :session},
 :activation :instant,
 :parameters
 {:position {:type :vec3},
  :width {:type :float},
  :height {:type :float},
  :color {:type :any}},
 :entry-triggers {:render :vfx/render},
 :phases
 {:render
  [^{:nid "n/n--entry--default-0"}
   (target-box
    {:center ?position, :width ?width, :color ?color, :height ?height})
   ^{:nid "n/n--entry--default-1"}
   (finish {:outcome :performed})]}}

{:schema :ac/vfx-v4,
 :id :particle-burst-trail-transient,
 :lifecycle {:mode :transient},
 :activation :instant,
 :parameters
 {:count-limit {:type :int},
  :life-ticks {:type :int},
  :fade-out {:type :int},
  :start {:type :vec3},
  :radius {:type :any},
  :size {:type :any},
  :alpha {:type :any},
  :end {:type :vec3},
  :velocity {:type :any},
  :texture {:type :string},
  :spacing {:type :any},
  :fade-in {:type :int}},
 :entry-triggers {:render :vfx/render},
 :phases
 {:render
  [^{:nid "n/n--entry--default-0"}
   (particle-trail
    {:count-limit ?count-limit,
     :life-ticks ?life-ticks,
     :fade-out ?fade-out,
     :start ?start,
     :radius ?radius,
     :size ?size,
     :alpha ?alpha,
     :end ?end,
     :velocity ?velocity,
     :texture ?texture,
     :spacing ?spacing,
     :fade-in ?fade-in})
   ^{:nid "n/n--entry--default-1"}
   (finish {:outcome :performed})]}}

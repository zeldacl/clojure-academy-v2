{:schema :ac/vfx-v4,
 :id :blood-retrograde-impact,
 :activation :instant,
 :parameters
 {:spray-duplicates {:type :int},
  :spray-life-ticks {:type :int},
  :look-dir {:type :vec3},
  :splash-frame-count {:type :int},
  :splash-frame-duration-ms {:type :int},
  :splash-texture-pattern {:type :string},
  :splash-life-ticks {:type :int},
  :target-height {:type :float},
  :seed {:type :int},
  :spray-textures {:type :any},
  :origin {:type :vec3},
  :surface-hits {:type :any},
  :splash-count {:type :int},
  :splash-size {:type :float},
  :target-width {:type :float}},
 :entry-triggers {:render :vfx/render},
 :phases
 {:render
  [^{:nid "n/n--entry--default-0"}
   (emitter
    {:rate-per-tick 1.0,
     :limit 64,
     :particle
     {:texture ?spray-textures,
      :life-ticks ?spray-life-ticks,
      :size ?splash-size},
     :anchor ?origin})
   ^{:nid "n/n--entry--default-1"}
   (finish {:outcome :performed})]},
 :lifecycle {:mode :transient}}

{:schema :ac/vfx-v4,
 :id :particle-burst,
 :lifecycle {:mode :transient},
 :inputs
 {:position {:type :vec3},
  :rate-per-tick {:type :int},
  :limit {:type :int},
  :particle {:type :any}},
 :graphs
 {:render
  {:nodes
   #:n{:start {:type :start, :nid :n/start},
       :n--entry--default-0
       {:type :component,
        :component :emitter,
        :nid :n/n--entry--default-0},
       :n001 {:type :context-ref, :key :position, :nid :n/n001},
       :n002 {:type :context-ref, :key :rate-per-tick, :nid :n/n002},
       :n003 {:type :context-ref, :key :limit, :nid :n/n003},
       :n004 {:type :context-ref, :key :particle, :nid :n/n004},
       :n--entry--default-1
       {:type :end,
        :result {},
        :nid :n/n--entry--default-1,
        :inputs {:outcome :performed}}},
   :links
   [{:id :e/link001,
     :kind :data,
     :from [:n/n001 :value],
     :to [:n/n--entry--default-0 :anchor]}
    {:id :e/link002,
     :kind :data,
     :from [:n/n002 :value],
     :to [:n/n--entry--default-0 :rate-per-tick]}
    {:id :e/link003,
     :kind :data,
     :from [:n/n003 :value],
     :to [:n/n--entry--default-0 :limit]}
    {:id :e/link004,
     :kind :data,
     :from [:n/n004 :value],
     :to [:n/n--entry--default-0 :particle]}
    {:id :e/link005,
     :kind :exec,
     :from [:n/n--entry--default-0 :out],
     :to [:n/n--entry--default-1 :in]}
    {:id :e/link006,
     :kind :exec,
     :from [:n/start :out],
     :to [:n/n--entry--default-0 :in]}]}}}

{:schema :ac/vfx-v4,
 :id :plasma-explosion-transient,
 :activation :instant,
 :parameters {:position {:type :vec3}},
 :entry-triggers {:render :vfx/render},
 :phases
 {:render
  [^{:nid "n/explosion"}
   (emitter
    {:rate-per-tick 1.0,
     :limit 1,
     :particle {:particle-type :explosion-large, :speed 0.0},
     :anchor ?position})
   ^{:nid "n/smoke"}
   (emitter
    {:rate-per-tick 1.0,
     :limit 1,
     :particle {:particle-type :smoke-large, :speed 0.1},
     :anchor ?position})
   ^{:nid "n/end"}
   (finish {:outcome :performed})]},
 :lifecycle {:mode :transient}}

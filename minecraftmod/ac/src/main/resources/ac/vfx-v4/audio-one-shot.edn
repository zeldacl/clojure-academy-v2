{:schema :ac/vfx-v4,
 :id :audio-one-shot,
 :lifecycle {:mode :transient},
 :activation :instant,
 :parameters
 {:position {:type :vec3},
  :sound-id {:type :string},
  :volume {:type :float},
  :pitch {:type :float}},
 :entry-triggers {:render :vfx/render},
 :phases
 {:render
  [^{:nid "n/n--entry--default-0"}
   (audio-one-shot
    {:sound-id ?sound-id,
     :volume ?volume,
     :pitch ?pitch,
     :position ?position})
   ^{:nid "n/n--entry--default-1"}
   (finish {:outcome :performed})]}}

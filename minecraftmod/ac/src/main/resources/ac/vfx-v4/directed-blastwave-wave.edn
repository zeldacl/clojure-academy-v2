{:schema :ac/vfx-v4,
 :id :directed-blastwave-wave,
 :lifecycle {:mode :transient},
 :inputs
 {:position {:type :vec3},
  :direction {:type :vec3},
  :seed {:type :int}}, :graphs
 {:render
  {:nodes
   #:n{:start {:type :start, :nid :n/start},
       :n--entry--default-0 {:type :component, :component :arc, :nid :n/n--entry--default-0},
       :n001 {:type :context-ref, :key :position, :nid :n/n001},
       :n002 {:type :context-ref, :key :direction, :nid :n/n002},
       :n003 {:type :context-ref, :key :seed, :nid :n/n003},
       :n--entry--default-1 {:type :end, :result {}, :nid :n/n--entry--default-1, :inputs {:outcome :performed}}},
   :links
   [{:id :e/db-wave-1, :kind :data, :from [:n/n001 :value], :to [:n/n--entry--default-0 :start]}
    {:id :e/db-wave-2, :kind :data, :from [:n/n002 :value], :to [:n/n--entry--default-0 :end]}
    {:id :e/db-wave-3, :kind :data, :from [:n/n003 :value], :to [:n/n--entry--default-0 :seed]}
    {:id :e/db-wave-4, :kind :exec, :from [:n/start :out], :to [:n/n--entry--default-0 :in]}
    {:id :e/db-wave-5, :kind :exec, :from [:n/n--entry--default-0 :out], :to [:n/n--entry--default-1 :in]}]}}}
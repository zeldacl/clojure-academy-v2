{:schema :ac/vfx-v4,
 :id :teleport-marker,
 :lifecycle {:mode :session},
 :activation :instant,
 :parameters
 {:position {:type :vec3},
  :direction {:type :vec3, :default [0.0 0.0 1.0]},
  :color {:type :any},
  :particle-chance {:type :float}},
 :entry-triggers {:render :vfx/render},
 :phases
 {:render
  [^{:nid "n/n--entry--marker"}
   (teleport-marker
    {:position ?position,
     :color ?color,
     :direction ?direction,
     :age ?age})
   ^{:nid "n/n--entry--default-0"}
   (emitter
    {:rate-per-tick 1.0,
     :limit 256,
     :anchor-offset-y 1.62,
     :particle
     {:life-ticks 20,
      :color [0 255 0 255],
      :spread {:x 1.0, :y 1.4, :z 1.0},
      :speed 0.08,
      :fade-in-ticks 5,
      :size {:min 0.1, :max 0.2},
      :material :additive,
      :alpha {:min 153, :max 204},
      :fade-out-ticks 20,
      :velocity {:x 0.03, :y 0.05, :z 0.03},
      :texture "academy:textures/effects/tp_particle.png"},
     :anchor ?position,
     :chance ?particle-chance})
   ^{:nid "n/n--entry--default-1"}
   (finish {:outcome :performed})]}}

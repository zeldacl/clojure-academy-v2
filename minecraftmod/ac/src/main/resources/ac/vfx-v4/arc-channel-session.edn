       :n015 {:type :context-ref, :key :age, :nid :n/n015}
       :n016 {:type :context-ref, :key :seed, :nid :n/n016}
       :n017 {:type :context-ref, :key :source-player-id, :nid :n/n017}
       :n018 {:type :end, :result {}, :nid :n/n018
             :inputs {:outcome :performed}}
       :n019 {:type :merge, :nid :n/n019}}
   :links
   [{:id :e/ac-1, :kind :data, :from [:n/n001 :value], :to [:n/n002 :arg0]}
    {:id :e/ac-2, :kind :data, :from [:n/n002 :value], :to [:n/n--entry--default-0 :condition]}
    {:id :e/ac-3, :kind :data, :from [:n/n004 :value], :to [:n/n003 :start]}
    {:id :e/ac-4, :kind :data, :from [:n/n005 :value], :to [:n/n003 :end]}
    {:id :e/ac-5, :kind :data, :from [:n/n006 :value], :to [:n/n003 :age]}
    {:id :e/ac-6, :kind :data, :from [:n/n007 :value], :to [:n/n003 :seed]}
    {:id :e/ac-7, :kind :data, :from [:n/n008 :value], :to [:n/n003 :source-player-id]}
    {:id :e/ac-8, :kind :exec, :from [:n/start :out], :to [:n/n--entry--default-0 :in]}
    {:id :e/ac-9, :kind :exec, :from [:n/n--entry--default-0 :true], :to [:n/n003 :in]}
    {:id :e/ac-10, :kind :exec, :from [:n/n003 :out], :to [:n/n019 :in]}
    {:id :e/ac-11, :kind :exec, :from [:n/n--entry--default-0 :false], :to [:n/n019 :in]}
    {:id :e/ac-12, :kind :data, :from [:n/n010 :value], :to [:n/n009 :origin]}

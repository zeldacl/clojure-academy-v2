       :n005 {:type :context-ref, :key :target, :nid :n/n005}
       :n006 {:type :context-ref, :key :age, :nid :n/n006}
       :n007 {:type :context-ref, :key :seed, :nid :n/n007}
       :n008 {:type :context-ref, :key :source-player-id, :nid :n/n008}

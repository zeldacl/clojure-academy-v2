{:schema :ac/vfx-v4,
 :id :directed-blastwave-charge,
 :lifecycle {:mode :session},
 :inputs
 {:center {:type :vec3},
  :charge-ticks {:type :int},
  :punched? {:type :bool},
  :max-charge-ticks {:type :int}}, :graphs
 {:render
  {:nodes
   #:n{:start {:type :start, :nid :n/start},
       :n--entry--default-0 {:type :component, :component :ring, :nid :n/n--entry--default-0},
       :n001 {:type :context-ref, :key :center, :nid :n/n001},
       :n002 {:type :context-ref, :key :charge-ticks, :nid :n/n002},
       :n003 {:type :context-ref, :key :punched?, :nid :n/n003},
       :n--entry--default-1 {:type :end, :result {}, :nid :n/n--entry--default-1, :inputs {:outcome :performed}}},
   :links
   [{:id :e/db-charge-1, :kind :data, :from [:n/n001 :value], :to [:n/n--entry--default-0 :center]}
    {:id :e/db-charge-2, :kind :data, :from [:n/n002 :value], :to [:n/n--entry--default-0 :radius]}
    {:id :e/db-charge-3, :kind :data, :from [:n/n003 :value], :to [:n/n--entry--default-0 :color]}
    {:id :e/db-charge-4, :kind :exec, :from [:n/start :out], :to [:n/n--entry--default-0 :in]}
    {:id :e/db-charge-5, :kind :exec, :from [:n/n--entry--default-0 :out], :to [:n/n--entry--default-1 :in]}]}}}
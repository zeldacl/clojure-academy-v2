{:schema :ac/vfx-v4,
 :id :directed-blastwave-charge,
 :lifecycle {:mode :session},
 :activation :instant,
 :parameters
 {:center {:type :vec3},
  :charge-ticks {:type :int},
  :punched? {:type :bool},
  :max-charge-ticks {:type :int}},
 :entry-triggers {:render :vfx/render},
 :phases
 {:render
  [^{:nid "n/n--charge-progress"}
   (let progress
     (math/min 1.0 (math/div ?charge-ticks ?max-charge-ticks)))
   ^{:nid "n/n--charge-radius"}
   (let radius (math/add 0.1 (math/mul 0.16 progress)))
   ^{:nid "n/n--charge-pulse"}
   (let pulse
     (math/add radius (math/mul 0.025 (math/sin (math/mul 0.22 ?charge-ticks)))))
   ^{:nid "n/n--charge-alpha"}
   (let alpha (math/select ?punched? 0.863 0.667))
   ^{:nid "n/n--entry--default-0"}
   (ring
    {:center ?center,
     :radius pulse,
     :segments 16,
     :color [225 245 255 255],
     :alpha alpha})
   ^{:nid "n/n--entry--default-1"}
   (finish {:outcome :performed})]}}

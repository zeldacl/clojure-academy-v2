{:schema :ac/skill-v4,
 :id :rad-intensify,
 :skill {:category :migrated, :level 1},
 :activation :passive,
 :parameters
 {:damage-rate {:type :double},
  :mark-duration-ticks {:type :long},
  :mastery-denominator {:type :double}},
 :state {},
 :tunables
 {:damage-rate {:curve :pair},
  :mark-duration-ticks {:curve :const, :type :int},
  :mastery-denominator {:curve :const}},
 :costs nil,
 :cooldown nil,
 :progression nil,
 :invariants nil,
 :requires [:world/id],
 :entry-triggers
 {:start :phase/start,
  :pulse :phase/pulse,
  :release :phase/release,
  :abort :phase/abort},
 :name-key "ability.skill.meltdowner.rad_intensify",
 :description-key "ability.skill.meltdowner.rad_intensify.desc",
 :mark-policies
 [{:mark-type :radiation,
   :requires-ability :rad-intensify,
   :duration-ticks $mark-duration-ticks,
   :vfx
   {:effect-id :target-mark-session,
    :operation :spawn,
    :audience {:type :nearby, :radius 32.0},
    :offset {:vec3 [0.0 0.8 0.0]},
    :payload
    {:position ?mark/target-position,
     :ttl-ticks $mark-duration-ticks,
     :count 3,
     :radius 0.35,
     :color [236 170 93 180]}}}],
 :damage-policies
 [{:on :combat/damage,
   :priority 100,
   :mark-type :radiation,
   :when (bool/and ?context/mark? (math/gt ?request/base 0.0)),
   :program {:component :damage/multiply, :multiplier ?context/mark}}],
 :phases
 {:start [^{:nid "n/n--entry--start-0"} (finish {:outcome :passive})],
  :pulse [^{:nid "n/n--entry--pulse-0"} (finish {:outcome :passive})],
  :release
  [^{:nid "n/n--entry--release-0"} (finish {:outcome :passive})],
  :abort [^{:nid "n/n--entry--abort-0"} (finish {:outcome :passive})]}}

{:doc ["New-DSL conversion of ac/combat/abilities/current_charging.edn (S6)."
        "Session hold-charge energy pump: at :start, whichever the caster is"
        "doing (holding a chargeable item vs aiming at a chargeable block) is"
        "locked in for the whole activation via :is-item session state; every"
        ":pulse re-checks that same target kind and pushes :charge-amount"
        "energy into it. No cooldown at all (the old top-level :cooldown is"
        "genuinely nil, kept as-is)."
        ""
        ":energy/charge is a NEW vocab node (combat-core/dsl_vocabulary.clj):"
        "the old component was never wired into the vocabulary anywhere,"
        "unlike :energy/target which already existed from an earlier"
        "conversion. :returns nil since no old call site ever bound a result."
        ""
        "The block-targeting branch's charging-budget spend happens AFTER the"
        "vfx update in BOTH its effective and ineffective sub-branches (unlike"
        "the item-targeting branch, which spends BEFORE deciding"
        "effective/ineffective) -- kept exactly as ordered in the old content,"
        "duplicated across both sub-branches rather than factored out, the"
        "same choice already established for this session's other same-"
        "ability repeated blocks."]
 :schema-version 2
 :kind :ability
 :id :current-charging
 :revision 1
 :activation :session
 :requires [:caster/eye :caster/aim :caster/id :caster/creative? :world/id :charge/ticks :rng/seed]
 :prerequisites [{:skill-id :arc-gen :min-exp 0.3}]
 :tunables {:visual-max-ticks {:curve :const :type :int}
            :targeting-range {:curve :const}
            :charge-amount {:curve :mastery-lerp}
            :cost-down-overload {:curve :mastery-lerp}
            :cost-tick-cp {:curve :mastery-lerp}
            :exp-effective {:curve :const}
            :exp-ineffective {:curve :const}}
 :costs {:activate {:resources {:overload {:ref [:input :tunables :cost-down-overload]}}}
         :charging {:resources {:cp {:ref [:input :tunables :cost-tick-cp]}}}}
 :progression {:effective {:per-mark {:ref [:input :tunables :exp-effective]}}
              :ineffective {:per-mark {:ref [:input :tunables :exp-ineffective]}}}
 :session-state {:is-item {:type :bool :default nil}
                 :charge-ticks {:type :int :default 0}
                 :style {:type :any :default nil}
                 :overload-floor {:type :float :default nil}}
 :program
 "{:ability :current-charging
   :activation :session
   :state {:is-item {:type :boolean :default nil} :charge-ticks {:type :long :default 0}
           :style {:type :any :default nil} :overload-floor {:type :double :default nil}}
   :tunables {:cost-down-overload {:type :double} :visual-max-ticks {:type :long}
              :targeting-range {:type :double} :charge-amount {:type :double}}
   :phases
   {:start
    [(let eye ?caster/eye)
     (let aim ?caster/aim)
     (let wid ?world/id)
     (let activate-budget ?budget/activate)
     (let cost-down-overload $cost-down-overload)
     (let visual-max-ticks $visual-max-ticks)
     (let targeting-range $targeting-range)
     (let context-resources ?context/resources)
     (let held-item (target/item-held {:source :main-hand}))
     (let sufficient? (cost/spend {:budget activate-budget}))
     (if sufficient?
       [(let item-present? (:present? held-item))
        (state! :is-item item-present?)
        (state! :charge-ticks 0)
        (let style
          {:beam {:branch-factor 0.3 :passes 5 :width 0.1 :amplitude 0.06 :segments 20
                 :fork-count 2 :fork-length 0.08 :fork-angle 0.17}
           :sparks {:block-count 6 :visible-chance 0.43 :block-amplitude 0.23 :life-ticks 30
                    :block-width 0.09 :item-width 0.06 :line-color [190 244 255 255]
                    :shape-swap-chance 0.3 :segments 6 :item-amplitude 0.46
                    :inner-color [235 252 255 255] :item-count 4 :outer-color [150 232 255 255]}})
        (state! :style style)
        (let overload-floor (math/max 0.0 (math/sub (:overload context-resources) cost-down-overload)))
        (state! :overload-floor overload-floor)
        (vfx! {:effect-id :arc-channel-session :operation :spawn
              :instance-key [:activation :current-charging-channel]
              :audience (math/select item-present? {:type :owner} {:type :nearby :radius 64.0})
              :payload {:block-bounds nil :charge-ticks 0
                       :mode (math/select item-present? :item :block) :style style :good? false
                       :target (math/select item-present? nil
                                            (vec3/add eye (vec3/scale aim targeting-range)))
                       :caster eye :block-pos nil :visual-max-ticks visual-max-ticks}})
        (vfx! {:effect-id :audio-loop-session :operation :spawn
              :instance-key [:activation :current-charging-audio]
              :audience (math/select item-present? {:type :owner} {:type :nearby :radius 32.0})
              :payload {:position eye :sound-id \"academy:em.charge_loop\" :volume 0.3 :pitch 1.0}})
        (finish {:outcome :started})]
       [(finish {:outcome :insufficient-resource :end-ability? true})])]

    :pulse
    [(let eye ?caster/eye)
     (let aim ?caster/aim)
     (let wid ?world/id)
     (let targeting-range $targeting-range)
     (let charge-amount $charge-amount)
     (let visual-max-ticks $visual-max-ticks)
     (let overload-floor %overload-floor)
     (resource/enforce-floor {:resource :overload :minimum overload-floor})
     (let charge-ticks-cur %charge-ticks)
     (let charge-ticks-next (long/add charge-ticks-cur 1))
     (state! :charge-ticks charge-ticks-next)
     (let is-item %is-item)
     (let style %style)
     (if is-item
       [(let held-item (target/item-held {:source :main-hand}))
        (if (bool/not (:present? held-item))
          [(vfx! {:effect-id :arc-channel-session :operation :destroy
                 :instance-key [:activation :current-charging-channel] :payload {:fade-ticks 0}})
           (vfx! {:effect-id :audio-loop-session :operation :destroy
                 :instance-key [:activation :current-charging-audio] :payload {:fade-ticks 0}})
           (finish {:outcome :item-missing :end-ability? true})]
          [(let charging-budget ?budget/charging)
           (let sufficient? (cost/spend {:budget charging-budget}))
           (if (bool/not sufficient?)
             [(vfx! {:effect-id :arc-channel-session :operation :destroy
                    :instance-key [:activation :current-charging-channel] :payload {:fade-ticks 0}})
              (vfx! {:effect-id :audio-loop-session :operation :destroy
                    :instance-key [:activation :current-charging-audio] :payload {:fade-ticks 0}})
              (finish {:outcome :insufficient-resource :end-ability? true})]
             [(if (:supported? held-item)
                [(energy/charge {:mode :item :world-id wid :target held-item
                                :amount (math/floor charge-amount)})
                 (let effective-progression ?progression/effective)
                 (event! {:type :score/mark :progression effective-progression})
                 (vfx! {:effect-id :arc-channel-session :operation :update
                       :instance-key [:activation :current-charging-channel]
                       :payload {:block-bounds nil :charge-ticks charge-ticks-next :mode :item
                                :style style :good? true :target nil :caster eye :block-pos nil
                                :visual-max-ticks visual-max-ticks}})
                 (vfx! {:effect-id :audio-loop-session :operation :update
                       :instance-key [:activation :current-charging-audio]
                       :payload {:position eye}})
                 (finish {:outcome :continue})]
                [(let ineffective-progression ?progression/ineffective)
                 (event! {:type :score/mark :progression ineffective-progression})
                 (vfx! {:effect-id :arc-channel-session :operation :update
                       :instance-key [:activation :current-charging-channel]
                       :payload {:block-bounds nil :charge-ticks charge-ticks-next :mode :item
                                :style style :good? false :target nil :caster eye :block-pos nil
                                :visual-max-ticks visual-max-ticks}})
                 (vfx! {:effect-id :audio-loop-session :operation :update
                       :instance-key [:activation :current-charging-audio]
                       :payload {:position eye}})
                 (finish {:outcome :continue})])])])]
       [(let aim-hit (target/raycast {:origin eye :direction aim :distance targeting-range
                                     :include-entities? true :include-blocks? true}))
        (let energy-target (energy/target {:hit aim-hit}))
        (if (:chargeable? energy-target)
          [(energy/charge {:mode :block :world-id wid :target energy-target
                          :amount (math/floor charge-amount)})
           (let effective-progression ?progression/effective)
           (event! {:type :score/mark :progression effective-progression})
           (vfx! {:effect-id :arc-channel-session :operation :update
                 :instance-key [:activation :current-charging-channel]
                 :payload {:block-bounds (:block-bounds energy-target)
                          :charge-ticks charge-ticks-next :mode :block :style style :good? true
                          :target (:position aim-hit) :caster eye
                          :block-pos (:block-pos energy-target) :visual-max-ticks visual-max-ticks}})
           (vfx! {:effect-id :audio-loop-session :operation :update
                 :instance-key [:activation :current-charging-audio] :payload {:position eye}})
           (let charging-budget ?budget/charging)
           (let sufficient? (cost/spend {:budget charging-budget}))
           (if (bool/not sufficient?)
             [(vfx! {:effect-id :arc-channel-session :operation :destroy
                    :instance-key [:activation :current-charging-channel] :payload {:fade-ticks 0}})
              (vfx! {:effect-id :audio-loop-session :operation :destroy
                    :instance-key [:activation :current-charging-audio] :payload {:fade-ticks 0}})
              (finish {:outcome :insufficient-resource :end-ability? true})]
             [(finish {:outcome :continue})])]
          [(let ineffective-progression ?progression/ineffective)
           (event! {:type :score/mark :progression ineffective-progression})
           (vfx! {:effect-id :arc-channel-session :operation :update
                 :instance-key [:activation :current-charging-channel]
                 :payload {:block-bounds (:block-bounds energy-target)
                          :charge-ticks charge-ticks-next :mode :block :style style :good? false
                          :target (:position aim-hit) :caster eye
                          :block-pos (:block-pos energy-target) :visual-max-ticks visual-max-ticks}})
           (vfx! {:effect-id :audio-loop-session :operation :update
                 :instance-key [:activation :current-charging-audio] :payload {:position eye}})
           (let charging-budget ?budget/charging)
           (let sufficient? (cost/spend {:budget charging-budget}))
           (if (bool/not sufficient?)
             [(vfx! {:effect-id :arc-channel-session :operation :destroy
                    :instance-key [:activation :current-charging-channel] :payload {:fade-ticks 0}})
              (vfx! {:effect-id :audio-loop-session :operation :destroy
                    :instance-key [:activation :current-charging-audio] :payload {:fade-ticks 0}})
              (finish {:outcome :insufficient-resource :end-ability? true})]
             [(finish {:outcome :continue})])])])]

    :release
    [(vfx! {:effect-id :arc-channel-session :operation :destroy
           :instance-key [:activation :current-charging-channel] :payload {:fade-ticks 0}})
     (vfx! {:effect-id :audio-loop-session :operation :destroy
           :instance-key [:activation :current-charging-audio] :payload {:fade-ticks 0}})
     (finish {:outcome :released :end-ability? true})]

    :abort
    [(vfx! {:effect-id :arc-channel-session :operation :destroy
           :instance-key [:activation :current-charging-channel] :payload {:fade-ticks 0}})
     (vfx! {:effect-id :audio-loop-session :operation :destroy
           :instance-key [:activation :current-charging-audio] :payload {:fade-ticks 0}})
     (finish {:outcome :aborted :end-ability? true})]}}"
 :cooldown nil
 :invariants nil
 :mark-policies nil}

{:doc ["New-DSL conversion of ac/combat/abilities/flashing.edn (S6, final"
        "ability of the S6 conversion pass). Toggle ability with a 12-event"
        ":movement/* map (4 directions x press/tick/release) whose bodies are"
        "byte-identical except for the :direction keyword and whether the"
        "teleport-marker vfx :operation is :spawn/:update (preview) or a full"
        "commit (release). Unlike every earlier ability's smaller-scale"
        "duplication (handled with the ability-local predeclare+set!"
        "technique), this duplication spans the ability's ENTIRE event set, so"
        "it is factored into two NEW combat-core :defn composites instead:"
        "combat-core/lib/blink_preview.edn (press/tick, shared by a"
        "marker-operation param) and combat-core/lib/blink_release.edn"
        "(release, which spends for real and commits the teleport). Both are"
        "new library files, not ports of pre-existing old composites -- this"
        "establishes :defn composites as a mechanism for cross-EVENT reuse"
        "within one ability, not just cross-ability reuse."
        ""
        "combat/blink-release calls `finish` directly inside its own :defn"
        "body, relying on compile-fn-call inlining fn bodies at the call site"
        "(not a real call boundary) so the finish terminates the calling"
        "event's own block exactly as if written inline -- confirmed by this"
        "file's own tests actually dispatching :movement/*-release and"
        "observing the :teleported outcome and :end-ability? false default."
        ""
        "?caster/eye-y is a new fixed capability (combat-core/run.clj) --"
        "this is its first real content user, feeding"
        "target/directional-destination's :eye-y param the same way the old"
        "content's :ability/caster :eye-y bind did."
        ""
        ":start's old :ability/caster bind pulled :eye/:eye-y/:body/:aim/"
        ":world-id alongside :creative?, but only :creative? is ever read"
        "anywhere in the old :start body (grep-confirmed) -- the rest are"
        "dropped as dead reads, matching this session's established"
        "dead-read-drop precedent (mine_ray.edn, jet_engine.edn, etc); each"
        "movement event re-reads its own fresh caster snapshot regardless."
        ""
        ":pulse's old content re-read :active-ticks from state TWICE (once as"
        "the :max-active-ticks comparison, again for the increment) -- ported"
        "using the single already-bound active-ticks-check local for both,"
        "the same \"reuse the already-computed local\" rule established"
        "throughout this session (meltdowner/plasma_cannon/storm_wing)."
        ""
        "blink-interval-ticks is declared in :tunables but never read anywhere"
        "in the old :program (grep-confirmed, same as storm_wing.edn's own"
        "already-documented unused-tunable case) -- kept in the outer"
        "wrapper's :tunables (byte-for-byte per this session's convention) but"
        "not declared in :program's own :tunables map, since nothing in"
        ":program reads it via $."
        ""
        "No top-level :release-keeps-session? key (grep-confirmed absent,"
        "unlike storm_wing.edn/plasma_cannon.edn's own use of that flag) --"
        ":release is a bare (finish {:outcome :continue}) with no"
        ":end-ability?, matching the old content's own bare"
        "{:component :flow/finish :outcome :continue}."]
 :schema-version 2
 :kind :ability
 :id :flashing
 :name-key "ability.skill.teleporter.flashing"
 :description-key "ability.skill.teleporter.flashing.desc"
 :revision 2
 :activation :toggle
 :requires [:caster/eye :caster/body :caster/aim :caster/id :caster/creative? :world/id]
 :tunables {:blink-distance {:curve :mastery-lerp}
            :blink-interval-ticks {:curve :mastery-lerp}
            :max-active-ticks {:curve :mastery-lerp}
            :post-blink-fall-protect-ticks {:curve :mastery-lerp}
            :activate-overload {:curve :mastery-lerp}
            :activate-cp {:curve :mastery-lerp}
            :blink-cp {:curve :mastery-lerp}
            :blink-overload {:curve :mastery-lerp}
            :deactivate-cooldown-ticks {:curve :mastery-lerp}
            :exp-per-blink {:curve :const}}
 :costs nil
 :progression {:blink {:per-mark {:ref [:input :tunables :exp-per-blink]}}}
 :cooldown {:deactivate {:ticks {:ref [:input :tunables :deactivate-cooldown-ticks]}}}
 :session-state {:destination {:type :any :default nil}
                 :active-ticks {:type :int :default 0}
                 :fall-protect-ticks {:type :int :default 0}
                 :overload-floor {:type :float :default 0.0}}
 :program
 "{:ability :flashing
   :activation :toggle
   :state {:destination {:type :any :default nil} :active-ticks {:type :long :default 0}
           :fall-protect-ticks {:type :long :default 0} :overload-floor {:type :double :default 0.0}}
   :tunables {:blink-distance {:type :double} :activate-cp {:type :double}
              :activate-overload {:type :double} :max-active-ticks {:type :double}
              :blink-cp {:type :double} :blink-overload {:type :double}
              :post-blink-fall-protect-ticks {:type :double}}
   :phases
   {:start
    [(let creative? ?caster/creative?)
     (let required-cp (math/select creative? 0.0 $activate-cp))
     (let required-overload (math/select creative? 0.0 $activate-overload))
     (let start-resources ?context/resources)
     (let sufficient? (cost/spend {:budget {:resources {:cp required-cp :overload required-overload}}}))
     (if sufficient?
       [(state! :active-ticks 0)
        (state! :fall-protect-ticks 0)
        (state! :overload-floor (math/max 0.0 (math/sub (:overload start-resources) required-overload)))
        (finish {:outcome :started})]
       [(finish {:outcome :insufficient-resource :end-ability? true})])]

    :pulse
    [(let active-ticks-check %active-ticks)
     (if (math/gt active-ticks-check $max-active-ticks)
       [(vfx! {:effect-id :teleport-marker :operation :destroy
              :instance-key [:activation :teleport-marker] :payload {}})
        (let deactivate-cooldown ?cooldown/deactivate)
        (cooldown/start {:name :deactivate :ticks deactivate-cooldown})
        (finish {:outcome :expired :end-ability? true})]
       [(let owner-id ?caster/id)
        (let overload-floor %overload-floor)
        (let fall-protect-ticks %fall-protect-ticks)
        (resource/enforce-floor {:resource :overload :minimum overload-floor})
        (when (math/gt fall-protect-ticks 0)
          (entity/reset-fall-damage {:target owner-id}))
        (state! :active-ticks (long/add active-ticks-check 1))
        (state! :fall-protect-ticks (long/max 0 (long/sub fall-protect-ticks 1)))
        (finish {:outcome :continue})])]

    :release
    [(finish {:outcome :continue})]

    :abort
    [(vfx! {:effect-id :teleport-marker :operation :destroy
           :instance-key [:activation :teleport-marker] :payload {}})
     (let deactivate-cooldown ?cooldown/deactivate)
     (cooldown/start {:name :deactivate :ticks deactivate-cooldown})
     (finish {:outcome :aborted :end-ability? true})]

    :movement/right-press
    [(let owner-id ?caster/id) (let body ?caster/body) (let aim ?caster/aim) (let eye-y ?caster/eye-y)
     (let creative? ?caster/creative?)
     (combat/blink-preview owner-id body aim eye-y :right $blink-distance $blink-cp creative? :spawn)]
    :movement/right-tick
    [(let owner-id ?caster/id) (let body ?caster/body) (let aim ?caster/aim) (let eye-y ?caster/eye-y)
     (let creative? ?caster/creative?)
     (combat/blink-preview owner-id body aim eye-y :right $blink-distance $blink-cp creative? :update)]
    :movement/right-release
    [(let owner-id ?caster/id) (let body ?caster/body) (let aim ?caster/aim) (let eye-y ?caster/eye-y)
     (let wid ?world/id) (let creative? ?caster/creative?) (let blink-progression ?progression/blink)
     (combat/blink-release owner-id body aim eye-y wid :right $blink-distance $blink-cp $blink-overload
                           creative? $post-blink-fall-protect-ticks blink-progression)]

    :movement/back-press
    [(let owner-id ?caster/id) (let body ?caster/body) (let aim ?caster/aim) (let eye-y ?caster/eye-y)
     (let creative? ?caster/creative?)
     (combat/blink-preview owner-id body aim eye-y :back $blink-distance $blink-cp creative? :spawn)]
    :movement/back-tick
    [(let owner-id ?caster/id) (let body ?caster/body) (let aim ?caster/aim) (let eye-y ?caster/eye-y)
     (let creative? ?caster/creative?)
     (combat/blink-preview owner-id body aim eye-y :back $blink-distance $blink-cp creative? :update)]
    :movement/back-release
    [(let owner-id ?caster/id) (let body ?caster/body) (let aim ?caster/aim) (let eye-y ?caster/eye-y)
     (let wid ?world/id) (let creative? ?caster/creative?) (let blink-progression ?progression/blink)
     (combat/blink-release owner-id body aim eye-y wid :back $blink-distance $blink-cp $blink-overload
                           creative? $post-blink-fall-protect-ticks blink-progression)]

    :movement/left-press
    [(let owner-id ?caster/id) (let body ?caster/body) (let aim ?caster/aim) (let eye-y ?caster/eye-y)
     (let creative? ?caster/creative?)
     (combat/blink-preview owner-id body aim eye-y :left $blink-distance $blink-cp creative? :spawn)]
    :movement/left-tick
    [(let owner-id ?caster/id) (let body ?caster/body) (let aim ?caster/aim) (let eye-y ?caster/eye-y)
     (let creative? ?caster/creative?)
     (combat/blink-preview owner-id body aim eye-y :left $blink-distance $blink-cp creative? :update)]
    :movement/left-release
    [(let owner-id ?caster/id) (let body ?caster/body) (let aim ?caster/aim) (let eye-y ?caster/eye-y)
     (let wid ?world/id) (let creative? ?caster/creative?) (let blink-progression ?progression/blink)
     (combat/blink-release owner-id body aim eye-y wid :left $blink-distance $blink-cp $blink-overload
                           creative? $post-blink-fall-protect-ticks blink-progression)]

    :movement/forward-press
    [(let owner-id ?caster/id) (let body ?caster/body) (let aim ?caster/aim) (let eye-y ?caster/eye-y)
     (let creative? ?caster/creative?)
     (combat/blink-preview owner-id body aim eye-y :forward $blink-distance $blink-cp creative? :spawn)]
    :movement/forward-tick
    [(let owner-id ?caster/id) (let body ?caster/body) (let aim ?caster/aim) (let eye-y ?caster/eye-y)
     (let creative? ?caster/creative?)
     (combat/blink-preview owner-id body aim eye-y :forward $blink-distance $blink-cp creative? :update)]
    :movement/forward-release
    [(let owner-id ?caster/id) (let body ?caster/body) (let aim ?caster/aim) (let eye-y ?caster/eye-y)
     (let wid ?world/id) (let creative? ?caster/creative?) (let blink-progression ?progression/blink)
     (combat/blink-release owner-id body aim eye-y wid :forward $blink-distance $blink-cp $blink-overload
                           creative? $post-blink-fall-protect-ticks blink-progression)]}}"
 :invariants nil
 :mark-policies nil}

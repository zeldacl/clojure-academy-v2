;; New-DSL conversion of ac/combat/abilities/mine_ray.edn (S6). Session
;; continuous block-mining beam: each :pulse raycasts the first block
;; along the aim line and either keeps chewing through the session's
;; already-targeted block (matching position) or re-evaluates a new
;; target, clearing session state back to Float.MAX_VALUE sentinels
;; (3.4028235E38, kept verbatim) whenever there is nothing minable.
;;
;; :ability/destroy-blocks? is a NEW fixed capability (added to
;; combat-core/run.clj's fixed-capabilities, :boolean) -- a server-side
;; region/permission gate read directly off :input :capabilities in the
;; old content (not through ability/caster's bind), unlike every prior
;; capability this session's conversions have needed, all of which were
;; either fixed repo-wide already or a per-ability-named family
;; (?budget/*, ?cooldown/*). This is the first real content reading it.
;;
;; The 3-statement "clear target" block (state! target nil, reset both
;; hardness fields to the sentinel) appears three times in the old
;; content's :pulse (no active blocks in range; active block doesn't
;; match session target and isn't newly minable; block just broke) --
;; kept duplicated rather than factored into a shared :defn, the same
;; choice already established for this session's other same-ability
;; repeated blocks (thunder_bolt.edn, shift_teleport.edn, light_shield.edn).
{:schema-version 2
 :kind :ability
 :id :mine-ray
 :revision 2
 :activation :session
 :requires [:caster/body :caster/eye :caster/aim :caster/id :caster/creative?
            :ability/destroy-blocks? :world/id :progression/mastery :rng/seed]
 :prerequisites [{:skill-id :meltdowner :min-exp 0.3}]
 :tunables {:targeting-range {:curve :const}
            :break-speed {:curve :mastery-lerp}
            :cost-down-overload {:curve :mastery-lerp}
            :cost-tick-cp {:curve :mastery-lerp}
            :cooldown-ticks {:curve :mastery-lerp :type :int}
            :exp-block {:curve :const}}
 :costs {:activate {:resources {:overload {:ref [:input :tunables :cost-down-overload]}}}
         :tick {:resources {:cp {:ref [:input :tunables :cost-tick-cp]}}}}
 :cooldown {:main {:ticks {:ref [:input :tunables :cooldown-ticks]}}}
 :progression {:block {:per-mark {:ref [:input :tunables :exp-block]}}}
 :session-state {:target {:type :any :default nil}
                 :hardness-left {:type :float :default nil}
                 :starting-hardness {:type :float :default nil}
                 :overload-floor {:type :float :default nil}}
 :program
 "{:ability :mine-ray
   :activation :session
   :state {:target {:type :any :default nil} :hardness-left {:type :double :default nil}
           :starting-hardness {:type :double :default nil}
           :overload-floor {:type :double :default nil}}
   :tunables {:cost-down-overload {:type :double} :targeting-range {:type :double}
              :break-speed {:type :double}}
   :phases
   {:start
    [(let eye ?caster/eye)
     (let aim ?caster/aim)
     (let body ?caster/body)
     (let activate-budget ?budget/activate)
     (let cost-down-overload $cost-down-overload)
     (let context-resources ?context/resources)
     (let runtime ?context/ability-runtime)
     (let sufficient? (cost/spend {:budget activate-budget}))
     (if sufficient?
       [(state! :target nil)
        (state! :hardness-left 3.4028235E38)
        (state! :starting-hardness 3.4028235E38)
        (let overload-floor (math/sub (:overload context-resources) cost-down-overload))
        (state! :overload-floor overload-floor)
        (let beam-end (vec3/add eye (vec3/scale aim 15.0)))
        (vfx! {:effect-id :beam-session :operation :spawn :instance-key [:activation :beam]
              :audience {:type :nearby :radius 32.0}
              :payload {:start eye :end beam-end :life-ticks 4096 :grow-ticks 0
                       :style (:beam-style runtime) :bounds-radius 0.6}})
        (vfx! {:effect-id :block-progress-session :operation :spawn
              :instance-key [:activation :progress] :audience {:type :nearby :radius 32.0}
              :payload {:target nil :progress 0.0 :color (:progress-color runtime)
                       :pulse-period 0.3}})
        (vfx! {:effect-id :audio-loop-session :operation :spawn :instance-key [:activation :loop]
              :audience {:type :nearby :radius 32.0}
              :payload {:position body :sound-id (:loop-sound-id runtime) :volume 0.3
                       :pitch 1.0}})
        (vfx! {:effect-id :audio-one-shot :operation :spawn :audience {:type :nearby :radius 32.0}
              :payload {:position body :sound-id (:startup-sound-id runtime) :volume 0.4
                       :pitch 1.0}})
        (finish {:outcome :started})]
       [(finish {:outcome :insufficient-resource :end-ability? true})])]

    :pulse
    [(let eye ?caster/eye)
     (let aim ?caster/aim)
     (let body ?caster/body)
     (let runtime ?context/ability-runtime)
     (let targeting-range $targeting-range)
     (let break-speed $break-speed)
     (let overload-floor %overload-floor)
     (resource/enforce-floor {:resource :overload :minimum overload-floor})
     (let tick-budget ?budget/tick)
     (let sufficient? (cost/spend {:budget tick-budget}))
     (if (bool/not sufficient?)
       [(vfx! {:effect-id :beam-session :operation :destroy :instance-key [:activation :beam]
              :payload {:fade-ticks 0}})
        (vfx! {:effect-id :block-progress-session :operation :destroy
              :instance-key [:activation :progress] :payload {:fade-ticks 0}})
        (vfx! {:effect-id :audio-loop-session :operation :destroy :instance-key [:activation :loop]
              :payload {:fade-ticks 0}})
        (let main-cooldown ?cooldown/main)
        (cooldown/start {:name :main :ticks main-cooldown})
        (finish {:outcome :insufficient-resource :end-ability? true})]
       [(vfx! {:effect-id :beam-session :operation :update :instance-key [:activation :beam]
              :payload {:start eye :end (vec3/add eye (vec3/scale aim 15.0)) :life-ticks 4096
                       :grow-ticks 0 :style (:beam-style runtime) :bounds-radius 0.6}})
        (vfx! {:effect-id :audio-loop-session :operation :update :instance-key [:activation :loop]
              :payload {:position body}})
        (let blocks (target/blocks {:shape {:type :line :start eye :direction aim
                                            :length targeting-range :step 0.5}
                                    :projection [:position :hardness :block-id :breakable?
                                                :requires-high-tier-tool?]
                                    :limit 1}))
        (let block (collection/first blocks))
        (let session-target %target)
        (if (collection/nonempty blocks)
          [(let destroy-blocks? ?ability/destroy-blocks?)
           (let matches-target? (value/eq (:position block) session-target))
           (if (bool/and destroy-blocks? matches-target?)
             [(let hardness-left %hardness-left)
              (let starting-hardness %starting-hardness)
              (let new-hardness (math/sub hardness-left break-speed))
              (let progress (math/clamp (math/sub 1.0 (math/div new-hardness starting-hardness))
                                       0.0 1.0))
              (vfx! {:effect-id :block-progress-session :operation :update
                    :instance-key [:activation :progress]
                    :payload {:target (:position block) :progress progress
                             :color (:progress-color runtime) :pulse-period 0.3}})
              (vfx! {:effect-id :particle-burst :operation :spawn
                    :instance-key [:activation :particle] :audience {:type :nearby :radius 32.0}
                    :payload {:position (vec3/add (:position block) [0.5 0.5 0.5])
                             :rate-per-tick 3 :limit 3 :particle (:particle runtime)}})
              (if (math/lte new-hardness 0.0)
                [(let break-status
                   (block/break {:position (:position block) :expected-block-id (:block-id block)
                                :drop? true :fortune-level (:fortune-level runtime)
                                :tool-tier-capped? (:tool-tier-capped? runtime) :barrier? true}))
                 (if (value/eq break-status :applied)
                   [(let block-progression ?progression/block)
                    (event! {:type :score/mark :progression block-progression})
                    (state! :target nil)
                    (state! :hardness-left 3.4028235E38)
                    (state! :starting-hardness 3.4028235E38)]
                   [(state! :target nil)
                    (state! :hardness-left 3.4028235E38)
                    (state! :starting-hardness 3.4028235E38)])]
                [(state! :hardness-left new-hardness)])]
             [(if (bool/and destroy-blocks?
                           (bool/and (:breakable? block)
                                    (bool/not (bool/and (:tool-tier-capped? runtime)
                                                       (:requires-high-tier-tool? block)))))
                [(state! :target (:position block))
                 (let init-hardness
                   (math/select (math/lt (:hardness block) 0.0) 3.4028235E38 (:hardness block)))
                 (state! :hardness-left init-hardness)
                 (state! :starting-hardness init-hardness)]
                [(state! :target nil)
                 (state! :hardness-left 3.4028235E38)
                 (state! :starting-hardness 3.4028235E38)])])]
          [(state! :target nil)
           (state! :hardness-left 3.4028235E38)
           (state! :starting-hardness 3.4028235E38)])
        (finish {:outcome :continue})])]

    :release
    [(vfx! {:effect-id :beam-session :operation :destroy :instance-key [:activation :beam]
           :payload {:fade-ticks 0}})
     (vfx! {:effect-id :block-progress-session :operation :destroy
           :instance-key [:activation :progress] :payload {:fade-ticks 0}})
     (vfx! {:effect-id :audio-loop-session :operation :destroy :instance-key [:activation :loop]
           :payload {:fade-ticks 0}})
     (let main-cooldown ?cooldown/main)
     (cooldown/start {:name :main :ticks main-cooldown})
     (finish {:outcome :released :end-ability? true})]

    :abort
    [(vfx! {:effect-id :beam-session :operation :destroy :instance-key [:activation :beam]
           :payload {:fade-ticks 0}})
     (vfx! {:effect-id :block-progress-session :operation :destroy
           :instance-key [:activation :progress] :payload {:fade-ticks 0}})
     (vfx! {:effect-id :audio-loop-session :operation :destroy :instance-key [:activation :loop]
           :payload {:fade-ticks 0}})
     (let main-cooldown ?cooldown/main)
     (cooldown/start {:name :main :ticks main-cooldown})
     (finish {:outcome :aborted :end-ability? true})]}}"
 :invariants nil
 :mark-policies nil}

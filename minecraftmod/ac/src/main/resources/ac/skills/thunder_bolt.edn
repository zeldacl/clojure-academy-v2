{:doc ["New-DSL conversion of ac/combat/abilities/thunder_bolt.edn (S6). See"
        "earlier skills/*.edn docstrings for the general pattern. Nothing new at"
        "the language level -- every op/node used here was already added"
        "converting rad_intensify/electron_bomb/arc_gen/ray_barrage."
        ""
        "One old-content oddity resolved by simply following this session's"
        "established precedent: the old {:component :cooldown/start, :name"
        ":main} step has no :cooldown field at all (unlike every other"
        "cooldown/start call site converted so far, which explicitly reads"
        "?cooldown/main). cn.li.combat.dsl-vocabulary's :cooldown/start requires"
        ":ticks with no default, so this was never ambiguous in the new DSL --"
        ":ticks is read from ?cooldown/main like everywhere else."]
 :schema-version 2
 :kind :ability
 :id :thunder-bolt
 :name-key "ability.skill.electromaster.thunder_bolt"
 :description-key "ability.skill.electromaster.thunder_bolt.desc"
 :revision 1
 :activation :instant
 :requires [:caster/id :caster/eye :caster/aim :world/id :rng/seed]
 :prerequisites [{:skill-id :arc-gen :min-exp 0.0} {:skill-id :current-charging :min-exp 0.7}]
 :tunables {:targeting-range {:curve :const}
            :direct-damage {:curve :mastery-lerp}
            :aoe-radius {:curve :const}
            :aoe-damage {:curve :mastery-lerp}
            :slowness-chance {:curve :const}
            :slowness-exp-threshold {:curve :const}
            :slowness-duration-ticks {:curve :const :type :int}
            :slowness-aoe-retry-duration-ticks {:curve :const :type :int}
            :slowness-amplifier {:curve :const :type :int}
            :creeper-charge-chance {:curve :const}
            :cost-down-cp {:curve :mastery-lerp}
            :cost-down-overload {:curve :mastery-lerp}
            :cooldown-ticks {:curve :mastery-lerp :type :int}
            :exp-effective {:curve :const}
            :exp-ineffective {:curve :const}}
 :costs {:fire {:resources {:cp {:ref [:input :tunables :cost-down-cp]}
                            :overload {:ref [:input :tunables :cost-down-overload]}}}}
 :cooldown {:main {:ticks {:ref [:input :tunables :cooldown-ticks]}}}
 :progression {:effective {:per-mark {:ref [:input :tunables :exp-effective]}}
               :ineffective {:per-mark {:ref [:input :tunables :exp-ineffective]}}}
 :program
 "{:ability :thunder-bolt
   :activation :instant
   :tunables {:targeting-range {:type :double} :direct-damage {:type :double}
              :aoe-radius {:type :double} :aoe-damage {:type :double}
              :slowness-chance {:type :double} :slowness-exp-threshold {:type :double}
              :slowness-duration-ticks {:type :long}
              :slowness-aoe-retry-duration-ticks {:type :long}
              :slowness-amplifier {:type :long} :creeper-charge-chance {:type :double}}
   :do
   [(let fire-budget ?budget/fire)
    (let sufficient? (cost/spend {:budget fire-budget}))
    (if sufficient?
      [(let eye ?caster/eye)
       (let aim ?caster/aim)
       (let caster-id ?caster/id)
       (let wid ?world/id)
       (let mastery ?progression/mastery)
       (let aim-hit (target/raycast {:origin eye :direction aim :distance $targeting-range
                                     :include-entities? true :include-blocks? true
                                     :living-only? true}))
       (let main-end (vec3/add eye (vec3/scale aim $targeting-range)))
       (let aim-entity-id (:entity-id aim-hit))
       (let direct-radius (math/select aim-entity-id 1.5 0.0))
       (let direct-targets
         (target/entities {:shape {:type :sphere :center (:position aim-hit) :radius direct-radius}
                           :filter {:living? true :entity-ids [aim-entity-id]} :limit 1}))
       (let direct-target (collection/first direct-targets))
       (let aoe-targets
         (target/entities {:shape {:type :sphere :center (:position aim-hit) :radius $aoe-radius}
                           :filter {:living? true :excluded-entity-ids [caster-id aim-entity-id]}
                           :limit 256}))
       (let direct-target-id (:id direct-target))
       (when direct-target-id
         (combat/damage {:target direct-target-id :amount $direct-damage :damage-type :skill
                         :damage-pipeline :skill})
         (let aim-entity-type (:entity-type aim-hit))
         (let is-creeper?
           (bool/or (value/eq aim-entity-type \"minecraft:creeper\")
                    (value/eq aim-entity-type \"entity.minecraft.creeper\")))
         (when is-creeper?
           (let charged? (random/chance {:probability $creeper-charge-chance}))
           (when charged?
             (combat/status {:target direct-target-id :status-id :powered-creeper
                             :duration-ticks 1 :amplifier 0})))
         (let mastery-ok? (math/gt mastery $slowness-exp-threshold))
         (when mastery-ok?
           (let slow-roll? (random/chance {:probability $slowness-chance}))
           (when slow-roll?
             (combat/status {:target direct-target-id :status-id :slowness
                             :duration-ticks $slowness-duration-ticks
                             :amplifier $slowness-amplifier})))
         (event! {:type :achievement/trigger :payload {:id \"electromaster.thunder_bolt\"}}))
       (each target aoe-targets
         (let target-id (:id target))
         (combat/damage {:target target-id :amount $aoe-damage :damage-type :skill
                         :damage-pipeline :skill})
         (let target-type (:type target))
         (let target-is-creeper?
           (bool/or (value/eq target-type \"minecraft:creeper\")
                    (value/eq target-type \"entity.minecraft.creeper\")))
         (when target-is-creeper?
           (let charged2? (random/chance {:probability $creeper-charge-chance}))
           (when charged2?
             (combat/status {:target target-id :status-id :powered-creeper
                             :duration-ticks 1 :amplifier 0})))
         (when direct-target-id
           (let mastery-ok2? (math/gt mastery $slowness-exp-threshold))
           (when mastery-ok2?
             (let slow-roll2? (random/chance {:probability $slowness-chance}))
             (when slow-roll2?
               (combat/status {:target direct-target-id :status-id :slowness
                               :duration-ticks $slowness-aoe-retry-duration-ticks
                               :amplifier $slowness-amplifier})))))
       (world/lightning {:world-id wid :position (:position aim-hit) :visual-only? true})
       (vfx! {:effect-id :arc-strike-transient :operation :spawn :instance-key [:activation :strike]
             :audience {:type :nearby :radius 64.0}
             :payload {:hand-origin? true :sound-position eye :sound-pitch 1.0 :sound-volume 0.6
                      :start eye :sound-id \"academy:em.arc_strong\" :arc-life-ticks 20
                      :aoe-points aoe-targets :aoe-origin (:position aim-hit) :end main-end
                      :bounds-radius 2.0 :pattern :strong}})
       (let effective? (bool/or direct-target-id (collection/nonempty aoe-targets)))
       (if effective?
         [(let effective-progression ?progression/effective)
          (event! {:type :score/mark :tag :effective :progression effective-progression})]
         [(let ineffective-progression ?progression/ineffective)
          (event! {:type :score/mark :tag :ineffective :progression ineffective-progression})])
       (let main-cooldown ?cooldown/main)
       (cooldown/start {:name :main :ticks main-cooldown})
       (finish {:outcome :performed :end-ability? true})]
      [(finish {:outcome :insufficient-resource})])]}"
 :invariants nil
 :mark-policies nil}

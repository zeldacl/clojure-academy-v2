{:doc ["New-DSL conversion of ac/combat/abilities/jet_engine.edn (S6). Two-"
        "phase session ability driven by its own :phase session-state field"
        "(:marking -> :triggering), not the run engine's :next-phase"
        "mechanism -- :pulse internally branches on %phase itself, and"
        ":release's phase-advancing finish carries no :end-ability?/:next-phase"
        "at all (a genuine :continue-shaped outcome, matching every other"
        "converted ability's own :continue finishes)."
        ""
        ":marking holds a raycast-tracked mark point open as long as CP holds"
        "out; :release converts the held position into a velocity (target -"
        "start, scaled by 1/8) and switches to :triggering, where each :pulse"
        "advances the caster along that velocity in 1/8-length segments,"
        "raycasting each segment for an entity hit to damage + radiation-mark,"
        "for 15 ticks before finishing."
        ""
        ":pulse's triggering branch dropped an owner/snapshot read"
        "(old :bind {:snapshot :owner-now}): grep against the old file shows"
        ":owner-now appears exactly once, its own binding -- genuinely dead,"
        "the same class already established for mark_teleport.edn's dead"
        "trailing finish and shift_teleport.edn's dead :mode re-read."]
 :schema-version 2
 :kind :ability
 :id :jet-engine
 :name-key "ability.skill.meltdowner.jet_engine"
 :description-key "ability.skill.meltdowner.jet_engine.desc"
 :revision 2
 :activation :session
 :requires [:caster/id :caster/body :caster/eye :caster/aim :caster/creative? :world/id
            :progression/mastery :rng/seed]
 :prerequisites [{:skill-id :meltdowner :min-exp 1.0}]
 :tunables {:target-range {:curve :const}
            :damage {:curve :mastery-lerp}
            :hold-required-cp {:curve :mastery-lerp}
            :release-cp {:curve :mastery-lerp}
            :release-overload {:curve :mastery-lerp}
            :cooldown-ticks {:curve :mastery-lerp}
            :progression-exp-use {:curve :const}}
 :costs {:release {:resources {:cp {:ref [:input :tunables :release-cp]}
                               :overload {:ref [:input :tunables :release-overload]}}}}
 :cooldown {:main {:ticks {:ref [:input :tunables :cooldown-ticks]}}}
 :progression {:use {:per-mark {:ref [:input :tunables :progression-exp-use]}}}
 :session-state {:phase {:type :resource-id :default :marking}
                 :hold-ticks {:type :int :default 0}
                 :target-position {:type :vec3 :default nil}
                 :start-position {:type :vec3 :default nil}
                 :last-position {:type :vec3 :default nil}
                 :velocity {:type :vec3 :default nil}
                 :trigger-ticks {:type :int :default 0}}
 :program
 "{:ability :jet-engine
   :activation :session
   :state {:phase {:type :keyword :default :marking} :hold-ticks {:type :long :default 0}
           :target-position {:type :vec3 :default nil} :start-position {:type :vec3 :default nil}
           :last-position {:type :vec3 :default nil} :velocity {:type :vec3 :default nil}
           :trigger-ticks {:type :long :default 0}}
   :tunables {:target-range {:type :double} :hold-required-cp {:type :double}
              :damage {:type :double}}
   :phases
   {:start
    [(let eye ?caster/eye)
     (let aim ?caster/aim)
     (let target-range $target-range)
     (let aim-hit (target/raycast {:origin eye :direction aim :distance target-range
                                   :include-entities? false :include-blocks? true}))
     (let target-position (:position aim-hit))
     (state! :phase :marking)
     (state! :hold-ticks 0)
     (state! :target-position target-position)
     (vfx! {:effect-id :ring-particle-field :operation :spawn
           :instance-key [:activation :jet-engine-mark] :audience {:type :owner}
           :payload {:position target-position :ring-from 1.9 :ring-to 1.4 :segments 24
                    :ring-color [51 255 51 179] :rate-per-tick 1 :limit 128
                    :particle {:material :additive :life-ticks 12 :speed 0.08
                              :color [51 255 51 179]}}})
     (finish {:outcome :started})]

    :pulse
    [(let phase %phase)
     (if (value/eq phase :marking)
       [(let eye ?caster/eye)
        (let aim ?caster/aim)
        (let target-range $target-range)
        (let hold-required-cp $hold-required-cp)
        (let aim-hit (target/raycast {:origin eye :direction aim :distance target-range
                                      :include-entities? false :include-blocks? true}))
        (let target-position (:position aim-hit))
        (let context-resources ?context/resources)
        (if (math/gte (:cp context-resources) hold-required-cp)
          [(let hold-ticks-cur %hold-ticks)
           (let hold-ticks-next (long/add hold-ticks-cur 1))
           (state! :hold-ticks hold-ticks-next)
           (state! :target-position target-position)
           (vfx! {:effect-id :ring-particle-field :operation :update
                 :instance-key [:activation :jet-engine-mark] :payload {:position target-position}})
           (finish {:outcome :continue})]
          [(vfx! {:effect-id :ring-particle-field :operation :destroy
                 :instance-key [:activation :jet-engine-mark] :payload {}})
           (finish {:outcome :insufficient-resource :end-ability? true})])]
       [(let trigger-ticks-check %trigger-ticks)
        (if (math/gte trigger-ticks-check 15)
          [(vfx! {:effect-id :arc-channel-session :operation :destroy
                 :instance-key [:activation :jet-engine-trail] :payload {:fade-ticks 0}})
           (vfx! {:effect-id :particle-session :operation :destroy
                 :instance-key [:activation :jet-engine-particles] :payload {}})
           (vfx! {:effect-id :billboard-session :operation :destroy
                 :instance-key [:activation :jet-engine-shield] :payload {}})
           (vfx! {:effect-id :ring-particle-field :operation :destroy
                 :instance-key [:activation :jet-engine-impact] :payload {}})
           (vfx! {:effect-id :screen-flash-session :operation :destroy
                 :instance-key [:activation :jet-engine-flash] :payload {}})
           (finish {:outcome :completed :end-ability? true})]
          [(let owner-id ?caster/id)
           (let damage $damage)
           (let start-position %start-position)
           (let velocity %velocity)
           (let trigger-ticks %trigger-ticks)
           (let last-position %last-position)
           (let next-position
             (vec3/add start-position
                      (vec3/scale velocity (math/div (math/add trigger-ticks 1) 8.0))))
           (let segment (vec3/sub next-position last-position))
           (let segment-distance (vec3/length segment))
           (let segment-direction (vec3/normalize segment))
           (motion/velocity {:velocity velocity :dismount? true :reset-fall-damage? true})
           (let segment-hit
             (target/raycast {:origin last-position :direction segment-direction
                              :distance (math/max 1.0E-5 segment-distance)
                              :include-entities? true :include-blocks? false}))
           (when (bool/and (value/eq (:hit-type segment-hit) :entity)
                           (bool/not (value/eq (:entity-id segment-hit) owner-id)))
             (combat/damage {:target (:entity-id segment-hit) :amount damage :damage-type :magic})
             (entity/mark {:target (:entity-id segment-hit) :mark-type :radiation
                          :duration-ticks 60.0 :requires-ability :rad-intensify}))
           (let trigger-ticks-next (long/add trigger-ticks 1))
           (state! :trigger-ticks trigger-ticks-next)
           (state! :last-position next-position)
           (vfx! {:effect-id :arc-channel-session :operation :update
                 :instance-key [:activation :jet-engine-trail]
                 :payload {:block-bounds nil :charge-ticks trigger-ticks :mode :jet-engine-trigger
                          :style {:beam {:pattern :thin-continuous :wiggle 0.35 :life-ratio 0.5
                                        :width 0.08 :color [185 245 255 220]}}
                          :good? true :target next-position :caster start-position
                          :block-pos nil :visual-max-ticks 20}})
           (vfx! {:effect-id :particle-session :operation :update
                 :instance-key [:activation :jet-engine-particles]
                 :payload {:position next-position}})
           (vfx! {:effect-id :billboard-session :operation :update
                 :instance-key [:activation :jet-engine-shield] :payload {:anchor next-position}})
           (vfx! {:effect-id :screen-flash-session :operation :update
                 :instance-key [:activation :jet-engine-flash]
                 :payload {:alpha (math/mul 85.0
                                            (math/clamp (math/div (math/sub 20.0 trigger-ticks) 20.0)
                                                       0.0 1.0))}})
           (finish {:outcome :continue})])])]

    :release
    [(let phase %phase)
     (if (value/eq phase :marking)
       [(let release-budget ?budget/release)
        (let sufficient? (cost/spend {:budget release-budget}))
        (if sufficient?
          [(let owner-start (owner/snapshot {:projection [:position]}))
           (let target-position %target-position)
           (let velocity
             (vec3/scale (vec3/sub target-position (:position owner-start)) (math/div 1.0 8.0)))
           (state! :phase :triggering)
           (state! :start-position (:position owner-start))
           (state! :last-position (:position owner-start))
           (state! :velocity velocity)
           (state! :trigger-ticks 0)
           (vfx! {:effect-id :ring-particle-field :operation :destroy
                 :instance-key [:activation :jet-engine-mark] :payload {}})
           (vfx! {:effect-id :arc-channel-session :operation :spawn
                 :instance-key [:activation :jet-engine-trail] :audience {:type :nearby :radius 64.0}
                 :payload {:block-bounds nil :charge-ticks 0 :mode :jet-engine-trigger
                          :style {:beam {:pattern :thin-continuous :wiggle 0.35 :life-ratio 0.5
                                        :width 0.08 :color [185 245 255 220]}}
                          :good? true :target target-position :caster (:position owner-start)
                          :block-pos nil :visual-max-ticks 20}})
           (vfx! {:effect-id :particle-session :operation :spawn
                 :instance-key [:activation :jet-engine-particles]
                 :audience {:type :nearby :radius 64.0}
                 :payload {:position (:position owner-start) :rate-per-tick 11 :limit 256
                          :particle {:material :additive
                                    :texture \"academy:textures/effects/md_particle.png\"
                                    :life-ticks 10 :speed 1.0 :spread {:x 0.3 :y 0.3 :z 0.3}
                                    :velocity {:x 0.02 :y 0.02 :z 0.02}}}})
           (vfx! {:effect-id :billboard-session :operation :spawn
                 :instance-key [:activation :jet-engine-shield]
                 :audience {:type :nearby :radius 64.0}
                 :payload {:anchor (:position owner-start) :duration-ticks 20
                          :texture-pattern \"academy:textures/effects/diamond_shield.png\"
                          :frame-count 1 :frame-duration-ms 1000 :half-size 1.0}})
           (vfx! {:effect-id :ring-particle-field :operation :spawn
                 :instance-key [:activation :jet-engine-impact]
                 :audience {:type :nearby :radius 64.0}
                 :payload {:position target-position :ring-from 0.4 :ring-to 0.58 :segments 24
                          :ring-color [210 250 255 180] :rate-per-tick 4 :limit 256
                          :particle {:material :additive :life-ticks 12 :speed 0.08
                                    :color [214 248 255 200]}}})
           (vfx! {:effect-id :screen-flash-session :operation :spawn
                 :instance-key [:activation :jet-engine-flash] :audience {:type :owner}
                 :payload {:alpha 85.0 :duration-ticks 20 :color [210 250 255 255]}})
           (let use-progression ?progression/use)
           (let main-cooldown ?cooldown/main)
           (event! {:type :score/mark :progression use-progression})
           (cooldown/start {:name :main :ticks main-cooldown})
           (finish {:outcome :triggering})]
          [(vfx! {:effect-id :ring-particle-field :operation :destroy
                 :instance-key [:activation :jet-engine-mark] :payload {}})
           (finish {:outcome :insufficient-resource :end-ability? true})])]
       [(finish {:outcome :ignored})])]

    :abort
    [(let phase %phase)
     (if (value/eq phase :triggering)
       [(vfx! {:effect-id :arc-channel-session :operation :destroy
              :instance-key [:activation :jet-engine-trail] :payload {:fade-ticks 0}})
        (vfx! {:effect-id :particle-session :operation :destroy
              :instance-key [:activation :jet-engine-particles] :payload {}})
        (vfx! {:effect-id :billboard-session :operation :destroy
              :instance-key [:activation :jet-engine-shield] :payload {}})
        (vfx! {:effect-id :ring-particle-field :operation :destroy
              :instance-key [:activation :jet-engine-impact] :payload {}})
        (vfx! {:effect-id :screen-flash-session :operation :destroy
              :instance-key [:activation :jet-engine-flash] :payload {}})
        (finish {:outcome :aborted :end-ability? true})]
       [(vfx! {:effect-id :ring-particle-field :operation :destroy
              :instance-key [:activation :jet-engine-mark] :payload {}})
        (finish {:outcome :aborted :end-ability? true})])]}}"
 :invariants nil
 :mark-policies nil}

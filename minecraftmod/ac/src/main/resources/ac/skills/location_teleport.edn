;; New-DSL conversion of ac/combat/abilities/location_teleport.edn (S6).
;; See rad_intensify.edn/electron_bomb.edn/mine_detect.edn's docstrings for
;; the general pattern. New here: a truthy (not strictly :boolean) branch
;; condition (destination, :any-typed, nil when not found -- the emitter's
;; :branch op is a bare Clojure `if` on the raw value, so nil/false-y
;; still works exactly like a real boolean, no gap), a dynamically-built
;; (not pre-resolved) cost/spend budget descriptor, and the first real
;; call-site of cn.li.combat.lib's own combat/teleport-group composite.
;;
;; :ability/context folds into the ?context/name sigil (:context/
;; location-name here), per cn.li.combat.dsl-vocabulary's own docstring.
{:schema-version 2
 :kind :ability
 :id :location-teleport
 :name-key "ability.skill.teleporter.location_teleport"
 :description-key "ability.skill.teleporter.location_teleport.desc"
 :revision 3
 :activation :instant
 :requires [:caster/id :world/id :caster/creative? :rng/seed :progression/mastery]
 :tunables {:cross-dimension-exp-threshold {:curve :const}
            :teleport-radius {:curve :const}
            :cp-base {:curve :pair}
            :overload {:curve :const}
            :cross-dimension-multiplier {:curve :const}
            :min-distance-multiplier {:curve :const}
            :distance-cap {:curve :const}
            :cooldown-ticks {:curve :pair :type :float}
            :int-distance-threshold {:curve :const}
            :exp-short {:curve :const}
            :exp-long {:curve :const}}
 :program
 "{:ability :location-teleport
   :activation :instant
   :tunables {:cross-dimension-exp-threshold {:type :double} :teleport-radius {:type :double}
              :cp-base {:type :any} :overload {:type :double}
              :cross-dimension-multiplier {:type :double} :min-distance-multiplier {:type :double}
              :distance-cap {:type :double} :cooldown-ticks {:type :any}
              :int-distance-threshold {:type :double} :exp-short {:type :double}
              :exp-long {:type :double}}
   :do
   [(let mastery ?progression/mastery)
    (let location-name ?context/location-name)
    (let owner (owner/snapshot {:projection [:position]}))
    (let destination (target/saved-location {:location-name location-name}))
    (if destination
      [(let source-position (:position owner))
       (let distance (vec3/distance source-position destination))
       (let cross-dimension?
         (bool/not (value/eq (:world-id source-position) (:world-id destination))))
       (let cp-distance-multiplier
         (math/max $min-distance-multiplier (math/sqrt (math/min $distance-cap distance))))
       (let cp-cost
         (math/mul (math/mul (math/lerp (pair/first $cp-base) (pair/second $cp-base) mastery)
                             (math/select cross-dimension? $cross-dimension-multiplier 1.0))
                   cp-distance-multiplier))
       (let dimension-ok?
         (bool/or (bool/not cross-dimension?) (math/gt mastery $cross-dimension-exp-threshold)))
       (if dimension-ok?
         [(let sufficient? (cost/spend {:budget {:cp cp-cost :overload $overload}}))
          (if sufficient?
            [(combat/teleport-group destination $teleport-radius 128)
             (let mark-exp (math/select (math/gte distance $int-distance-threshold)
                                        $exp-long $exp-short))
             (event! {:type :score/mark :progression mark-exp})
             (let cooldown-ticks-next
               (math/floor-long (math/lerp (pair/first $cooldown-ticks) (pair/second $cooldown-ticks)
                                           mastery)))
             (cooldown/start {:name :main :ticks cooldown-ticks-next})
             (when cross-dimension?
               (event! {:type :achievement/trigger :payload {:id \"teleporter.ignore_barrier\"}}))
             (vfx! {:effect-id :audio-one-shot :operation :spawn
                   :audience {:type :nearby :radius 64.0}
                   :payload {:position destination :sound-id \"academy:tp.tp\" :volume 0.5
                            :pitch 1.0}})
             (finish {:outcome :teleported})]
            [(finish {:outcome :insufficient-resource})])]
         [(finish {:outcome :cross-dimension-exp-required})])]
      [(finish {:outcome :location-not-found})])]}"
 :costs nil
 :cooldown nil
 :progression nil
 :invariants nil
 :mark-policies nil}

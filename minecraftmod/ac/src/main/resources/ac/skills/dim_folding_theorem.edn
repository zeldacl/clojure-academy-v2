;; New-DSL conversion of ac/combat/abilities/dim_folding_theorem.edn (S6).
;; Same shape as rad_intensify.edn's own conversion (see that file's
;; docstring for the general pattern): only :program moves to new-DSL text;
;; :damage-policies stays verbatim, still consumed by cn.li.combat.damage's
;; :ref/:expr interpreter, not this ability's own :do/:phases body. Passive,
;; no :do logic of its own -- real behavior lives entirely in
;; :damage-policies (a chance-based critical-hit multiplier).
{:schema-version 2
 :kind :ability
 :id :dim-folding-theorem
 :revision 2
 :activation :passive
 :requires [:world/id :rng/seed]
 :prerequisites [{:skill-id :threatening-teleport :min-exp 0.2}]
 :tunables {:damage-multipliers {:curve :pair}
            :level0-probability {:curve :mastery-lerp}
            :exp-per-crit-level {:curve :const}}
 :program
 "{:ability :dim-folding-theorem
   :activation :passive
   :tunables {:damage-multipliers {:type :any} :level0-probability {:type :double}
              :exp-per-crit-level {:type :double}}
   :phases {:start [(finish {:outcome :passive})]
            :pulse [(finish {:outcome :passive})]
            :release [(finish {:outcome :passive})]
            :abort [(finish {:outcome :passive})]}}"
 :damage-policies
 [{:on :combat/damage
   :priority 200
   :when {:expr :bool/and
          :args [{:ref [:input :context :source-learned?]}
                 {:expr :bool/not :args [{:ref [:input :context :reflected?]}]}
                 {:expr :math/gt :args [{:ref [:input :request :base]} 0.0]}]}
   :program {:component :damage/critical
             :levels [{:level 0 :probability {:ref [:input :tunables :level0-probability]}
                      :multiplier {:ref [:input :tunables :damage-multipliers 0]}}]
             :damage-types [:magic :skill]
             :progression-per-level {:ref [:input :tunables :exp-per-crit-level]}
             :vfx {:effect-id :particle-burst-trail-transient
                   :instance-key [:combat :critical]
                   :audience {:type :nearby :radius 64.0}
                   :payload {:count-limit 8 :life-ticks 15 :fade-out 20
                             :start {:ref [:input :context :target-position]}
                             :radius {:min 0.3 :max 0.42} :size {:min 1.0 :max 1.7}
                             :alpha {:min 152 :max 255}
                             :end {:ref [:input :context :target-position]}
                             :velocity {:min -0.03 :max 0.03}
                             :texture "academy:textures/effects/formula/0.png"
                             :spacing {:min 0.0 :max 0.0} :fade-in 2}}
             :feedback {:message-key "ability.teleporter.critical_hit"
                       :args [{:ref [:input :context :critical-multiplier]}] :translate? true}
             :events [{:type :achievement/trigger :payload {:id "teleporter.critical_attack"}}]}}]
 :costs nil
 :cooldown nil
 :progression nil
 :invariants nil
 :mark-policies nil}

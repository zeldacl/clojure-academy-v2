;; New-DSL conversion of ac/combat/abilities/plasma_cannon.edn (S6).
;; Session ability with an integer :mode state field (0 = charging,
;; 1 = flight) rather than a keyword phase -- ported as :long with
;; math/eq comparisons, matching the old content's own choice of raw
;; integers over resource-id/keyword.
;;
;; :start's cost/spend uses a literal {:resources {:resources {}}}
;; budget -- a doubly-nested EMPTY resources descriptor, clearly a
;; generated artifact (the auto-named local it binds to,
;; __txn_insufficient_-511703177, is not something a human would write)
;; rather than hand-authored content. Spending an empty resource set can
;; never fail, so its :then (insufficient-resource) branch is
;; functionally dead -- but ported verbatim rather than simplified away,
;; since there is no confirmed bug here (just a no-op gate), matching
;; this migration's standing rule to only deviate from old content for
;; CONFIRMED bugs with clear evidence, not merely unusual shapes.
;;
;; :start's ability/caster bind pulls a :seed field that has no
;; corresponding entry in this ability's own :requires list (:rng/seed
;; is absent) -- read here via ?rng/seed regardless, since :requires is
;; declarative metadata a different subsystem consumes, not something
;; the DSL compiler itself enforces; the top-level :requires array is
;; kept exactly as the old content had it (an oversight there, not
;; something this conversion's job is to correct).
;;
;; The impact branch's leading {:component :state/read :key :destination}
;; re-reads state already bound (identically) earlier in the same
;; :pulse, no intervening write -- dropped as a duplicate, the same
;; class of simplification already established (shift_teleport.edn).
;;
;; [0.0 dynamic-offset 0.0] (the spawn-y-offset vertical nudge) is not a
;; vec3 literal here (compile.clj's vec3-literal? requires every element
;; to already be a number at parse time) -- ported via
;; (vec3/scale [0.0 1.0 0.0] dynamic-offset), the same fix
;; directed_shock.edn's docstring already established.
{:schema-version 2
 :kind :ability
 :id :plasma-cannon
 :revision 1
 :activation :session
 :requires [:caster/eye :caster/body :caster/aim :caster/id :caster/creative? :world/id :charge/ticks]
 :tunables {:charge-time {:curve :mastery-lerp :type :int}
            :cost-tick-cp {:curve :mastery-lerp}
            :overload-keep {:curve :mastery-lerp}
            :targeting-distance {:curve :const}
            :block-hit-extra-distance {:curve :const}
            :max-flight-ticks {:curve :const :type :int}
            :damage {:curve :mastery-lerp}
            :damage-radius {:curve :const}
            :explosion-radius {:curve :mastery-lerp}
            :cooldown-ticks {:curve :mastery-lerp :type :int}
            :exp-use {:curve :const}
            :eye-height {:curve :const}
            :spawn-y-offset {:curve :const}
            :destination-epsilon {:curve :const}
            :sync-interval-ticks {:curve :const :type :int}
            :ground-search-distance {:curve :const}}
 :costs {:charging {:resources {:cp {:ref [:input :tunables :cost-tick-cp]}}}}
 :cooldown {:main {:ticks {:ref [:input :tunables :cooldown-ticks]}}}
 :progression {:fire {:per-mark {:ref [:input :tunables :exp-use]}}}
 :session-state {:mode {:type :int :default 0}
                 :position {:type :vec3 :default nil}
                 :vortex-base {:type :vec3 :default nil}
                 :destination {:type :any :default nil}
                 :flight-ticks {:type :int :default 0}
                 :sync-ticks {:type :int :default 0}
                 :overload-floor {:type :float :default 0.0}}
 :program
 "{:ability :plasma-cannon
   :activation :session
   :state {:mode {:type :long :default 0} :position {:type :vec3 :default nil}
           :vortex-base {:type :vec3 :default nil} :destination {:type :any :default nil}
           :flight-ticks {:type :long :default 0} :sync-ticks {:type :long :default 0}
           :overload-floor {:type :double :default 0.0}}
   :tunables {:spawn-y-offset {:type :double} :ground-search-distance {:type :double}
              :overload-keep {:type :double} :charge-time {:type :long}
              :block-hit-extra-distance {:type :double} :destination-epsilon {:type :double}
              :max-flight-ticks {:type :long} :sync-interval-ticks {:type :long}
              :damage-radius {:type :double} :damage {:type :double}
              :explosion-radius {:type :double} :targeting-distance {:type :double}
              :eye-height {:type :double}}
   :phases
   {:start
    [(let body ?caster/body)
     (let seed ?rng/seed)
     (let spawn-y-offset $spawn-y-offset)
     (let ground-search-distance $ground-search-distance)
     (let overload-keep $overload-keep)
     (let context-resources ?context/resources)
     (let overload-floor (math/max 0.0 (math/sub (:overload context-resources) overload-keep)))
     (let charge-position (vec3/add body (vec3/scale [0.0 1.0 0.0] spawn-y-offset)))
     (let ground-hit (target/raycast {:origin charge-position :direction [0.0 -1.0 0.0]
                                      :distance ground-search-distance :include-entities? false
                                      :include-blocks? true}))
     (let ground-destination
       (target/resolve-destination {:hit ground-hit :origin charge-position
                                    :direction [0.0 -1.0 0.0] :distance ground-search-distance
                                    :policy {:direction [0.0 -1.0 0.0] :minimum-distance 0.0}}))
     (let ground-base
       (math/select (:target-hit? ground-destination) (:hit-position ground-destination)
                    (:position ground-destination)))
     (let sufficient? (cost/spend {:budget {:resources {:resources {}}}}))
     (if sufficient?
       [(resource/add {:resource :overload :amount overload-keep})
        (state! :overload-floor overload-floor)
        (state! :mode 0)
        (state! :position charge-position)
        (state! :vortex-base ground-base)
        (state! :flight-ticks 0)
        (state! :sync-ticks 0)
        (vfx! {:effect-id :energy-orb-session :operation :spawn
              :instance-key [:activation :energy-orb] :audience {:type :nearby :radius 96.0}
              :payload {:limit 256 :segments 24 :radius 2.2
                       :particle {:material :additive :life-ticks 12 :speed 0.06
                                 :color [165 230 255 180]}
                       :inner-color [241 240 222 210] :core-color [165 230 255 230]
                       :outer-color [236 170 93 160] :rate-per-tick 12 :position charge-position}})
        (vfx! {:effect-id :vortex-column-session :operation :spawn
              :instance-key [:activation :vortex-column] :audience {:type :nearby :radius 96.0}
              :payload {:base (:position ground-hit) :axis [0.0 1.0 0.0] :height 15.0
                       :spacing {:min 1.0 :max 2.0} :radius {:min 0.15 :max 0.7}
                       :count-limit 128 :life-ticks 30 :seed seed}})
        (vfx! {:effect-id :audio-loop-session :operation :spawn
              :instance-key [:activation :charge-audio] :audience {:type :nearby :radius 96.0}
              :payload {:position charge-position :sound-id \"academy:vecmanip.plasma_cannon\"
                       :volume 0.8 :pitch 1.0}})
        (finish {:outcome :started})]
       [(finish {:outcome :insufficient-resource :end-ability? true})])]

    :pulse
    [(let charge-ticks ?charge/ticks)
     (let mode %mode)
     (let overload-floor %overload-floor)
     (resource/enforce-floor {:resource :overload :minimum overload-floor})
     (let charge-time $charge-time)
     (if (math/eq mode 0)
       [(if (math/lt charge-ticks charge-time)
          [(let charging-budget ?budget/charging)
           (let sufficient? (cost/spend {:budget charging-budget}))
           (if (bool/not sufficient?)
             [(vfx! {:effect-id :energy-orb-session :operation :destroy
                    :instance-key [:activation :energy-orb] :payload {:fade-ticks 8}})
              (vfx! {:effect-id :vortex-column-session :operation :destroy
                    :instance-key [:activation :vortex-column] :payload {:fade-ticks 8}})
              (vfx! {:effect-id :audio-loop-session :operation :destroy
                    :instance-key [:activation :charge-audio] :payload {:fade-ticks 0}})
              (finish {:outcome :insufficient-resource :end-ability? true})]
             [(finish {:outcome :charging})])]
          [(finish {:outcome :charged})])]
       [(if (math/eq mode 1)
          [(let owner-id ?caster/id)
           (let position %position)
           (let destination %destination)
           (let flight-ticks %flight-ticks)
           (let sync-ticks %sync-ticks)
           (let block-hit-extra-distance $block-hit-extra-distance)
           (let destination-epsilon $destination-epsilon)
           (let max-flight-ticks $max-flight-ticks)
           (let sync-interval-ticks $sync-interval-ticks)
           (let delta (vec3/sub (:position destination) position))
           (let distance (vec3/length delta))
           (let direction (vec3/normalize delta))
           (let next-position (vec3/add position (vec3/scale direction 1.0)))
           (let path-hit (target/raycast {:origin position :direction direction
                                          :distance (math/add 1.0 block-hit-extra-distance)
                                          :include-entities? false :include-blocks? true}))
           (if (bool/or (:hit? path-hit)
                       (bool/or (math/lte (vec3/distance next-position (:position destination))
                                         destination-epsilon)
                               (math/gte flight-ticks max-flight-ticks)))
             [(let damage-radius $damage-radius)
              (let damage $damage)
              (let explosion-radius $explosion-radius)
              (let fire-progression ?progression/fire)
              (let main-cooldown ?cooldown/main)
              (combat/area-damage (:position destination) damage-radius damage :skill 128)
              (world/explosion {:owner owner-id :position (:position destination)
                                :radius explosion-radius :fire? false :terrain? true})
              (event! {:type :score/mark :progression fire-progression})
              (cooldown/start {:name :main :ticks main-cooldown})
              (vfx! {:effect-id :endpoint-burst :operation :spawn
                    :audience {:type :nearby :radius 96.0}
                    :payload {:sound-pitch 0.8 :limit 256 :duration-ticks 12 :sound-volume 1.0
                             :sound-id \"minecraft:entity.generic.explode\"
                             :particle {:material :additive :life-ticks 16 :speed 0.12
                                       :color [236 170 93 220]}
                             :from (:position destination) :rate-per-tick 16
                             :to (:position destination)}})
              (vfx! {:effect-id :energy-orb-session :operation :destroy
                    :instance-key [:activation :energy-orb] :payload {:fade-ticks 8}})
              (vfx! {:effect-id :vortex-column-session :operation :destroy
                    :instance-key [:activation :vortex-column] :payload {:fade-ticks 8}})
              (vfx! {:effect-id :audio-loop-session :operation :destroy
                    :instance-key [:activation :charge-audio] :payload {:fade-ticks 0}})
              (finish {:outcome :performed :end-ability? true})]
             [(state! :position next-position)
              (let flight-ticks-next (long/add flight-ticks 1))
              (state! :flight-ticks flight-ticks-next)
              (let sync-ticks-next (long/max 0 (long/sub sync-ticks 1)))
              (state! :sync-ticks sync-ticks-next)
              (when (math/lte sync-ticks-next 0)
                (vfx! {:effect-id :energy-orb-session :operation :update
                      :instance-key [:activation :energy-orb] :payload {:position next-position}})
                (vfx! {:effect-id :vortex-column-session :operation :update
                      :instance-key [:activation :vortex-column] :payload {:base next-position}})
                (vfx! {:effect-id :audio-loop-session :operation :update
                      :instance-key [:activation :charge-audio] :payload {:position next-position}})
                (state! :sync-ticks sync-interval-ticks))
              (finish {:outcome :flight})])]
          [(finish {:outcome :continue})])])]

    :release
    [(let mode %mode)
     (let charge-ticks ?charge/ticks)
     (let charge-time $charge-time)
     (if (math/eq mode 0)
       [(if (math/gte charge-ticks charge-time)
          [(let eye ?caster/eye)
           (let aim ?caster/aim)
           (let targeting-distance $targeting-distance)
           (let eye-height $eye-height)
           (let sync-interval-ticks $sync-interval-ticks)
           (let aim-hit (target/raycast {:origin eye :direction aim :distance targeting-distance
                                         :include-entities? true :include-blocks? true
                                         :living-only? true}))
           (let destination
             (target/resolve-destination {:hit aim-hit :origin eye :direction aim
                                          :distance targeting-distance
                                          :policy {:direction aim :minimum-distance 0.0
                                                  :entity-eye-height eye-height
                                                  :head-clearance? false}}))
           (state! :mode 1)
           (state! :destination destination)
           (state! :flight-ticks 0)
           (state! :sync-ticks sync-interval-ticks)
           (let fire-progression ?progression/fire)
           (let main-cooldown ?cooldown/main)
           (event! {:type :score/mark :progression fire-progression})
           (cooldown/start {:name :main :ticks main-cooldown})
           (vfx! {:effect-id :energy-orb-session :operation :update
                 :instance-key [:activation :energy-orb]
                 :payload {:position (:position destination)}})
           (vfx! {:effect-id :vortex-column-session :operation :update
                 :instance-key [:activation :vortex-column]
                 :payload {:base (:position destination)}})
           (vfx! {:effect-id :audio-loop-session :operation :update
                 :instance-key [:activation :charge-audio]
                 :payload {:position (:position destination)}})
           (finish {:outcome :released})]
          [(vfx! {:effect-id :energy-orb-session :operation :destroy
                 :instance-key [:activation :energy-orb] :payload {:fade-ticks 8}})
           (vfx! {:effect-id :vortex-column-session :operation :destroy
                 :instance-key [:activation :vortex-column] :payload {:fade-ticks 8}})
           (vfx! {:effect-id :audio-loop-session :operation :destroy
                 :instance-key [:activation :charge-audio] :payload {:fade-ticks 0}})
           (finish {:outcome :undercharged :end-ability? true})])]
       [(finish {:outcome :continue})])]

    :abort
    [(vfx! {:effect-id :energy-orb-session :operation :destroy
           :instance-key [:activation :energy-orb] :payload {:fade-ticks 8}})
     (vfx! {:effect-id :vortex-column-session :operation :destroy
           :instance-key [:activation :vortex-column] :payload {:fade-ticks 8}})
     (vfx! {:effect-id :audio-loop-session :operation :destroy
           :instance-key [:activation :charge-audio] :payload {:fade-ticks 0}})
     (finish {:outcome :aborted :end-ability? true})]}}"
 :invariants nil
 :mark-policies nil}

;; New-DSL conversion of ac/combat/abilities/vec_reflection.edn (S6). See
;; earlier skills/*.edn docstrings for the general pattern. First :toggle
;; ability (start/pulse/release/abort, all real logic) and first real call
;; site of all three previously-deferred pieces:
;;
;; - combat/projectile-reflection-scan (one of the 3 callback-typed old
;;   composites the plan always intended to INLINE at call sites rather
;;   than port as a first-class higher-order :defn, since :defn params
;;   cannot themselves be sub-programs) -- inlined directly as
;;   target/entities + each below, reading straight off
;;   combat-core/composites/projectile_reflection_scan.edn's own body.
;; - :flow/once (old: skip an already-processed projectile within one
;;   pulse's scan, deduped by :last-key -- final_engine.clj's run-once).
;;   No new DSL form needed: reads down to `(value/eq %state new-key)` --
;;   nil never equals a real id, so the FIRST time through, the state
;;   read alone already produces the same \"not present yet\" outcome
;;   run-once's own :last-key strategy special-cased.
;; - :flow/control :signal :skip-item (old: abort the rest of THIS
;;   projectile's processing on an insufficient per-reflect spend, but
;;   keep scanning the rest). No new DSL form needed either: since the
;;   remaining per-projectile steps are exactly the reflect-sufficient?
;;   branch's own body, nesting them inside `when reflect-sufficient?`
;;   IS the skip -- the outer `each` keeps going regardless either way.
;;
;; ?invariant/name (:overload-floor here) is a new capability namespace --
;; cn.li.combat.run's capability-type had no case for it at all before
;; this conversion (every :ability/invariant read would have been an
;; undeclared-capability compile error).
{:schema-version 2
 :kind :ability
 :id :vec-reflection
 :name-key "ability.skill.vecmanip.vec_reflection"
 :description-key "ability.skill.vecmanip.vec_reflection.desc"
 :revision 2
 :activation :toggle
 :requires [:caster/eye :caster/aim]
 :parameters {:damage-multiplier {:type [:tuple :float 2] :snapshot :activation}
              :min-reflected-damage {:type :float :snapshot :activation}
              :damage-cp {:type [:tuple :float 2] :snapshot :activation}
              :exp-damage-scale {:type :float :snapshot :activation}
              :max-reflections {:type :int :snapshot :activation}}
 :tunables {:tick-cp {:curve :mastery-lerp}
            :overload-keep {:curve :mastery-lerp}
            :target-radius {:curve :const}
            :affected-entity-difficulty {:curve :const :type :string-list}
            :excluded-entity-ids {:curve :const :type :string-list}
            :large-fireball-ids {:curve :const :type :string-list}
            :reflect-entity-cp {:curve :mastery-lerp}
            :exp-reflect-entity-scale {:curve :const}}
 :costs {:activate {:resources {:overload {:ref [:input :tunables :overload-keep]}}}
         :per-tick {:resources {:cp {:ref [:input :tunables :tick-cp]}}}
         :per-reflect {:resources {:cp {:ref [:input :tunables :reflect-entity-cp]}}}}
 :invariants {:overload-floor {:ref [:input :tunables :overload-keep]}}
 :progression {:reflect-entity {:per-mark {:ref [:input :tunables :exp-reflect-entity-scale]}}
               :damaged {:per-mark {:ref [:input :params :exp-damage-scale]}}}
 :program
 "{:ability :vec-reflection
   :activation :toggle
   :state {:visited-projectiles {:type :any}}
   :tunables {:target-radius {:type :double} :affected-entity-difficulty {:type :any}
              :excluded-entity-ids {:type :any} :large-fireball-ids {:type :any}}
   :phases
   {:start
    [(let eye ?caster/eye)
     (let activate-budget ?budget/activate)
     (let sufficient? (cost/spend {:budget activate-budget}))
     (if sufficient?
       [(vfx! {:effect-id :ring-particle-field :operation :spawn
              :instance-key [:activation :vec-reflection]
              :audience {:type :nearby :radius 64.0}
              :payload {:position eye :ring-from 0.45 :ring-to 0.9 :segments 20
                       :ring-color [188 252 238 150] :rate-per-tick 2 :limit 128
                       :particle {:material :additive :life-ticks 12 :speed 0.04}}})
        (finish {:outcome :started})]
       [(finish {:outcome :insufficient-resource :end-ability? true})])]

    :pulse
    [(let eye ?caster/eye)
     (let aim ?caster/aim)
     (let per-tick-budget ?budget/per-tick)
     (let tick-sufficient? (cost/spend {:budget per-tick-budget}))
     (if tick-sufficient?
       [(let overload-floor ?invariant/overload-floor)
        (resource/enforce-floor {:resource :overload :minimum overload-floor})
        (let aim-point (target/raycast {:origin eye :direction aim :distance 20.0
                                        :include-entities? true :include-blocks? true}))
        (let projectiles
          (target/entities {:shape {:type :sphere :center eye :radius $target-radius}
                            :filter {:difficulty-entries $affected-entity-difficulty
                                    :excluded-entity-ids $excluded-entity-ids
                                    :excluded-tags []}
                            :limit 64}))
        (each projectile projectiles
          (let projectile-id (:id projectile))
          (let visited %visited-projectiles)
          (let first? (bool/not (value/eq visited projectile-id)))
          (when first?
            (state! :visited-projectiles projectile-id)
            (let difficulty (:difficulty projectile))
            (when (math/gt difficulty 0.0)
              (let reflect-budget ?budget/per-reflect)
              (let reflect-sufficient? (cost/spend {:budget reflect-budget :scale difficulty}))
              (when reflect-sufficient?
                (projectile/redirect {:entity projectile :target-position (:position aim-point)
                                      :velocity (:velocity projectile) :difficulty difficulty
                                      :replacement-types $large-fireball-ids})
                (let reflect-entity-progression ?progression/reflect-entity)
                (event! {:type :score/mark :tag :reflect-entity
                        :progression reflect-entity-progression :weight difficulty})
                (vfx! {:effect-id :ring-fade-audio :operation :spawn
                      :instance-key [:projectile projectile-id]
                      :payload {:fade-at 6 :sound-pitch 1.0 :duration-ticks 12
                               :fade-ring-from 1.1 :sound-volume 0.5 :fade-ring-to 1.3
                               :sound-id \"academy:vecmanip.vec_reflection\" :ring-to 1.1
                               :fade-to-tick 12 :fade-color [188 252 238 130]
                               :fade-segments 16 :position (:position projectile)
                               :ring-from 0.15 :ring-color [236 170 93 180]
                               :ring-segments 16}})))))
        (finish {:outcome :continue})]
       [(vfx! {:effect-id :ring-particle-field :operation :destroy
              :instance-key [:activation :vec-reflection] :payload {}})
        (finish {:outcome :insufficient-resource :end-ability? true})])]

    :release
    [(vfx! {:effect-id :ring-particle-field :operation :destroy
           :instance-key [:activation :vec-reflection] :payload {}})
     (finish {:outcome :released :end-ability? true})]

    :abort
    [(vfx! {:effect-id :ring-particle-field :operation :destroy
           :instance-key [:activation :vec-reflection] :payload {}})
     (finish {:outcome :aborted :end-ability? true})]}}"
 :damage-policies
 [{:on :combat/damage
   :priority 60
   :when {:expr :bool/and
          :args [{:ref [:input :context :enabled?]}
                 {:expr :math/gt :args [{:ref [:input :request :base]} 0.0]}]}
   :program {:component :damage/reflect
             :multiplier {:expr :math/lerp
                          :args [{:ref [:input :params :damage-multiplier 0]}
                                {:ref [:input :params :damage-multiplier 1]}
                                {:ref [:input :context :skill-exp]}]}
             :cost-per-damage {:expr :math/lerp
                               :args [{:ref [:input :params :damage-cp 0]}
                                     {:ref [:input :params :damage-cp 1]}
                                     {:ref [:input :context :skill-exp]}]}
             :minimum {:ref [:input :params :min-reflected-damage]}
             :max-depth {:ref [:input :params :max-reflections]}
             :cost-resource :cp
             :progression-tag :damaged
             :progression-scale {:ref [:input :params :exp-damage-scale]}}}]
 :cooldown nil
 :mark-policies nil}

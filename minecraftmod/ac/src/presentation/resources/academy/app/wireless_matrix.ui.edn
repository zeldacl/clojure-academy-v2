;; Wireless matrix — TechUI shell aligned with main page_matrix.xml:
;; left page is parent_bg + ui_inventory + ui_matrix only (no inv buttons).
;; Network / INIT live in the info area (main matrix-info-reactive/rebuild!).
{:ui/schema 2 :view/id :academy.app/wireless-matrix
 :host {:kind :container :design-width 290 :design-height 187 :scale-policy :fit}
 :state-schema {:page-composite :vector
                :matrix-init-visible? :boolean :matrix-init-button :map
                :matrix-noinit-visible? :boolean :matrix-noinit-label :string}
 :root
 {:type :include :src "academy/shared/tech_ui_shell"
  :slots
  {:inv
   {:type :absolute :key :matrix/left
    :layout {:x 0.0 :y 0.0 :width 176.0 :height 187.0}
    :bind {:visible [:state :inv-page-visible?]}
    :children
    [;; TechUI page-anchor: center 176-wide art in historical 172-wide page.
     {:type :row :key :matrix/page-art
      :layout {:x 0.0 :y 0.0 :width 172.0 :height 187.0 :justify :center}
      :children
      [{:type :absolute :layout {:width 176.0 :height 187.0}
        :children
        [{:type :image :key :matrix/parent-bg
          :layout {:width 176.0 :height 187.0}
          :style {:resource {:namespace "academy" :path "textures/guis/parent/parent_background.png"}}
          :semantics {:role :image}}
         {:type :image :key :matrix/ui-inv
          :layout {:width 176.0 :height 187.0}
          :style {:resource {:namespace "academy" :path "textures/guis/ui/ui_inventory.png"}}
          :semantics {:role :image}}
         {:type :image :key :matrix/ui-block
          :layout {:width 176.0 :height 187.0}
          :style {:resource {:namespace "academy" :path "textures/guis/ui/ui_matrix.png"}}
          :semantics {:role :image}}]}]}
     {:type :repeater :key :matrix/slot-anchors
      :layout {:width 176.0 :height 187.0}
      :bind {:items [:state :slot-anchors]}
      :children [{:type :slot-anchor :bind {:item [:state :item]}}]}]}

   :info-body
   {:type :absolute :key :matrix/info-body
    :layout {:width 100.0 :height 177.0}
    :children
    [{:type :include :src "academy/shared/info_fields"}
     ;; Main rebuild!: blank row then INIT button when owner && !initialized.
     {:type :button :key :matrix/init
      :layout {:x 4.0 :y 155.0 :width 92.0 :height 12.0}
      :style {:rgba 0x00000000}
      :bind {:visible [:state :matrix-init-visible?]
             :text [:state :matrix-init-button]}
      :on {:activate :matrix/init}
      :semantics {:role :button}}
     {:type :text :key :matrix/noinit
      :layout {:x 4.0 :y 155.0 :width 92.0 :height 12.0}
      :style {:font-size 8.0 :rgba 0x99FFFFFF}
      :bind {:visible [:state :matrix-noinit-visible?]
             :text [:state :matrix-noinit-label]}}]}}}}

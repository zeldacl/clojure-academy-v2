;; Wireless matrix — TechUI family: parent 176×187 + right info, matrix page overlay.
{:ui/schema 2 :view/id :academy.app/wireless-matrix
 :host {:kind :container :design-width 290 :design-height 187 :scale-policy :fit}
 :state-schema {:network-state :string :network-owner :string :network-range :string
                :network-bandwidth :string :network-load :number :network-ssid :string
                :network-password :string :network-input-visible? :boolean
                :network-editable? :boolean :network-readonly? :boolean
                :network-init-form? :boolean :network-noinit? :boolean
                :network-init-label :string :network-noinit-label :string
                :info-area :map :button-left :map :button-right :map :page-composite :vector
                :slot-anchors :vector}
 :root
 {:type :absolute :key :matrix/root :layout {:width 290 :height 187}
  :children
  [{:type :absolute :key :matrix/left :layout {:x 0.0 :y 0.0 :width 176.0 :height 187.0}
    :children
    [{:type :image :key :matrix/parent-bg
      :layout {:width 176.0 :height 187.0}
      :style {:resource {:namespace "academy" :path "textures/guis/parent/parent_background.png"}}
      :semantics {:role :image}}
     {:type :image :key :matrix/ui-inv
      :layout {:width 176.0 :height 187.0}
      :style {:resource {:namespace "academy" :path "textures/guis/ui/ui_inventory.png"}}
      :semantics {:role :image}}
     {:type :image :key :matrix/ui-block
      :layout {:width 176.0 :height 187.0}
      :style {:resource {:namespace "academy" :path "textures/guis/ui/ui_matrix.png"}}
      :semantics {:role :image}}
     {:type :repeater :key :matrix/slot-anchors
      :layout {:width 176.0 :height 187.0}
      :bind {:items [:state :slot-anchors]}
      :children [{:type :slot-anchor :bind {:item [:state :item]}}]}
     {:type :column :key :matrix/form
      :layout {:x 10.0 :y 28.0 :width 156.0 :height 140.0}
      :children
      [{:type :text :layout {:height 12.0} :style {:font-size 9.0}
        :bind {:text [:state :network-state]}}
       {:type :text :layout {:height 10.0} :style {:font-size 8.0}
        :bind {:text [:state :network-owner]}}
       {:type :text :layout {:height 10.0} :style {:font-size 8.0}
        :bind {:text [:state :network-range]}}
       {:type :text :layout {:height 10.0} :style {:font-size 8.0}
        :bind {:text [:state :network-bandwidth]}}
       {:type :progress :layout {:height 5.0}
        :bind {:value [:state :network-load]} :semantics {:role :progress}}
       {:type :text :layout {:height 12.0}
        :bind {:text [:state :network-init-label] :visible [:state :network-init-form?]}}
       {:type :text-input :layout {:height 14.0}
        :bind {:text [:state :network-ssid] :visible [:state :network-input-visible?]}
        :on {:change :container/text-change :submit :container/text-submit}
        :semantics {:role :textbox :field :ssid}}
       {:type :text-input :layout {:height 14.0}
        :bind {:text [:state :network-password] :visible [:state :network-input-visible?]}
        :on {:change :container/text-change :submit :container/text-submit}
        :semantics {:role :textbox :field :password}}
       {:type :text :layout {:height 12.0}
        :bind {:text [:state :network-ssid] :visible [:state :network-readonly?]}}
       {:type :text :layout {:height 12.0}
        :bind {:text [:state :network-noinit-label] :visible [:state :network-noinit?]}}
       {:type :row :layout {:height 16.0}
        :children
        [{:type :button :layout {:width 70.0 :height 14.0}
          :bind {:text [:state :button-left]}
          :on {:activate :container/button} :semantics {:role :button}}
         {:type :button :layout {:width 70.0 :height 14.0}
          :bind {:text [:state :button-right]}
          :on {:activate :container/button} :semantics {:role :button}}]}]}]}

   {:type :include :src "academy/shared/info_area_chrome"}

   {:type :clip :key :matrix/info
    :layout {:x 179.0 :y 5.0 :width 100.0 :height 177.0}
    :children
    [{:type :include :src "academy/shared/info_area_histogram"}
     {:type :scroll :layout {:x 4.0 :y 90.0 :width 92.0 :height 66.0}
      :bind {:items [:state :info-area :fields]}
      :children
      [{:type :row :layout {:height 12.0}
        :children
        [{:type :text :layout {:width 40.0} :style {:font-size 7.0}
          :bind {:text [:item :label]}}
         {:type :text :layout {:width 52.0} :style {:font-size 7.0}
          :bind {:text [:item :value]}}]}]}
     {:type :progress :layout {:x 4.0 :y 160.0 :width 92.0 :height 5.0}
      :bind {:value [:state :info-area :load-ratio]}
      :semantics {:role :progress}}]}]}}

;; Preset editor — current preset card + available-skills assign list.
;; Prev/Next cycles presets (main carousel reduced to one live card for wiring).
{:ui/schema 2 :view/id :academy.app/preset-editor
 :host {:kind :screen :design-width 500 :design-height 180 :scale-policy :fit}
 :state-schema {:title :string :preset-label :string :active-label :string
                :preset-tabs :vector :slots :vector :available-skills :vector
                :selected-slot :number :status :string :button-left :string :button-right :string}
 :root
 {:type :absolute :key :preset/root :layout {:width 500 :height 180}
  :children
  [{:type :rect :key :preset/blackout
    :layout {:x 0.0 :y 0.0 :width 500.0 :height 180.0}
    :style {:rgba [0.0 0.0 0.0 0.55]}
    :semantics {:role :generic}}

   {:type :text :key :preset/title
    :layout {:x 5.0 :y 5.0 :width 200.0 :height 14.0}
    :style {:font-size 11.0 :rgba [1.0 1.0 1.0 1.0]}
    :bind {:text [:state :title]}
    :semantics {:role :heading}}

   {:type :text :key :preset/active
    :layout {:x 220.0 :y 5.0 :width 180.0 :height 14.0}
    :style {:font-size 9.0 :rgba [0.8 0.8 0.8 0.9]}
    :bind {:text [:state :active-label]}}

   {:type :row :key :preset/nav
    :layout {:x 150.0 :y 20.0 :width 200.0 :height 16.0}
    :children
    [{:type :button :layout {:width 60.0 :height 14.0}
      :bind {:text [:state :button-left]}
      :on {:activate :preset/previous}
      :semantics {:role :button}}
     {:type :text :layout {:width 80.0 :height 14.0} :style {:font-size 9.0}
      :bind {:text [:state :preset-label]}}
     {:type :button :layout {:width 60.0 :height 14.0}
      :bind {:text [:state :button-right]}
      :on {:activate :preset/next}
      :semantics {:role :button}}]}

   ;; Current preset slots
   {:type :absolute :key :preset/card
    :layout {:x 8.0 :y 40.0 :width 116.0 :height 130.0}
    :children
    [{:type :image :layout {:width 116.0 :height 130.0}
      :style {:resource {:namespace "academy" :path "textures/guis/preset_settings/back.png"}}
      :semantics {:role :image}}
     {:type :scroll :layout {:x 3.0 :y 14.0 :width 110.0 :height 110.0}
      :bind {:items [:state :slots]}
      :semantics {:role :list}
      :children
      [{:type :row :layout {:height 27.0}
        :children
        [{:type :button :layout {:width 78.0 :height 24.0}
          :bind {:text [:item :label]}
          :on {:activate :preset/select-slot}
          :semantics {:role :button}}
         {:type :button :layout {:width 28.0 :height 24.0}
          :bind {:text [:item :remove-label]}
          :on {:activate :preset/remove-slot}
          :semantics {:role :button}}]}]}]}

   ;; Learned skills to assign into the selected slot
   {:type :absolute :key :preset/available
    :layout {:x 132.0 :y 40.0 :width 360.0 :height 130.0}
    :children
    [{:type :rect :layout {:width 360.0 :height 130.0}
      :style {:rgba [0.08 0.1 0.14 0.72]}
      :semantics {:role :generic}}
     {:type :text :layout {:x 6.0 :y 4.0 :width 200.0 :height 12.0}
      :style {:font-size 9.0} :text "Available skills"}
     {:type :scroll :layout {:x 4.0 :y 18.0 :width 352.0 :height 108.0}
      :bind {:items [:state :available-skills]}
      :semantics {:role :list}
      :children
      [{:type :row :layout {:height 18.0}
        :children
        [{:type :text :layout {:width 260.0 :height 16.0} :style {:font-size 8.0}
          :bind {:text [:item :label]}}
         {:type :button :layout {:width 72.0 :height 16.0}
          :bind {:text [:item :action-label]}
          :on {:activate :preset/assign}
          :semantics {:role :button}}]}]}]}

   {:type :text :key :preset/status
    :layout {:x 8.0 :y 172.0 :width 480.0 :height 8.0}
    :style {:font-size 8.0}
    :bind {:text [:state :status]}}]}}

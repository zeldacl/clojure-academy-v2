;; Developer — main page_developer.xml classic 400×187 dual panel.
;; Positions bake XML align math: child = (parent-size - child-size)/2 + pos
;; for center/middle (see mcmod ui layout_test).
{:ui/schema 2 :view/id :academy.app/developer
 :host {:kind :container :design-width 400 :design-height 187 :scale-policy :fit}
 :state-schema {:title :string :mode :string
                :ability-name :string :level-label :string :exp-label :string
                :ability-icon-items :vector
                :level-prog :number :can-upgrade? :boolean :level-label-visible? :boolean
                :energy-ratio :number :sync-rate :number
                :wireless-visible :boolean :wireless-node-name :string
                :wireless-page-visible? :boolean
                :skill-tree-visible? :boolean :console-visible? :boolean
                :composite-list :vector
                :console-lines :vector :console-prompt :string
                :detail-visible? :boolean :selected-detail :map
                :status :string}
 :root
 {:type :absolute :key :developer/root :layout {:width 400 :height 187}
  :children
  [;; Left: XML parent-left pos 4,0 size 108.5×187 align left,center → (4,0)
   {:type :absolute :key :developer/left
    :layout {:x 4.0 :y 0.0 :width 108.5 :height 187.0}
    :children
    [{:type :image :layout {:width 108.5 :height 187.0}
      :style {:resource {:namespace "academy"
                         :path "textures/guis/parent/parent_background_developerleft.png"}}
      :semantics {:role :image}}
     {:type :image :layout {:width 108.5 :height 187.0}
      :style {:resource {:namespace "academy" :path "textures/guis/ui/ui_developerleft.png"}}
      :semantics {:role :image}}

     ;; Ability: pos 2,-10 size 104×32 align left,center → y=(187-32)/2-10=67.5
     {:type :absolute :key :developer/ability
      :layout {:x 2.0 :y 67.5 :width 104.0 :height 32.0}
      :children
      [{:type :repeater :layout {:x 0.0 :y 0.0 :width 32.0 :height 32.0 :direction :none}
        :bind {:items [:state :ability-icon-items]}
        :children
        [{:type :composite :layout {:width 32.0 :height 32.0}
          :bind {:item [:state :item]}}]}
       ;; name: center+pos(14,-8) → x=31 y=2 font 13
       {:type :text :layout {:x 31.0 :y 2.0 :width 70.0 :height 12.0}
        :style {:font-size 13.0 :rgba [1.0 1.0 1.0 1.0]}
        :bind {:text [:state :ability-name]}}
       ;; progress: left,center pos(31,-2) → y=13.25
       {:type :rect :layout {:x 31.0 :y 13.25 :width 70.0 :height 1.5}
        :style {:rgba [0.4 0.4 0.4 0.3]}
        :semantics {:role :generic}}
       {:type :progress :layout {:x 31.0 :y 13.25 :width 70.0 :height 1.5}
        :bind {:value [:state :level-prog]}
        :semantics {:role :progress}}
       ;; level: center+pos(27.8,6) → x=59.2 y=16 (hidden when upgrade shown)
       {:type :text :layout {:x 59.2 :y 16.0 :width 41.2 :height 12.0}
        :style {:font-size 9.0 :rgba [0.067 0.467 0.839 1.0]}
        :bind {:text [:state :level-label] :visible [:state :level-label-visible?]}}
       ;; exp: left,top pos(30,15.5)
       {:type :text :layout {:x 30.0 :y 15.5 :width 42.0 :height 10.0}
        :style {:font-size 8.0 :rgba [1.0 1.0 1.0 1.0]}
        :bind {:text [:state :exp-label]}}
       ;; upgrade image @0.26 of 186×59.5 → 48.36×15.47 at 60,14.5
       {:type :absolute :layout {:x 60.0 :y 14.5 :width 48.4 :height 15.5}
        :bind {:visible [:state :can-upgrade?]}
        :on {:activate :developer/level-up}
        :semantics {:role :button}
        :children
        [{:type :image :layout {:width 48.4 :height 15.5}
          :style {:resource {:namespace "academy"
                             :path "textures/guis/button/button_learn.png"}
                  :rgba [1.0 1.0 1.0 0.7]}
          :semantics {:role :image}}]}]}

     ;; Machine overlay — labels use center/middle on 108.5×187 (lower half)
     {:type :absolute :key :developer/machine
      :layout {:x 0.0 :y 0.0 :width 108.5 :height 187.0}
      :bind {:visible [:state :wireless-visible]}
      :children
      [{:type :image :layout {:width 108.5 :height 187.0}
        :style {:resource {:namespace "academy"
                           :path "textures/guis/parent/parent_background_developermachine.png"}}
        :semantics {:role :image}}
       ;; Current Node: center+pos(0,17) → (4.25, 104.5)
       {:type :text :layout {:x 4.25 :y 104.5 :width 100.0 :height 12.0}
        :style {:font-size 12.0 :rgba [1.0 1.0 1.0 1.0]}
        :text "Current Node:"}
       ;; wireless button: center+pos(0,29) → (4.25, 114.5)
       {:type :absolute :layout {:x 4.25 :y 114.5 :width 100.0 :height 16.0}
        :on {:activate :developer/wireless}
        :semantics {:role :button}
        :children
        [{:type :image :layout {:width 100.0 :height 16.0}
          :style {:resource {:namespace "academy"
                             :path "textures/guis/element/element_background300x32.png"}
                  :rgba [1.0 1.0 1.0 0.7]}
          :semantics {:role :image}}
         ;; logo-node: center+pos(-37,0) within button → (7, 2)
         {:type :image :layout {:x 7.0 :y 2.0 :width 12.0 :height 12.0}
          :style {:resource {:namespace "academy" :path "textures/guis/icons/icon_node.png"}}
          :semantics {:role :image}}
         ;; nodename: center+pos(11,0) → (26, 2)
         {:type :text :layout {:x 26.0 :y 2.0 :width 70.0 :height 12.0}
          :style {:font-size 12.0 :rgba [1.0 1.0 1.0 1.0]}
          :bind {:text [:state :wireless-node-name]}}]}
       ;; Power: center+pos(0,43) → (4.25, 130.5)
       {:type :text :layout {:x 4.25 :y 130.5 :width 100.0 :height 12.0}
        :style {:font-size 12.0 :rgba [1.0 1.0 1.0 1.0]}
        :text "Power:"}
       ;; power bar: left,center pos(5.75,55.5) → y=145
       {:type :rect :layout {:x 5.75 :y 145.0 :width 97.0 :height 8.0}
        :style {:rgba [1.0 1.0 1.0 0.2]}
        :semantics {:role :generic}}
       {:type :progress :layout {:x 5.75 :y 145.0 :width 97.0 :height 8.0}
        :bind {:value [:state :energy-ratio]}
        :semantics {:role :progress}}
       ;; Sync Rate: center+pos(0,66) → (4.25, 153.5)
       {:type :text :layout {:x 4.25 :y 153.5 :width 100.0 :height 12.0}
        :style {:font-size 12.0 :rgba [1.0 1.0 1.0 1.0]}
        :text "Sync Rate:"}
       ;; sync bar: left,center pos(5.75,77.5) → y=167
       {:type :rect :layout {:x 5.75 :y 167.0 :width 97.0 :height 8.0}
        :style {:rgba [1.0 1.0 1.0 0.2]}
        :semantics {:role :generic}}
       {:type :progress :layout {:x 5.75 :y 167.0 :width 97.0 :height 8.0}
        :bind {:value [:state :sync-rate]}
        :semantics {:role :progress}}]}]}

   ;; Right: align right → x=118
   {:type :absolute :key :developer/right
    :layout {:x 118.0 :y 0.0 :width 278.0 :height 187.0}
    :children
    [{:type :image :layout {:width 278.0 :height 187.0}
      :style {:resource {:namespace "academy"
                         :path "textures/guis/parent/parent_background_developerright.png"}}
      :semantics {:role :image}}
     {:type :image :layout {:width 278.0 :height 187.0}
      :style {:resource {:namespace "academy" :path "textures/guis/ui/ui_developerright.png"}}
      :semantics {:role :image}}

     {:type :absolute :key :developer/area
      :layout {:x 10.0 :y 18.0 :width 257.0 :height 139.0}
      :children
      [{:type :repeater :key :developer/skill-graph
        :layout {:x 0.0 :y 0.0 :width 257.0 :height 139.0 :direction :none}
        :bind {:items [:state :composite-list] :visible [:state :skill-tree-visible?]}
        :children
        [{:type :composite :layout {:width 0.0 :height 0.0}
          :bind {:item [:state :item]
                 :x [:item :layout-x] :y [:item :layout-y]
                 :width [:item :w] :height [:item :h]}
          :on {:activate :developer/select-skill}}]}

       ;; Console: scrollback above, prompt pinned to the bottom row. Both are
       ;; laid out here — cn.li.ac.block.developer.console hands over text
       ;; only, never coordinates, same as every other list in this app.
       ;; The controller already clamps the body to its 10 lines, so the list
       ;; fills the area exactly and the newest line is always the last one.
       {:type :scroll :key :developer/console-body
        :layout {:x 5.0 :y 5.0 :width 247.0 :height 100.0}
        :bind {:items [:state :console-lines] :visible [:state :console-visible?]}
        :semantics {:role :list}
        :children
        [{:type :text :layout {:width :fill :height 10.0}
          :style {:font-size 8.0 :rgba [1.0 1.0 1.0 1.0]}
          :bind {:text [:item :label]}}]}
       {:type :text :key :developer/console-prompt
        :layout {:x 5.0 :y 105.0 :width 247.0 :height 10.0}
        :style {:font-size 8.0 :rgba [1.0 1.0 1.0 1.0]}
        :bind {:text [:state :console-prompt] :visible [:state :console-visible?]}}
       {:type :absolute :key :developer/console-catcher
        :layout {:x 0.0 :y 0.0 :width 257.0 :height 139.0}
        :bind {:visible [:state :console-visible?]}
        :on {:change :developer/console-input :submit :developer/console-submit}
        :semantics {:role :textbox :field :developer-console}
        :children []}]}

     {:type :absolute :key :developer/detail
      :layout {:x 10.0 :y 18.0 :width 257.0 :height 139.0}
      :bind {:visible [:state :detail-visible?]}
      :children
      [{:type :rect :layout {:width 257.0 :height 139.0}
        :style {:rgba [0.0 0.0 0.0 0.72]}
        :semantics {:role :generic}}
       {:type :text :layout {:x 10.0 :y 10.0 :width 237.0 :height 14.0}
        :style {:font-size 12.0 :rgba [1.0 1.0 1.0 1.0]}
        :bind {:text [:state :selected-detail :title]}}
       {:type :text :layout {:x 10.0 :y 28.0 :width 237.0 :height 12.0}
        :style {:font-size 9.0 :rgba [0.7 0.85 1.0 1.0]}
        :bind {:text [:state :selected-detail :level]}}
       {:type :text :layout {:x 10.0 :y 44.0 :width 237.0 :height 36.0}
        :style {:font-size 8.0 :rgba [0.9 0.9 0.9 1.0]}
        :bind {:text [:state :selected-detail :description]}}
       {:type :text :layout {:x 10.0 :y 84.0 :width 237.0 :height 10.0}
        :style {:font-size 8.0}
        :bind {:text [:state :selected-detail :condition-hint]}}
       {:type :progress :layout {:x 10.0 :y 100.0 :width 180.0 :height 6.0}
        :bind {:value [:state :selected-detail :development-progress]}
        :semantics {:role :progress}}
       {:type :text :layout {:x 10.0 :y 110.0 :width 120.0 :height 12.0}
        :style {:font-size 8.0}
        :bind {:text [:state :selected-detail :development-label]}}
       {:type :absolute :layout {:x 175.0 :y 108.0 :width 72.0 :height 18.0}
        :bind {:visible [:state :selected-detail :can-learn?]}
        :on {:activate :developer/learn-skill}
        :semantics {:role :button}
        :children
        [{:type :image :layout {:width 72.0 :height 18.0}
          :style {:resource {:namespace "academy"
                             :path "textures/guis/button/button_learn.png"}
                  :rgba [1.0 1.0 1.0 0.85]}
          :semantics {:role :image}}
         {:type :text :layout {:x 8.0 :y 3.0 :width 56.0 :height 12.0}
          :style {:font-size 9.0 :rgba [1.0 1.0 1.0 1.0]}
          :bind {:text [:state :selected-detail :learn-label]}}]}
       {:type :text :layout {:x 232.0 :y 6.0 :width 18.0 :height 14.0}
        :style {:font-size 12.0 :rgba [1.0 1.0 1.0 0.8]}
        :text "X"
        :on {:activate :developer/close-detail}
        :semantics {:role :button}}]}]}

   ;; Wireless overlay — main open-wireless-overlay! (cover + page_wireless).
   ;; Centered 176×187 on the 400×187 classic canvas: x=(400-176)/2=112.
   {:type :absolute :key :developer/wireless-modal
    :layout {:x 0.0 :y 0.0 :width 400.0 :height 187.0}
    :bind {:visible [:state :wireless-page-visible?]}
    :children
    [{:type :rect :layout {:width 400.0 :height 187.0}
      :style {:rgba [0.0 0.0 0.0 0.7]}
      :on {:activate :developer/wireless-close}
      :semantics {:role :button}}
     {:type :include :src "academy/shared/wireless_page"
      :layout {:x 112.0 :y 0.0 :width 176.0 :height 187.0}}]}]}}

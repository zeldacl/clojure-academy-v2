;; Spell composer (player-facing) -- shares academy/shared/editor_shell.edn
;; with the node editor. Stage is a horizontal Form -> Effect -> Effect+Aug
;; chain (Ars Nouveau precedent, see spell_composer_reactive.clj's own
;; player.clj:149 reference), not a stacked vertical list. Palette merges
;; the old three separately-titled Effects/Augments/Effects panels into
;; one grouped-by-kind list. Design size is unchanged (480x320, P3: "do
;; not enlarge") -- see node_editor.ui.edn's own comment for why growth
;; is capped by scale-policy :fit only centering, never scaling, the
;; design box.
{:ui/schema 2 :view/id :academy.app/spell-composer
 :host {:kind :screen :design-width 480 :design-height 320 :scale-policy :fit}
 :state-schema {:shell-header-h :number :shell-footer-h :number
                :shell-body-h :number :shell-diagnostics-h :number
                :shell-palette-w :number :shell-stage-w :number :shell-inspector-w :number
                :title :string :palette-rows :vector
                :complexity-label :string :complexity-ratio :number :over-cap? :boolean
                :chain-items :vector :selected-param-fields :vector
                :can-cast? :boolean :busy? :boolean :status :string
                :cast-label :string :clear-label :string}
 :root
 {:type :include :src "academy/shared/editor_shell"
  :slots
  {:header
   {:type :column :key :composer/header :layout {:width 480}
    :children
    [{:type :text :key :composer/title :layout {:height 16}
      :bind {:text [:state :title]} :semantics {:role :heading}}
     {:type :row :key :composer/complexity :layout {:height 16}
      :children [{:type :progress :layout {:width 200 :height 6}
                  :bind {:value [:state :complexity-ratio]}
                  :semantics {:role :progress}}
                 {:type :text :layout {:width 260 :height 14}
                  :bind {:text [:state :complexity-label]}}]}
     {:type :row :key :composer/actions :layout {:height 16}
      :children [{:type :button :layout {:width 90 :height 14}
                  :bind {:text [:state :clear-label]}
                  :on {:activate :composer/clear}
                  :semantics {:role :button}}
                 {:type :button :layout {:width 90 :height 14}
                  :bind {:text [:state :cast-label]}
                  :on {:activate :composer/cast}
                  :semantics {:role :button}}]}]}

   :palette
   {:type :scroll :key :composer/palette
    :bind {:items [:state :palette-rows] :width [:state :shell-palette-w] :height [:state :shell-body-h]}
    :semantics {:role :list}
    :children
    ;; :absolute item template, NOT :row -- LayoutKernel never reads
    ;; :visible during measure/arrange (only Paint/Hit do), so a :row's
    ;; header/entry children would both reserve their full flow width
    ;; even while invisible, pushing the entry button to start AFTER the
    ;; header's width regardless of which one is actually showing.
    ;; Overlapping both at x=0 (same fix as preset_editor's icon/text
    ;; slot layering) keeps the entry button inside the palette column.
    [{:type :absolute :layout {:height 14}
      :children
      [{:type :text :layout {:x 0 :width 106 :height 14}
        :bind {:text [:item :header-label] :visible [:item :header?]}
        :on {:activate :composer/toggle-palette-category}
        :semantics {:role :button :field :composer-palette-category}}
       {:type :absolute :layout {:x 0 :width 66 :height 14}
        :bind {:visible [:item :entry?]}
        :children
        [{:type :button :layout {:width 64 :height 14}
          :bind {:text [:item :label] :visible [:item :admissible?] :rgba [:item :category-color]}
          :on {:activate :composer/glyph-activate}
          :semantics {:role :button}}
         {:type :text :layout {:width 64 :height 14}
          :bind {:text [:item :label] :visible [:item :not-admissible?]}
          :style {:rgba [0.5 0.5 0.5 1.0]}
          :semantics {:role :generic}}
         ;; Glyph icon placeholder (P4) -- see node_editor.ui.edn's palette
         ;; row for the full rationale. No glyph art exists, so :has-icon?
         ;; is always false and this paints nothing; overlaid on the
         ;; button rather than replacing it so the row stays clickable.
         {:type :composite :layout {:x 0 :width 14 :height 14}
          :bind {:item [:item :icon] :visible [:item :has-icon?]}
          :semantics {:role :image}}]}
       {:type :text :layout {:x 66 :width 24 :height 14}
        :bind {:text [:item :cost-label] :visible [:item :entry?]}
        :semantics {:role :generic}}]}]}

   :stage
   {:type :repeater :key :composer/chain :layout {:direction :row}
    :bind {:items [:state :chain-items] :width [:state :shell-stage-w] :height [:state :shell-body-h]}
    :semantics {:role :list}
    :children
    [{:type :column :layout {:width 48}
      :on {:activate :composer/select-effect}
      :semantics {:role :button}
      :children
      [{:type :absolute :layout {:height 28}
        :children
        [{:type :text :layout {:x 0 :height 14} :bind {:text [:item :label] :rgba [:item :category-color]}}
         ;; Glyph icon placeholder (P4), same contract as the palette rows.
         {:type :composite :layout {:x 0 :y 0 :width 14 :height 14}
          :bind {:item [:item :icon] :visible [:item :has-icon?]}
          :semantics {:role :image}}]}
       {:type :row :layout {:height 14}
        :bind {:visible [:item :effect?]}
        :children [{:type :button :layout {:width 14 :height 14}
                     :bind {:text [:item :up-label] :visible [:item :can-move-up?]}
                     :on {:activate :composer/move-effect-up}
                     :semantics {:role :button}}
                    {:type :button :layout {:width 14 :height 14}
                     :bind {:text [:item :down-label] :visible [:item :can-move-down?]}
                     :on {:activate :composer/move-effect-down}
                     :semantics {:role :button}}
                    {:type :button :layout {:width 14 :height 14}
                     :bind {:text [:item :remove-label]}
                     :on {:activate :composer/remove-effect}
                     :semantics {:role :button}}]}
       {:type :repeater :layout {:width 48 :direction :column}
        :bind {:items [:item :augments] :visible [:item :effect?]}
        :children
        [{:type :row :layout {:width 48 :height 14}
          :children [{:type :text :layout {:width 34 :height 14} :bind {:text [:item :label]}}
                     {:type :button :layout {:width 14 :height 14}
                      :bind {:text [:item :remove-label]}
                      :on {:activate :composer/remove-augment}
                      :semantics {:role :button}}]}]}]}]}

   :inspector
   {:type :scroll :key :composer/params
    :bind {:items [:state :selected-param-fields] :width [:state :shell-inspector-w] :height [:state :shell-body-h]}
    :semantics {:role :list}
    :children
    [{:type :row :layout {:height 16}
      :children [{:type :text :layout {:width 48 :height 14} :bind {:text [:item :label]}}
                 {:type :text-input :layout {:width 40 :height 14}
                  :bind {:text [:item :value]}
                  :on {:change :composer/param-change :submit :composer/param-submit}
                  :semantics {:role :textbox :field :composer-param}}
                 {:type :button :layout {:width 14 :height 14}
                  :bind {:text [:item :decrement-label]}
                  :on {:activate :composer/param-decrement}
                  :semantics {:role :button :field :composer-param-decrement}}
                 {:type :button :layout {:width 14 :height 14}
                  :bind {:text [:item :increment-label]}
                  :on {:activate :composer/param-increment}
                  :semantics {:role :button :field :composer-param-increment}}]}]}

   :diagnostics
   {:type :absolute :key :composer/diagnostics-spacer :layout {:width 480 :height 0}}

   :footer
   {:type :text :key :composer/status :layout {:width 480 :height 32}
    :bind {:text [:state :status]} :semantics {:role :generic}}}}}

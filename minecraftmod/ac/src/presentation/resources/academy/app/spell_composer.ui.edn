{:ui/schema 2 :view/id :academy.app/spell-composer
 :host {:kind :screen :design-width 480 :design-height 320 :scale-policy :fit}
 :state-schema {:title :string :form-palette :vector :effect-palette :vector
                :augment-palette :vector :form-label :string :effect-slots :vector
                :can-cast? :boolean :busy? :boolean :status :string
                :cast-label :string :clear-label :string}
 :root {:type :column :key :composer/root :layout {:x 8 :y 8 :width 464 :height 304}
        :children
        [{:type :text :key :composer/title :layout {:height 18}
          :bind {:text [:state :title]} :semantics {:role :heading}}
         {:type :row :key :composer/form-row :layout {:height 56}
          :children
          [{:type :column :layout {:width 190}
            :children
            [{:type :text :layout {:height 14} :bind {:text [:state :form-label]}}
             {:type :scroll :key :composer/form-palette :layout {:height 36}
              :bind {:items [:state :form-palette]} :semantics {:role :list}
              :children [{:type :row :layout {:height 16}
                          :children [{:type :button :layout {:width 180 :height 14}
                                      :bind {:text [:item :label]}
                                      :on {:activate :composer/pick-form}
                                      :semantics {:role :button}}]}]}]}
           {:type :column :layout {:width 260}
            :children
            [{:type :text :layout {:height 14} :bind {:text "Effects"}}
             {:type :scroll :key :composer/effect-slots :layout {:height 36}
              :bind {:items [:state :effect-slots]} :semantics {:role :list}
              :children [{:type :row :layout {:height 16}
                          :children [{:type :button :layout {:width 120 :height 14}
                                      :bind {:text [:item :label]}
                                      :on {:activate :composer/select-effect}
                                      :semantics {:role :button}}
                                     {:type :button :layout {:width 32 :height 14}
                                      :bind {:text [:item :up-label]}
                                      :on {:activate :composer/move-effect-up}
                                      :semantics {:role :button}}
                                     {:type :button :layout {:width 32 :height 14}
                                      :bind {:text [:item :down-label]}
                                      :on {:activate :composer/move-effect-down}
                                      :semantics {:role :button}}
                                     {:type :button :layout {:width 32 :height 14}
                                      :bind {:text [:item :remove-label]}
                                      :on {:activate :composer/remove-effect}
                                      :semantics {:role :button}}]}]}]}]}
         {:type :row :key :composer/palette-row :layout {:height 112}
          :children
          [{:type :column :layout {:width 220}
            :children
            [{:type :text :layout {:height 14} :bind {:text "Effects"}}
             {:type :scroll :key :composer/effect-palette :layout {:height 96}
              :bind {:items [:state :effect-palette]} :semantics {:role :list}
              :children [{:type :row :layout {:height 16}
                          :children [{:type :button :layout {:width 210 :height 14}
                                      :bind {:text [:item :label]}
                                      :on {:activate :composer/add-effect}
                                      :semantics {:role :button}}]}]}]}
           {:type :column :layout {:width 220}
            :children
            [{:type :text :layout {:height 14} :bind {:text "Augments"}}
             {:type :scroll :key :composer/augment-palette :layout {:height 96}
              :bind {:items [:state :augment-palette]} :semantics {:role :list}
              :children [{:type :row :layout {:height 16}
                          :children [{:type :button :layout {:width 210 :height 14}
                                      :bind {:text [:item :label]}
                                      :on {:activate :composer/add-augment}
                                      :semantics {:role :button}}]}]}]}]}
         {:type :row :key :composer/actions :layout {:height 18}
          :children [{:type :button :layout {:width 100 :height 16}
                      :bind {:text [:state :clear-label]}
                      :on {:activate :composer/clear}
                      :semantics {:role :button}}
                     {:type :button :layout {:width 100 :height 16}
                      :bind {:text [:state :cast-label]}
                      :on {:activate :composer/cast}
                      :semantics {:role :button}}]}
         {:type :text :key :composer/status :layout {:height 18}
          :bind {:text [:state :status]}}]}}
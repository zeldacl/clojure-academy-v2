;; Wireless node — TechUI shell + ui_node overlay + anim.
{:ui/schema 2 :view/id :academy.app/wireless-node
 :host {:kind :container :design-width 290 :design-height 187 :scale-policy :fit}
 :state-schema {:node-name :string :network-password :string
                :node-anim :vector :page-composite :vector}
 :root
 {:type :include :src "academy/shared/tech_ui_shell"
  :slots
  {:inv
   {:type :absolute :key :node/left
    :layout {:x 0.0 :y 0.0 :width 176.0 :height 187.0}
    :bind {:visible [:state :inv-page-visible?]}
    :children
    [;; TechUI page-anchor: center 176-wide art in historical 172-wide page.
     {:type :row :key :node/page-art
      :layout {:x 0.0 :y 0.0 :width 172.0 :height 187.0 :justify :center}
      :children
      [{:type :absolute :layout {:width 176.0 :height 187.0}
        :children
        [{:type :image :layout {:width 176.0 :height 187.0}
          :style {:resource {:namespace "academy" :path "textures/guis/parent/parent_background.png"}}
          :semantics {:role :image}}
         {:type :image :layout {:width 176.0 :height 187.0}
          :style {:resource {:namespace "academy" :path "textures/guis/ui/ui_inventory.png"}}
          :semantics {:role :image}}
         {:type :image :layout {:width 176.0 :height 187.0}
          :style {:resource {:namespace "academy" :path "textures/guis/ui/ui_node.png"}}
          :semantics {:role :image}}
         {:type :repeater :key :node/anim
          :layout {:width 176.0 :height 187.0}
          :bind {:items [:state :node-anim]}
          :children [{:type :composite :layout {:width 0.0 :height 0.0}
                      :bind {:item [:state :item]}}]}]}]}
     {:type :repeater :layout {:width 176.0 :height 187.0}
      :bind {:items [:state :slot-anchors]}
      :children [{:type :slot-anchor :bind {:item [:state :item]}}]}]}

   :info-body
   {:type :include :src "academy/shared/info_fields"}}}}

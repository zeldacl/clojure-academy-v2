;; Wireless node — TechUI family with ui_node overlay.
;; Info-area layout mirrors main info-area-reactive:
;;   blend_quad 100×177 @ (179,5), histogram.png 84×84 @ (8,-20) with vertical
;;   bars, histProperty rows @ y=64, "-- Info --", then Range/Owner/Name/Password.
{:ui/schema 2 :view/id :academy.app/wireless-node
 :host {:kind :container :design-width 290 :design-height 187 :scale-policy :fit}
 :state-schema {:node-name :string :node-editable? :boolean :node-readonly? :boolean
                :network-password :string :info-area :map :slot-anchors :vector}
 :root
 {:type :absolute :key :node/root :layout {:width 290 :height 187}
  :children
  [{:type :absolute :key :node/left :layout {:x 0.0 :y 0.0 :width 176.0 :height 187.0}
    :children
    [{:type :image :layout {:width 176.0 :height 187.0}
      :style {:resource {:namespace "academy" :path "textures/guis/parent/parent_background.png"}}
      :semantics {:role :image}}
     {:type :image :layout {:width 176.0 :height 187.0}
      :style {:resource {:namespace "academy" :path "textures/guis/ui/ui_inventory.png"}}
      :semantics {:role :image}}
     {:type :image :layout {:width 176.0 :height 187.0}
      :style {:resource {:namespace "academy" :path "textures/guis/ui/ui_node.png"}}
      :semantics {:role :image}}
     {:type :repeater :layout {:width 176.0 :height 187.0}
      :bind {:items [:state :slot-anchors]}
      :children [{:type :slot-anchor :bind {:item [:state :item]}}]}]}

   ;; clip? true on main — keeps the y=-20 histogram pull-up inside the panel.
   {:type :clip :key :node/info
    :layout {:x 179.0 :y 5.0 :width 100.0 :height 177.0}
    :children
    [     ;; Main BlendQuad: blend_quad.png 48×48 nine-sliced with margin 4.
     {:type :nine-slice :layout {:width 100.0 :height 177.0}
      :style {:resource {:namespace "academy" :path "textures/guis/blend_quad.png"}
              :slice 4.0 :tex-size 48.0}
      :semantics {:role :image}}

     ;; histogram.png frame @ scale 0.4, pulled up 20px like main.
     {:type :absolute :layout {:x 8.0 :y -20.0 :width 84.0 :height 84.0}
      :children
      [{:type :image :layout {:width 84.0 :height 84.0}
        :style {:resource {:namespace "academy" :path "textures/guis/histogram.png"}}
        :semantics {:role :image}}
       {:type :repeater :layout {:width 84.0 :height 84.0}
        :bind {:items [:state :info-area :hist-bars]}
        :children
        [{:type :composite :layout {:width 0.0 :height 0.0}
          :bind {:item [:state :item]}}]}]}

     ;; histProperty rows — start at cursor y=64 after (84-20) advance.
     {:type :repeater :layout {:x 6.0 :y 64.0 :width 92.0 :height 24.0}
      :bind {:items [:state :info-area :histograms]}
      :semantics {:role :list}
      :children
      [{:type :row :layout {:height 10.0}
        :children
        [{:type :text :layout {:width 30.0 :height 8.0}
          :style {:font-size 8.0 :rgba 0xFFCCCCCC}
          :bind {:text [:item :label]}}
         {:type :rect :layout {:width 6.0 :height 6.0}
          :bind {:rgba [:item :color]}}
         {:type :text :layout {:width 55.0 :height 8.0}
          :style {:font-size 8.0}
          :bind {:text [:item :value]}}]}]}

     {:type :text :layout {:x 3.0 :y 84.0 :width 97.0 :height 8.0}
      :style {:font-size 6.0 :rgba 0x99FFFFFF}
      :bind {:text [:state :info-area :sep-label]}}

     ;; Property rows — main x=6, label 40 / value 40, font 8.
     {:type :column :layout {:x 6.0 :y 95.0 :width 90.0 :height 70.0}
      :children
      [{:type :row :layout {:height 10.0}
        :children
        [{:type :text :layout {:width 40.0 :height 10.0}
          :style {:font-size 8.0 :rgba 0xFFAAAAAA}
          :text "Range"}
         {:type :text :layout {:width 40.0 :height 10.0}
          :style {:font-size 8.0}
          :bind {:text [:state :info-area :fields 0 :value]}}]}
       {:type :row :layout {:height 10.0}
        :children
        [{:type :text :layout {:width 40.0 :height 10.0}
          :style {:font-size 8.0 :rgba 0xFFAAAAAA}
          :text "Owner"}
         {:type :text :layout {:width 40.0 :height 10.0}
          :style {:font-size 8.0}
          :bind {:text [:state :info-area :fields 1 :value]}}]}
       {:type :row :layout {:height 10.0}
        :children
        [{:type :text :layout {:width 40.0 :height 10.0}
          :style {:font-size 8.0 :rgba 0xFFAAAAAA}
          :text "Node Name"}
         {:type :text-input :layout {:width 40.0 :height 10.0}
          :style {:font-size 8.0}
          :bind {:text [:state :node-name] :visible [:state :node-editable?]}
          :on {:change :container/text-change :submit :container/text-submit}
          :semantics {:role :textbox :field :node-name}}
         {:type :text :layout {:width 40.0 :height 10.0}
          :style {:font-size 8.0}
          :bind {:text [:state :node-name] :visible [:state :node-readonly?]}}]}
       {:type :row :layout {:height 10.0}
        :children
        [{:type :text :layout {:width 40.0 :height 10.0}
          :style {:font-size 8.0 :rgba 0xFFAAAAAA}
          :text "Password"}
         {:type :text-input :layout {:width 40.0 :height 10.0}
          :style {:font-size 8.0}
          :bind {:text [:state :network-password] :visible [:state :node-editable?]}
          :on {:change :container/text-change :submit :container/text-submit}
          :semantics {:role :textbox :field :password}}
         {:type :text :layout {:width 40.0 :height 10.0}
          :style {:font-size 8.0}
          :bind {:text [:state :network-password] :visible [:state :node-readonly?]}}]}]}]}]}}

;; Wireless node — TechUI family with ui_node overlay + shared left tabs.
;; Wireless page + info histogram from academy/shared fragments (:include).
{:ui/schema 2 :view/id :academy.app/wireless-node
 :host {:kind :container :design-width 290 :design-height 187 :scale-policy :fit}
 :state-schema {:node-name :string :node-editable? :boolean :node-readonly? :boolean
                :network-password :string :info-area :map :slot-anchors :vector
                :node-anim :vector :tech-tabs :vector
                :inv-page-visible? :boolean :wireless-page-visible? :boolean
                :network-linked-label :string :network-nodes :vector
                :network-disconnect :map :network-available-label :map
                :network-logo-composite :vector :network-connected? :boolean
                :network-disconnected? :boolean
                :wireless-connect-password :string}
 :root
 {:type :absolute :key :node/root :layout {:width 290 :height 187}
  :children
  [;; Shared left tab strip (main tech-ui-tabs: x=-20, y=idx*22, 20×20).
   {:type :repeater :key :node/tech-tabs
    :layout {:x 0.0 :y 0.0 :width 176.0 :height 187.0 :direction :none}
    :bind {:items [:state :tech-tabs]}
    :children
    [{:type :composite :layout {:width 0.0 :height 0.0}
      :bind {:item [:state :item]
             :x [:item :layout-x] :y [:item :layout-y]
             :width [:item :w] :height [:item :h]}
      :on {:activate :container/set-tab}
      :semantics {:role :button}}]}

   ;; Inv page — node art + anim + slots
   {:type :absolute :key :node/left
    :layout {:x 0.0 :y 0.0 :width 176.0 :height 187.0}
    :bind {:visible [:state :inv-page-visible?]}
    :children
    [;; TechUI page-anchor: slots stay on design (0,0)=leftPos; center 176-wide
     ;; art in the historical 172-wide page so (172−176)/2 = −2 matches main's
     ;; texture↔slot inset (not a per-image x hack).
     {:type :row :key :node/page-art
      :layout {:x 0.0 :y 0.0 :width 172.0 :height 187.0 :justify :center}
      :children
      [{:type :absolute :layout {:width 176.0 :height 187.0}
        :children
        [{:type :image :layout {:width 176.0 :height 187.0}
          :style {:resource {:namespace "academy" :path "textures/guis/parent/parent_background.png"}}
          :semantics {:role :image}}
         {:type :image :layout {:width 176.0 :height 187.0}
          :style {:resource {:namespace "academy" :path "textures/guis/ui/ui_inventory.png"}}
          :semantics {:role :image}}
         {:type :image :layout {:width 176.0 :height 187.0}
          :style {:resource {:namespace "academy" :path "textures/guis/ui/ui_node.png"}}
          :semantics {:role :image}}
         {:type :repeater :key :node/anim
          :layout {:width 176.0 :height 187.0}
          :bind {:items [:state :node-anim]}
          :children [{:type :composite :layout {:width 0.0 :height 0.0}
                      :bind {:item [:state :item]}}]}]}]}
     {:type :repeater :layout {:width 176.0 :height 187.0}
      :bind {:items [:state :slot-anchors]}
      :children [{:type :slot-anchor :bind {:item [:state :item]}}]}]}

   {:type :include :src "academy/shared/wireless_page"}

   {:type :include :src "academy/shared/info_area_chrome"}

   {:type :clip :key :node/info
    :layout {:x 179.0 :y 5.0 :width 100.0 :height 177.0}
    :children
    [{:type :include :src "academy/shared/info_area_histogram"}

     {:type :text :layout {:x 3.0 :y 84.0 :width 97.0 :height 8.0}
      :style {:font-size 6.0 :rgba 0x99FFFFFF}
      :bind {:text [:state :info-area :sep-label]}}

     {:type :column :layout {:x 6.0 :y 95.0 :width 90.0 :height 70.0}
      :children
      [{:type :row :layout {:height 10.0 :align :center}
        :children
        [{:type :text :layout {:width 40.0 :height 10.0}
          :style {:font-size 8.0 :rgba 0xFFAAAAAA}
          :text "Range"}
         {:type :text :layout {:width 40.0 :height 10.0}
          :style {:font-size 8.0}
          :bind {:text [:state :info-area :fields 0 :value]}}]}
       {:type :row :layout {:height 10.0 :align :center}
        :children
        [{:type :text :layout {:width 40.0 :height 10.0}
          :style {:font-size 8.0 :rgba 0xFFAAAAAA}
          :text "Owner"}
         {:type :text :layout {:width 40.0 :height 10.0}
          :style {:font-size 8.0}
          :bind {:text [:state :info-area :fields 1 :value]}}]}
       {:type :row :layout {:height 10.0 :align :center}
        :children
        [{:type :text :layout {:width 40.0 :height 10.0}
          :style {:font-size 8.0 :rgba 0xFFAAAAAA}
          :text "Node Name"}
         {:type :absolute :layout {:width 46.0 :height 10.0}
          :children
          [{:type :text :layout {:x -4.0 :y 0.0 :width 10.0 :height 10.0}
            :style {:font-size 8.0}
            :text "["
            :bind {:visible [:state :node-editable?]}}
           {:type :text-input :layout {:x 0.0 :y 0.0 :width 46.0 :height 10.0}
            :style {:font-size 8.0 :rgba 0xFF2180D8}
            :bind {:text [:state :node-name] :visible [:state :node-editable?]}
            :on {:change :container/text-change :submit :container/text-submit}
            :semantics {:role :textbox :field :node-name}}
           {:type :text :layout {:x 42.0 :y 0.0 :width 10.0 :height 10.0}
            :style {:font-size 8.0}
            :text "]"
            :bind {:visible [:state :node-editable?]}}
           {:type :text :layout {:x 0.0 :y 0.0 :width 40.0 :height 10.0}
            :style {:font-size 8.0}
            :bind {:text [:state :node-name] :visible [:state :node-readonly?]}}]}]}
       {:type :row :layout {:height 10.0 :align :center}
        :children
        [{:type :text :layout {:width 40.0 :height 10.0}
          :style {:font-size 8.0 :rgba 0xFFAAAAAA}
          :text "Password"}
         {:type :absolute :layout {:width 46.0 :height 10.0}
          :children
          [{:type :text :layout {:x -4.0 :y 0.0 :width 10.0 :height 10.0}
            :style {:font-size 8.0}
            :text "["
            :bind {:visible [:state :node-editable?]}}
           {:type :text-input :layout {:x 0.0 :y 0.0 :width 46.0 :height 10.0}
            :style {:font-size 8.0 :rgba 0xFF2180D8}
            :bind {:text [:state :network-password] :visible [:state :node-editable?]}
            :on {:change :container/text-change :submit :container/text-submit}
            :semantics {:role :textbox :field :password}}
           {:type :text :layout {:x 42.0 :y 0.0 :width 10.0 :height 10.0}
            :style {:font-size 8.0}
            :text "]"
            :bind {:visible [:state :node-editable?]}}
           {:type :text :layout {:x 0.0 :y 0.0 :width 40.0 :height 10.0}
            :style {:font-size 8.0}
            :bind {:text [:state :network-password] :visible [:state :node-readonly?]}}]}]}]}]}]}}

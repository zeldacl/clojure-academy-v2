{:view/id :academy.app/location-teleport
 :host {:kind :screen :design-width 480 :design-height 360 :scale-policy :fit}
 :state-schema {:title :string :status :string :exp :number :current-label :string
                :locations :vector :visible-locations :vector :input :string
                :selected-label :string :add-label :string :offset :number :max-offset :number}
 :root {:type :column :key :location/root :layout {:x 12 :y 12 :width 456 :height 336}
        :children [{:type :text :key :location/title :bind {:text [:state :title]}
                    :semantics {:role :heading}}
                   {:type :text :key :location/status :bind {:text [:state :status]}}
                   {:type :text :key :location/current :bind {:text [:state :current-label]}}
                   {:type :scroll :key :location/list :layout {:height 240}
                    :bind {:items [:state :visible-locations]}
                    :semantics {:role :list}
                    :children [{:type :row :key :location/row :layout {:height 30}
                                :children [{:type :text :key :location/name
                                            :layout {:width 250 :height 24}
                                            :bind {:text [:item :name]}}
                                           {:type :button :key :location/teleport
                                            :layout {:width 90 :height 24}
                                            :bind {:text [:item :teleport-label]}
                                            :on {:activate :location/teleport}
                                            :semantics {:role :button}}
                                           {:type :button :key :location/delete
                                            :layout {:width 90 :height 24}
                                            :bind {:text [:item :delete-label]}
                                            :on {:activate :location/delete}
                                            :semantics {:role :button}}]}]}
                   {:type :text-input :key :location/input :layout {:height 24}
                    :bind {:text [:state :input]}
                    :on {:submit :location/add}
                    :semantics {:role :textbox :field :location-name}}
                   {:type :button :key :location/add :layout {:height 24}
                    :bind {:text [:state :add-label]}
                    :on {:activate :location/add}
                    :semantics {:role :button}}
                   {:type :text :key :location/selected :bind {:text [:state :selected-label]}}]}}
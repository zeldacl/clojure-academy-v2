;; Combat HUD — full-screen host; CP/slots/overlays are screen-space composites
;; from presentation_hud (not a centered 427×240 design box).
;;
;; Vignette (screen_mask.png + category tint) is emitted from presentation_hud
;; into :composite-list — keep this root free of a solid full-screen :rect
;; (that washed the whole view) and free of a duplicate mask image.
{:ui/schema 2 :view/id :academy.app/combat-hud
 :host {:kind :hud}
 :state-schema {:cp-ratio :number :overload-ratio :number :charging? :boolean
                :selected-skill :keyword :skills :vector :background-mask :map
                :composite-list :vector}
 :root
 {:type :stack :key :combat/root :layout {:width :fill :height :fill}
  :children
  [{:type :repeater :key :combat/composite
    ;; Absolute screen-space items — do not stack in a column.
    :layout {:width :fill :height :fill :direction :none}
    :bind {:items [:state :composite-list]}
    :children
    [{:type :composite :layout {:width 0.0 :height 0.0}
      :bind {:item [:state :item]}}]}]}}

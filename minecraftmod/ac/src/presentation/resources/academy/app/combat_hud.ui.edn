{:view/id :academy.app/combat-hud
 :host {:kind :hud :design-width 320 :design-height 180 :scale-policy :fit}
 :state-schema {:cp-ratio :number :overload-ratio :number :charging? :boolean :selected-skill :keyword :skills :vector}
 :root {:type :stack :key :combat/root :layout {:width :fill :height :fill}
        :children [{:type :rect :key :combat/background :layout {:width :fill :height :fill} :bind {:alpha [:state :background-mask]}}
                   {:type :progress :key :combat/cp :layout {:width 120 :height 8} :bind {:value [:state :cp-ratio]} :semantics {:role :progress}}
                   {:type :progress :key :combat/overload :layout {:width 120 :height 8} :bind {:value [:state :overload-ratio]} :semantics {:role :progress}}
                   {:type :grid :key :combat/skills :layout {:width 160 :height 64} :bind {:items [:state :skills]}}
                   {:type :rect :key :combat/crosshair :layout {:width 12 :height 12} :bind {:alpha [:state :crosshair]}}
                   {:type :repeater :key :combat/toasts :bind {:items [:state :toasts]} :children [{:type :text :bind {:text [:state :item]}}]}]}}
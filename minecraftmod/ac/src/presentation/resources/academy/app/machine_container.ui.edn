{:view/id :academy.app/machine-container
 :host {:kind :container :design-width 176 :design-height 200 :scale-policy :fit}
 :state-schema {:slots :vector :machine-state :string :energy-ratio :number :progress-ratio :number
                :info-area :map :network-visible :boolean :network-state :string
                :network-owner :string :network-range :string :network-bandwidth :string
                :network-load :number :network-nodes :vector :network-password :string :network-disconnect :map :network-available-label :map
                :button-left :map :button-right :map}
 :root {:type :column :key :container/root :layout {:x 8 :y 8 :width 160 :height 184}
        :children [{:type :scroll :key :container/slots :layout {:height 52} :bind {:items [:state :slots]} :semantics {:role :list}}
                   {:type :repeater :key :container/slot-anchors :bind {:items [:state :slot-anchors]} :children [{:type :slot-anchor :bind {:item [:state :item]}}]}
                   {:type :text :key :container/state :bind {:text [:state :machine-state]}}
                   {:type :progress :key :container/energy :layout {:height 6} :bind {:value [:state :energy-ratio]} :semantics {:role :progress}}
                   {:type :progress :key :container/progress :layout {:height 6} :bind {:value [:state :progress-ratio]} :semantics {:role :progress}}
                   {:type :row :key :container/buttons
                    :children [{:type :button :key :container/button-left :layout {:width 72 :height 20} :bind {:text [:state :button-left]} :on {:activate :container/button} :semantics {:role :button}}
                               {:type :button :key :container/button-right :layout {:width 72 :height 20} :bind {:text [:state :button-right]} :on {:activate :container/button} :semantics {:role :button}}]}
                   {:type :column :key :container/network :bind {:visible [:state :network-visible]} :layout {:height 58}
                    :children [{:type :text :key :container/network-state :bind {:text [:state :network-state]}}
                               {:type :text :key :container/network-owner :bind {:text [:state :network-owner]}}
                               {:type :text :key :container/network-range :bind {:text [:state :network-range]}}
                               {:type :text :key :container/network-bandwidth :bind {:text [:state :network-bandwidth]}}
                               {:type :progress :key :container/network-load :layout {:height 5} :bind {:value [:state :network-load]} :semantics {:role :progress}}
                               {:type :text-input :key :container/network-password :layout {:height 18}
                                :bind {:text [:state :network-password]}
                                :on {:change :container/wireless-password :submit :container/wireless-password}
                                :semantics {:role :textbox :field :wireless-password}}
                               {:type :row :key :container/network-actions
                                :children [{:type :button :layout {:width 72 :height 18} :bind {:text [:state :network-disconnect]} :on {:activate :container/wireless-disconnect} :semantics {:role :button}}
                                           {:type :text :layout {:width 72 :height 18} :bind {:text [:state :network-available-label]}}]}
                               {:type :scroll :key :container/network-nodes :layout {:height 42}
                                :bind {:items [:state :network-nodes]} :semantics {:role :list}
                                :children [{:type :row :layout {:height 18}
                                            :children [{:type :text :layout {:width 104} :bind {:text [:item :label]}}
                                                       {:type :button :layout {:width 48 :height 16} :bind {:text [:item :action-label]}
                                                        :on {:activate :container/wireless-connect} :semantics {:role :button}}]}]}]}
                   {:type :column :key :container/info-area :layout {:height 60}
                    :children [{:type :text :key :container/info-title :bind {:text [:state :info-area :title]}}
                               {:type :repeater :key :container/info-histograms :layout {:height 24}
                                :bind {:items [:state :info-area :histograms]} :semantics {:role :list}
                                :children [{:type :row :layout {:height 12}
                                            :children [{:type :text :layout {:width 64 :height 12} :bind {:text [:item :label]}}
                                                       {:type :progress :layout {:width 64 :height 6} :bind {:value [:item :ratio]} :semantics {:role :progress}}
                                                       {:type :text :layout {:width 40 :height 12} :bind {:text [:item :value]}}]}]}
                               {:type :scroll :key :container/info-fields :layout {:height 36}
                                :bind {:items [:state :info-area :fields]} :semantics {:role :list}
                                :children [{:type :row :layout {:height 18}
                                            :children [{:type :text :layout {:width 72 :height 16} :bind {:text [:item :label]}}
                                                       {:type :text :layout {:width 88 :height 16} :bind {:text [:item :value]}}]}]}
                               {:type :progress :key :container/info-load :layout {:height 5}
                                :bind {:value [:state :info-area :load-ratio]} :semantics {:role :progress}}]}]}}
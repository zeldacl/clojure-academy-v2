;; Ability interferer — TechUI + ui_interfere; shared left inv/wireless tabs.
;; Wireless page from academy/shared/wireless_page (:include).
{:ui/schema 2 :view/id :academy.app/ability-interferer
 :host {:kind :container :design-width 290 :design-height 187 :scale-policy :fit}
 :state-schema {:slots :vector :slot-anchors :vector :machine-state :string :energy-ratio :number
                :interferer-range :string :interferer-enabled :string
                :interferer-range-down :map :interferer-range-up :map :interferer-toggle :map
                :interferer-whitelist :vector :interferer-input :string :interferer-selected :string
                :interferer-remove :map :network-visible :boolean :network-state :string
                :network-owner :string :network-range :string :network-bandwidth :string
                :network-load :number :network-nodes :vector :network-password :string
                :network-disconnect :map :network-available-label :map
                :network-linked-label :string :network-logo-composite :vector
                :network-connected? :boolean :network-disconnected? :boolean
                :wireless-connect-password :string
                :tech-tabs :vector
                :inv-page-visible? :boolean :wireless-page-visible? :boolean :info-area :map}
 :root
 {:type :absolute :key :interferer/root :layout {:width 290 :height 187}
  :children
  [{:type :repeater :key :interferer/tech-tabs
    :layout {:x 0.0 :y 0.0 :width 176.0 :height 187.0 :direction :none}
    :bind {:items [:state :tech-tabs]}
    :children
    [{:type :composite :layout {:width 0.0 :height 0.0}
      :bind {:item [:state :item]
             :x [:item :layout-x] :y [:item :layout-y]
             :width [:item :w] :height [:item :h]}
      :on {:activate :container/set-tab}
      :semantics {:role :button}}]}

   {:type :absolute :key :interferer/left :layout {:x 0.0 :y 0.0 :width 176.0 :height 187.0}
    :bind {:visible [:state :inv-page-visible?]}
    :children
    [{:type :image :layout {:width 176.0 :height 187.0}
      :style {:resource {:namespace "academy" :path "textures/guis/parent/parent_background.png"}}
      :semantics {:role :image}}
     {:type :image :layout {:width 176.0 :height 187.0}
      :style {:resource {:namespace "academy" :path "textures/guis/ui/ui_interfere.png"}}
      :semantics {:role :image}}
     {:type :repeater :layout {:width 176.0 :height 187.0}
      :bind {:items [:state :slot-anchors]}
      :children [{:type :slot-anchor :bind {:item [:state :item]}}]}

     {:type :column :key :interferer/config
      :layout {:x 8.0 :y 20.0 :width 160.0 :height 36.0}
      :children
      [{:type :row :layout {:height 16.0}
        :children
        [{:type :text :layout {:width 48.0} :style {:font-size 8.0}
          :bind {:text [:state :interferer-enabled]}}
         {:type :button :layout {:width 16.0 :height 16.0}
          :bind {:text [:state :interferer-toggle]}
          :on {:activate :interferer/toggle} :semantics {:role :button}}]}
       {:type :row :layout {:height 16.0}
        :children
        [{:type :text :layout {:width 40.0} :style {:font-size 8.0}
          :bind {:text [:state :interferer-range]}}
         {:type :button :layout {:width 16.0 :height 16.0}
          :bind {:text [:state :interferer-range-down]}
          :on {:activate :interferer/range-down} :semantics {:role :button}}
         {:type :button :layout {:width 16.0 :height 16.0}
          :bind {:text [:state :interferer-range-up]}
          :on {:activate :interferer/range-up} :semantics {:role :button}}]}]}

     {:type :absolute :key :interferer/whitelist-panel
      :layout {:x 8.0 :y 70.0 :width 160.0 :height 100.0}
      :children
      [{:type :row :layout {:x 0.0 :y 0.0 :width 160.0 :height 14.0}
        :children
        [{:type :button :layout {:width 12.0 :height 12.0}
          :text "+"
          :on {:activate :interferer/add-whitelist} :semantics {:role :button}}
         {:type :button :layout {:width 12.0 :height 12.0}
          :bind {:text [:state :interferer-remove]}
          :on {:activate :interferer/remove-whitelist} :semantics {:role :button}}
         {:type :text :layout {:width 100.0} :style {:font-size 8.0}
          :bind {:text [:state :interferer-selected]}}]}
       {:type :scroll :layout {:x 0.0 :y 16.0 :width 140.0 :height 64.0}
        :bind {:items [:state :interferer-whitelist]}
        :semantics {:role :list}
        :children
        [{:type :row :layout {:height 16.0}
          :children
          [{:type :text :layout {:width 100.0} :style {:font-size 8.0}
            :bind {:text [:item :label]}}
           {:type :button :layout {:width 36.0 :height 14.0}
            :bind {:text [:item :select-label]}
            :on {:activate :interferer/select-whitelist} :semantics {:role :button}}]}]}
       {:type :text-input :layout {:x 0.0 :y 82.0 :width 140.0 :height 14.0}
        :bind {:text [:state :interferer-input]}
        :on {:change :interferer/input-change :submit :interferer/add-whitelist}
        :semantics {:role :textbox :field :interferer-input}}]}]}

   {:type :include :src "academy/shared/wireless_page"}

   {:type :include :src "academy/shared/info_area_chrome"}

   {:type :clip :key :interferer/info
    :layout {:x 179.0 :y 5.0 :width 100.0 :height 177.0}
    :children
    [{:type :include :src "academy/shared/info_area_histogram"}
     {:type :text :layout {:x 4.0 :y 90.0 :width 92.0 :height 10.0}
      :style {:font-size 8.0}
      :bind {:text [:state :machine-state]}}
     {:type :progress :layout {:x 4.0 :y 102.0 :width 92.0 :height 5.0}
      :bind {:value [:state :energy-ratio]} :semantics {:role :progress}}
     {:type :scroll :layout {:x 4.0 :y 112.0 :width 92.0 :height 32.0}
      :bind {:items [:state :info-area :fields]}
      :children
      [{:type :row :layout {:height 12.0}
        :children
        [{:type :text :layout {:width 40.0} :style {:font-size 7.0}
          :bind {:text [:item :label]}}
         {:type :text :layout {:width 52.0} :style {:font-size 7.0}
          :bind {:text [:item :value]}}]}]}
     {:type :column :layout {:x 4.0 :y 148.0 :width 92.0 :height 24.0}
      :bind {:visible [:state :network-visible]}
      :children
      [{:type :text :style {:font-size 7.0} :bind {:text [:state :network-state]}}
       {:type :text-input :layout {:height 10.0}
        :bind {:text [:state :network-password]}
        :on {:change :container/wireless-password :submit :container/wireless-password}
        :semantics {:role :textbox :field :wireless-password}}]}]}]}}

;; Node editor (developer-facing) -- single canvas, no modal viewport.
;; Layout is academy/shared/editor_shell.edn: header (title/phase-tabs/
;; actions) / palette+stage+inspector row / diagnostics (0-height when
;; empty) / footer (cost+zoom+panel toggles / preview+status). Panel widths
;; come from cn.li.ability.editor.chrome/panel-geometry via :shell-* state
;; keys the fragment binds against -- see that namespace for why collapsing
;; a panel means driving its width to 0, not :visible.
{:ui/schema 2 :view/id :academy.app/node-editor
 :host {:kind :screen :design-width 560 :design-height 380 :scale-policy :fit}
 :state-schema {:shell-header-h :number :shell-footer-h :number
                :shell-body-h :number :shell-diagnostics-h :number
                :shell-palette-w :number :shell-stage-w :number :shell-inspector-w :number
                :title :string :path :string :phase-label :string :phase-tabs :vector
                :palette :vector :palette-query :string :palette-rows :vector
                :palette-search-label :string :palette-clear-label :string
                :palette-open? :boolean :inspector-open? :boolean
                :palette-toggle-label :string :inspector-toggle-label :string
                :palette-list-h :number :inspector-list-h :number
                :canvas :vector :selected-label :string
                :selected-signature :string :selected-signature-visible? :boolean
                :selected-params :vector :diagnostics :vector
                :diagnostic-count :number :cost-label :string :zoom-label :string :zoom-reset-label :string
                :status :string :preview-active? :boolean :preview-label :string :preview-toggle-label :string :dirty? :boolean
                :reload-label :string :save-label :string :export-label :string :undo-label :string :redo-label :string}
 :root
 {:type :include :src "academy/shared/editor_shell"
  :slots
  {:header
   {:type :column :key :node-editor/header :layout {:width 560}
    :children
    [{:type :text :key :node-editor/title :layout {:height 16}
      :bind {:text [:state :title]} :semantics {:role :heading}}
     {:type :row :key :node-editor/phase-row :layout {:height 16}
      :children [{:type :text :layout {:width 100} :bind {:text [:state :phase-label]}}
                 {:type :repeater :layout {:width 440}
                  :bind {:items [:state :phase-tabs]}
                  :children [{:type :button :layout {:width 64 :height 14}
                              :bind {:text [:item :action-label]}
                              :on {:activate :editor/select-phase}
                              :semantics {:role :button}}]}]}
     {:type :row :key :node-editor/actions :layout {:height 16}
      :children [{:type :button :layout {:width 70 :height 14}
                  :bind {:text [:state :reload-label]}
                  :on {:activate :editor/reload}
                  :semantics {:role :button}}
                 {:type :button :layout {:width 70 :height 14}
                  :bind {:text [:state :save-label]}
                  :on {:activate :editor/save}
                  :semantics {:role :button}}
                 {:type :button :layout {:width 70 :height 14}
                  :bind {:text [:state :export-label]}
                  :on {:activate :editor/export}
                  :semantics {:role :button}}
                 {:type :button :layout {:width 58 :height 14}
                  :bind {:text [:state :undo-label]}
                  :on {:activate :editor/undo}
                  :semantics {:role :button}}
                 {:type :button :layout {:width 58 :height 14}
                  :bind {:text [:state :redo-label]}
                  :on {:activate :editor/redo}
                  :semantics {:role :button}}]}]}

   :palette
   {:type :column :key :node-editor/palette-panel
    :bind {:width [:state :shell-palette-w] :height [:state :shell-body-h]}
    :children
    [{:type :row :key :node-editor/palette-search :layout {:height 16}
      :children [{:type :text-input :layout {:height 14 :width 96}
                  :bind {:text [:state :palette-query]}
                  :on {:change :editor/palette-search-change :submit :editor/palette-search-submit}
                  :semantics {:role :textbox :field :palette-search}}
                 {:type :button :layout {:height 14 :width 30}
                  :bind {:text [:state :palette-clear-label]}
                  :on {:activate :editor/clear-palette-search}
                  :semantics {:role :button}}]}
     {:type :scroll :key :node-editor/palette
      :bind {:items [:state :palette-rows] :height [:state :palette-list-h]}
      :semantics {:role :list}
      ;; :absolute item template, NOT :row -- LayoutKernel never reads
      ;; :visible during measure/arrange (only Paint/Hit do), so a :row's
      ;; header/entry children would both reserve their full flow width
      ;; even while invisible, pushing the entry button to start AFTER
      ;; the header's width regardless of which one is actually showing.
      ;; Overlapping both at x=0 (same fix as preset_editor's icon/text
      ;; slot layering) keeps the entry button inside the palette column.
      :children [{:type :absolute :layout {:height 14}
                  :children [{:type :text :layout {:x 0 :width 130 :height 14}
                              :bind {:text [:item :header-label] :visible [:item :header?]}
                              :on {:activate :editor/toggle-palette-category}
                              :semantics {:role :button :field :palette-category}}
                             {:type :button :layout {:x 0 :width 94 :height 14}
                              :bind {:text [:item :label] :visible [:item :entry?] :rgba [:item :category-color]}
                              :on {:activate :editor/add-palette-node :drag-start :editor/palette-drag-start}
                              :semantics {:role :button}}
                             {:type :text :layout {:x 94 :width 36 :height 14}
                              :bind {:text [:item :cost-label] :visible [:item :entry?]}
                              :semantics {:role :generic}}]}]}]}

   :stage
   {:type :absolute :key :node-editor/canvas
    :bind {:width [:state :shell-stage-w] :height [:state :shell-body-h]}
    :children
    [{:type :box
      :bind {:width [:state :shell-stage-w] :height [:state :shell-body-h]}
      :on {:drag-start :editor/canvas-press :drop :editor/palette-drop}
      :semantics {:role :generic :drop-zone :node-editor/canvas}}
     {:type :repeater :layout {:direction :none}
      :bind {:width [:state :shell-stage-w] :height [:state :shell-body-h]
             :items [:state :canvas]}
      :children [{:type :absolute
                  :bind {:x [:item :x] :y [:item :y]
                         :width [:item :w] :height [:item :h]}
                  :on {:activate :editor/canvas-press :drag-start :editor/canvas-press :drop :editor/palette-drop}
                  :semantics {:role :button :drop-zone :node-editor/canvas}
                  :children [{:type :composite
                              :bind {:item [:state :item]
                                     :width [:item :w] :height [:item :h]}}]}]}]}

   :inspector
   {:type :column :key :node-editor/inspector-panel
    :bind {:width [:state :shell-inspector-w] :height [:state :shell-body-h]}
    :children
    [{:type :text :key :node-editor/selected :layout {:height 18}
      :bind {:text [:state :selected-label]} :semantics {:role :generic}}
     {:type :text :key :node-editor/selected-signature :layout {:height 14}
      :bind {:text [:state :selected-signature] :visible [:state :selected-signature-visible?]}
      :style {:rgba [0.72 0.78 0.85 1.0]}
      :semantics {:role :generic}}
     {:type :scroll :key :node-editor/params
      :bind {:items [:state :selected-params] :height [:state :inspector-list-h]}
      :semantics {:role :list}
      :children [{:type :row :layout {:height 14}
                  :children [{:type :text :layout {:width 66} :bind {:text [:item :label]}}
                             {:type :text-input :layout {:width 80 :height 14}
                              :bind {:text [:item :value] :visible [:item :text-editor?]}
                              :on {:change :editor/param-change :submit :editor/param-submit}
                              :semantics {:role :textbox :field :editor-param}}
                             {:type :repeater :layout {:width 80 :height 14}
                              :bind {:items [:item :vec3-components] :visible [:item :vec3-editor?]}
                              :children [{:type :row :layout {:height 14}
                                          :children [{:type :text :layout {:width 12 :height 14}
                                                      :bind {:text [:item :axis-label]}}
                                                     {:type :text-input :layout {:width 64 :height 14}
                                                      :bind {:text [:item :value]}
                                                      :on {:change :editor/param-axis-change :submit :editor/param-axis-submit}
                                                      :semantics {:role :textbox :field :editor-param-axis}}]}]}
                             {:type :button :layout {:width 60 :height 14}
                              :bind {:text [:item :choice-next-label] :visible [:item :choice?]}
                              :on {:activate :editor/param-cycle}
                              :semantics {:role :button :field :editor-param-choice}}
                             {:type :button :layout {:width 22 :height 14}
                              :bind {:text [:item :decrement-label] :visible [:item :stepper?]}
                              :on {:activate :editor/param-decrement}
                              :semantics {:role :button :field :editor-param-decrement}}
                             {:type :button :layout {:width 22 :height 14}
                              :bind {:text [:item :increment-label] :visible [:item :stepper?]}
                              :on {:activate :editor/param-increment}
                              :semantics {:role :button :field :editor-param-increment}}
                             {:type :button :layout {:width 56 :height 14}
                              :bind {:text [:item :control-label] :visible [:item :toggle?]}
                              :on {:activate :editor/param-toggle}
                              :semantics {:role :button :field :editor-param-toggle}}]}]}]}

   :diagnostics
   {:type :scroll :key :node-editor/diagnostics :layout {:width 560}
    :bind {:items [:state :diagnostics] :height [:state :shell-diagnostics-h]}
    :semantics {:role :list}
    :children [{:type :row :layout {:height 14}
                :on {:activate :editor/focus-diagnostic}
                :semantics {:role :button :field :editor-diagnostic}
                :children [{:type :text :layout {:width 100} :bind {:text [:item :code-tag]}}
                           {:type :text :layout {:width 440} :bind {:text [:item :message]}}]}]}

   :footer
   {:type :column :key :node-editor/footer :layout {:width 560}
    :children
    [{:type :row :key :node-editor/cost :layout {:height 16}
      :children [{:type :text :layout {:width 160} :bind {:text [:state :cost-label]}}
                 {:type :text :layout {:width 70} :bind {:text [:state :zoom-label]}}
                 {:type :button :layout {:width 60 :height 14}
                  :bind {:text [:state :zoom-reset-label]}
                  :on {:activate :editor/reset-zoom}
                  :semantics {:role :button}}
                 {:type :button :layout {:width 90 :height 14}
                  :bind {:text [:state :palette-toggle-label]}
                  :on {:activate :editor/toggle-palette-panel}
                  :semantics {:role :button :field :palette-panel-toggle}}
                 {:type :button :layout {:width 90 :height 14}
                  :bind {:text [:state :inspector-toggle-label]}
                  :on {:activate :editor/toggle-inspector-panel}
                  :semantics {:role :button :field :inspector-panel-toggle}}]}
     {:type :row :key :node-editor/status-row :layout {:height 16}
      :children [{:type :button :layout {:width 120 :height 14}
                  :bind {:text [:state :preview-toggle-label]}
                  :on {:activate :editor/toggle-preview}
                  :semantics {:role :button}}
                 {:type :text :layout {:width 420} :bind {:text [:state :status]}
                  :semantics {:role :generic}}]}]}}}}

{:ui/schema 2 :view/id :academy.app/node-editor
 :host {:kind :screen :design-width 480 :design-height 360 :scale-policy :fit}
 :state-schema {:title :string :path :string :phase-label :string :phase-tabs :vector
                :palette :vector :palette-query :string :palette-rows :vector
                :palette-search-label :string :palette-clear-label :string
                :canvas :vector :selected-label :string :selected-params :vector :diagnostics :vector
                :diagnostic-count :number :cost-label :string :zoom-label :string :zoom-reset-label :string
                :canvas-viewport? :boolean :canvas-compact-visible? :boolean :canvas-viewport-visible? :boolean
                :canvas-viewport-label :string :canvas-viewport-title :string
                :status :string :preview-active? :boolean :preview-label :string :preview-toggle-label :string :dirty? :boolean
                :reload-label :string :save-label :string :export-label :string :undo-label :string :redo-label :string}
 :root {:type :column :key :node-editor/root :layout {:x 8 :y 8 :width 464 :height 344}
        :children
        [{:type :text :key :node-editor/title :layout {:height 16}
          :bind {:text [:state :title]} :semantics {:role :heading}}
         {:type :row :key :node-editor/phase-row :layout {:height 16}
          :children [{:type :text :layout {:width 100} :bind {:text [:state :phase-label]}}
                     {:type :repeater :layout {:width 340}
                      :bind {:items [:state :phase-tabs]}
                      :children [{:type :button :layout {:width 64 :height 14}
                                  :bind {:text [:item :action-label]}
                                  :on {:activate :editor/select-phase}
                                  :semantics {:role :button}}]}]}
         {:type :row :key :node-editor/palette-search :layout {:height 16}
          :children [{:type :text-input :layout {:height 14 :width 380}
                      :bind {:text [:state :palette-query]}
                      :on {:change :editor/palette-search-change :submit :editor/palette-search-submit}
                      :semantics {:role :textbox :field :palette-search}}
                     {:type :button :layout {:height 14 :width 70}
                      :bind {:text [:state :palette-clear-label]}
                      :on {:activate :editor/clear-palette-search}
                      :semantics {:role :button}}]}
         {:type :scroll :key :node-editor/palette :layout {:height 40}
          :bind {:items [:state :palette-rows]} :semantics {:role :list}
          :children [{:type :row :layout {:height 14}
                      :children [{:type :text :layout {:height 14 :width 440}
                                  :bind {:text [:item :header-label] :visible [:item :header?]}
                                  :on {:activate :editor/toggle-palette-category}
                                  :semantics {:role :button :field :palette-category}}
                                 {:type :button :layout {:height 14 :width 440}
                                  :bind {:text [:item :label] :visible [:item :entry?]}
                                  :on {:activate :editor/add-palette-node :drag-start :editor/palette-drag-start}
                                  :semantics {:role :button}}]}]}
         {:type :absolute :key :node-editor/canvas :layout {:height 128}
          :bind {:visible [:state :canvas-compact-visible?]}
          :children
          [{:type :box :layout {:width 464 :height 128}
            :on {:drag-start :editor/canvas-press :drop :editor/palette-drop}
            :semantics {:role :generic :drop-zone :node-editor/canvas}}
           {:type :repeater :layout {:width 464 :height 128}
            :bind {:items [:state :canvas]}
            :children [{:type :composite :bind {:item [:state :item]}
                        :on {:activate :editor/canvas-press :drag-start :editor/canvas-press :drop :editor/palette-drop}
                        :semantics {:role :button :drop-zone :node-editor/canvas}}]}]}
         {:type :absolute :key :node-editor/canvas-viewport :layout {:x 0 :y 24 :width 464 :height 300}
          :bind {:visible [:state :canvas-viewport-visible?]}
          :children
          [{:type :box :layout {:width 464 :height 300}
            :style {:rgba [0.05 0.06 0.09 0.97]}
            :semantics {:role :dialog :field :canvas-viewport}}
           {:type :row :layout {:x 8 :y 4 :width 448 :height 16}
            :children [{:type :text :layout {:width 360 :height 14}
                        :bind {:text [:state :canvas-viewport-title]}}
                       {:type :button :layout {:width 80 :height 14}
                        :bind {:text [:state :canvas-viewport-label]}
                        :on {:activate :editor/toggle-canvas-viewport}
                        :semantics {:role :button :field :canvas-viewport-toggle}}]}
           {:type :absolute :layout {:x 0 :y 22 :width 464 :height 278}
            :children
            [{:type :box :layout {:width 464 :height 278}
              :on {:drag-start :editor/canvas-press :drop :editor/palette-drop}
              :semantics {:role :generic :drop-zone :node-editor/canvas}}
             {:type :repeater :layout {:width 464 :height 278}
              :bind {:items [:state :canvas]}
              :children [{:type :composite :bind {:item [:state :item]}
                          :on {:activate :editor/canvas-press :drag-start :editor/canvas-press :drop :editor/palette-drop}
                          :semantics {:role :button :drop-zone :node-editor/canvas}}]}]}]}
         {:type :text :key :node-editor/selected :layout {:height 18}
          :bind {:text [:state :selected-label]} :semantics {:role :generic}}
         {:type :scroll :key :node-editor/params :layout {:height 28}
          :bind {:items [:state :selected-params]} :semantics {:role :list}
          :children [{:type :row :layout {:height 14}
                      :children [{:type :text :layout {:width 150} :bind {:text [:item :label]}}
                                 {:type :text-input :layout {:width 98 :height 14}
                                  :bind {:text [:item :value] :visible [:item :text-editor?]}
                                  :on {:change :editor/param-change :submit :editor/param-submit}
                                  :semantics {:role :textbox :field :editor-param}}
                                 {:type :repeater :layout {:width 98 :height 14}
                                  :bind {:items [:item :vec3-components] :visible [:item :vec3-editor?]}
                                  :children [{:type :row :layout {:height 14}
                                              :children [{:type :text :layout {:width 14 :height 14}
                                                          :bind {:text [:item :axis-label]}}
                                                         {:type :text-input :layout {:width 80 :height 14}
                                                          :bind {:text [:item :value]}
                                                          :on {:change :editor/param-axis-change :submit :editor/param-axis-submit}
                                                          :semantics {:role :textbox :field :editor-param-axis}}]}]}
                                 {:type :button :layout {:width 64 :height 14}
                                  :bind {:text [:item :choice-next-label] :visible [:item :choice?]}
                                  :on {:activate :editor/param-cycle}
                                  :semantics {:role :button :field :editor-param-choice}}
                                 {:type :button :layout {:width 22 :height 14}
                                  :bind {:text [:item :decrement-label] :visible [:item :stepper?]}
                                  :on {:activate :editor/param-decrement}
                                  :semantics {:role :button :field :editor-param-decrement}}
                                 {:type :button :layout {:width 22 :height 14}
                                  :bind {:text [:item :increment-label] :visible [:item :stepper?]}
                                  :on {:activate :editor/param-increment}
                                  :semantics {:role :button :field :editor-param-increment}}
                                 {:type :button :layout {:width 60 :height 14}
                                  :bind {:text [:item :control-label] :visible [:item :toggle?]}
                                  :on {:activate :editor/param-toggle}
                                  :semantics {:role :button :field :editor-param-toggle}}]}]}
         {:type :scroll :key :node-editor/diagnostics :layout {:height 36}
          :bind {:items [:state :diagnostics]} :semantics {:role :list}
          :children [{:type :row :layout {:height 14}
                      :children [{:type :text :layout {:width 90} :bind {:text [:item :code]}}
                                 {:type :text :layout {:width 300} :bind {:text [:item :message]}}]}]}
         {:type :row :key :node-editor/cost :layout {:height 14}
          :children [{:type :text :layout {:width 220} :bind {:text [:state :cost-label]}}
                     {:type :text :layout {:width 80} :bind {:text [:state :zoom-label]}}
                     {:type :button :layout {:width 80 :height 14}
                      :bind {:text [:state :zoom-reset-label]}
                      :on {:activate :editor/reset-zoom}
                      :semantics {:role :button}}
                     {:type :button :layout {:width 80 :height 14}
                      :bind {:text [:state :canvas-viewport-label]}
                      :on {:activate :editor/toggle-canvas-viewport}
                      :semantics {:role :button :field :canvas-viewport-toggle}}]}
         {:type :row :key :node-editor/preview :layout {:height 16}
          :children [{:type :text :layout {:width 300} :bind {:text [:state :preview-label]}}
                     {:type :button :layout {:width 120 :height 14}
                      :bind {:text [:state :preview-toggle-label]}
                      :on {:activate :editor/toggle-preview}
                      :semantics {:role :button}}]}
         {:type :row :key :node-editor/actions :layout {:height 16}
          :children [{:type :button :layout {:width 78 :height 14}
                      :bind {:text [:state :reload-label]}
                      :on {:activate :editor/reload}
                      :semantics {:role :button}}
                     {:type :button :layout {:width 78 :height 14}
                      :bind {:text [:state :save-label]}
                      :on {:activate :editor/save}
                      :semantics {:role :button}}
                     {:type :button :layout {:width 78 :height 14}
                      :bind {:text [:state :export-label]}
                      :on {:activate :editor/export}
                      :semantics {:role :button}}
                     {:type :button :layout {:width 64 :height 14}
                      :bind {:text [:state :undo-label]}
                      :on {:activate :editor/undo}
                      :semantics {:role :button}}
                     {:type :button :layout {:width 64 :height 14}
                      :bind {:text [:state :redo-label]}
                      :on {:activate :editor/redo}
                      :semantics {:role :button}}]}
         {:type :text :key :node-editor/status :layout {:height 14}
          :bind {:text [:state :status]} :semantics {:role :generic}}]}}
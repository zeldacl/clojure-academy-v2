{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name} (Fabric)",
  "description": "A multi-loader Minecraft mod written in Clojure",
  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "https://example.com/",
    "sources": "https://github.com/example/${mod_id}"
  },
  "license": "MIT",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "cn.li.fabric1211.MyModFabric"
    ],
    "client": [
      "cn.li.fabric1211.MyModFabricClient"
    ],
    "fabric-datagen": [
      "cn.li.fabric1211.datagen.DataGeneratorSetup"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "=1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "team_reborn_energy": "*",
    "jei": "*"
  }
}

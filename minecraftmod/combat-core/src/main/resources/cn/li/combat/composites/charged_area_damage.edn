{:schema-version 1
 :kind :composite
 :id :combat/charged-area-damage
 :layer :composite
 :revision 2
 :doc "Compute a charge ratio, query the area once, then apply the per-target damage and impact flow."
 :inputs {:current-ticks {:type :int}
          :minimum-ticks {:type :int}
          :maximum-ticks {:type :int}
          :ratio-slot {:type :resource-id}
          :ratio-min {:type :float}
          :ratio-max {:type :float}
          :center {:type :vec3}
          :radius {:type :float}
          :filter {:type :entity-filter, :default nil}
          :projection {:type :any, :default [:id :type :position]}
          :limit {:type :int, :default 128}
          :damage {:type :any}
          :damage-type {:type :resource-id}
          :on-impact {:type :node}}
 :outputs {}
 :body {:component :flow/sequence
        :steps [{:component :data/bind
                 :to {:ref [:input :ratio-slot]}
                 :value {:expr :math/clamp
                         :args [{:expr :math/div
                                 :args [{:expr :math/sub
                                         :args [{:ref [:input :current-ticks]}
                                                {:ref [:input :minimum-ticks]}]}
                                        {:expr :math/sub
                                         :args [{:ref [:input :maximum-ticks]}
                                                {:ref [:input :minimum-ticks]}]}]}
                                {:ref [:input :ratio-min]}
                                {:ref [:input :ratio-max]}]}}
                {:component :target/entities
                 :shape {:type :sphere
                         :center {:ref [:input :center]}
                         :radius {:ref [:input :radius]}}
                 :filter {:ref [:input :filter]}
                 :projection {:ref [:input :projection]}
                 :limit {:ref [:input :limit]}
                 :bind {:entities :area-targets}}
                {:component :flow/foreach
                 :items {:ref [:local :area-targets]}
                 :as :area-target
                 :limit {:ref [:input :limit]}
                 :body {:component :flow/sequence
                        :steps [{:component :combat/damage
                                 :target {:ref [:local :area-target :id]}
                                 :amount {:ref [:input :damage]}
                                 :damage-type {:ref [:input :damage-type]}}
                                {:ref [:input :on-impact]}]}}]}}
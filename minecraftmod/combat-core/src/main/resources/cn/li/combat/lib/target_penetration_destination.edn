;; Cap the ray distance by a resource budget, then march THROUGH the wall.
;;
;; The scan parameters used to ride along as an inline {:type :penetration
;; ...} map in :target/raycast's :policy, on the assumption that the host
;; would route on that :type. It never did -- see platform/raycast!'s own
;; comment -- so this returned a plain raycast result with no :available?,
;; and penetrate-teleport, which gates on that key, could never fire.
;; :target/penetration is now its own node with its own handler.
{:defn :target/penetration-destination
 :params [{:name origin :type :vec3} {:name direction :type :vec3} {:name distance :type :double}
          {:name scan-step :type :double} {:name clearance-steps :type :long}
          {:name available-resource :type :double} {:name resource-per-distance :type :double}
          {:name marker-offset-y :type :double}]
 :do [(let safe-resource-per-distance (math/max resource-per-distance 1.0E-6))
      (let resource-limited (math/div available-resource safe-resource-per-distance))
      (let effective-distance (math/min distance resource-limited))
      (let destination (target/penetration {:origin origin :direction direction
                                            :distance effective-distance
                                            :scan-step scan-step
                                            :clearance-steps clearance-steps
                                            :marker-offset-y marker-offset-y}))]
 :returns destination}
